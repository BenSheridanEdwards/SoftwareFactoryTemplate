+import { TRPCError } from '@trpc/server';
+import { createCallerFactory } from '../../trpc.ts';
+import { todosRouter } from './procedures.ts';
+
+const caller = createCallerFactory(todosRouter)({});
+
+it('trims the title, creates the todo and lists it', async () => {
+  const todo = await caller.create({ title: '  Buy milk ' });
+
+  expect(todo).toEqual({ id: expect.any(String), title: 'Buy milk', completed: false });
+  await expect(caller.list()).resolves.toContainEqual(todo);
+});
+
+it.each(['', '   '])('rejects the blank title %j as a bad request', async (title) => {
+  await expect(caller.create({ title })).rejects.toMatchObject({
+    constructor: TRPCError,
+    code: 'BAD_REQUEST',
+  });
+});
+
+it('toggles a todo completed and back', async () => {
+  const todo = await caller.create({ title: 'Walk the dog' });
+
+  await expect(caller.toggle({ id: todo.id })).resolves.toEqual({ ...todo, completed: true });
+  await expect(caller.toggle({ id: todo.id })).resolves.toEqual(todo);
+});
+
+it('deletes a todo and answers with its id', async () => {
+  const { id } = await caller.create({ title: 'Water the plants' });
+
+  await expect(caller.delete({ id })).resolves.toEqual({ id });
+  await expect(caller.list()).resolves.not.toContainEqual(expect.objectContaining({ id }));
+});
+
+it('answers a toggle or a delete of an unknown id as not found', async () => {
+  const notFound = { constructor: TRPCError, code: 'NOT_FOUND' };
+
+  await expect(caller.toggle({ id: 'unknown' })).rejects.toMatchObject(notFound);
+  await expect(caller.delete({ id: 'unknown' })).rejects.toMatchObject(notFound);
+});
diff --git a/showcase/todo-plain-01/api/src/features/todos/procedures.ts b/showcase/todo-plain-01/api/src/features/todos/procedures.ts
new file mode 100644
index 0000000..87a371f
--- /dev/null
+++ b/showcase/todo-plain-01/api/src/features/todos/procedures.ts
@@ -0,0 +1,39 @@
+import { TRPCError } from '@trpc/server';
+import { Schema } from 'effect';
+import { procedure, router } from '../../trpc.ts';
+import { createTodo, deleteTodo, listTodos, toggleTodo } from './application.ts';
+
+const todoSchema = Schema.Struct({
+  id: Schema.String,
+  title: Schema.String,
+  completed: Schema.Boolean,
+});
+const todoIdSchema = Schema.Struct({ id: Schema.String });
+const createInputSchema = Schema.Struct({ title: Schema.Trim.check(Schema.isNonEmpty()) });
+
+/** Application answers `undefined` when no todo has the id. */
+function found<Value>(value: Value | undefined): Value {
+  if (value === undefined) {
+    throw new TRPCError({ code: 'NOT_FOUND', message: 'Todo not found' });
+  }
+  return value;
+}
+
+export const todosRouter = router({
+  list: procedure
+    .input(Schema.toStandardSchemaV1(Schema.Undefined))
+    .output(Schema.toStandardSchemaV1(Schema.Array(todoSchema)))
+    .query(() => listTodos()),
+  create: procedure
+    .input(Schema.toStandardSchemaV1(createInputSchema))
+    .output(Schema.toStandardSchemaV1(todoSchema))
+    .mutation(({ input }) => createTodo(input)),
+  toggle: procedure
+    .input(Schema.toStandardSchemaV1(todoIdSchema))
+    .output(Schema.toStandardSchemaV1(todoSchema))
+    .mutation(({ input }) => found(toggleTodo(input))),
+  delete: procedure
+    .input(Schema.toStandardSchemaV1(todoIdSchema))
+    .output(Schema.toStandardSchemaV1(todoIdSchema))
+    .mutation(({ input }) => found(deleteTodo(input))),
+});
