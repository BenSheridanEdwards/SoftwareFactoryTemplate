diff --git a/showcase/todo-plain-01/api/src/features/todos/integrations.ts b/showcase/todo-plain-01/api/src/features/todos/integrations.ts
new file mode 100644
index 0000000..954cd0c
--- /dev/null
+++ b/showcase/todo-plain-01/api/src/features/todos/integrations.ts
@@ -0,0 +1,21 @@
+import { randomUUID } from 'node:crypto';
+import type { Todo } from './domain.ts';
+
+interface TodosState {
+  todos: readonly Todo[];
+}
+
+/** The todos live in memory, inside the api process, for as long as it runs. */
+export function createInMemoryTodos() {
+  const state: TodosState = { todos: [] };
+  return {
+    read: (): readonly Todo[] => state.todos,
+    write: (todos: readonly Todo[]): void => {
+      state.todos = todos;
+    },
+  };
+}
+
+export function createTodoId(): Todo['id'] {
+  return randomUUID();
+}
