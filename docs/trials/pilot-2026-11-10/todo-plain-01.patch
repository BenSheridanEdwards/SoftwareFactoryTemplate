+import { Button, TextField } from '@repo/ui';
+import { useTodoForm } from './useTodoForm';
+import type { CreateTodo } from './useTodos';
+
+export interface TodoFormProps {
+  readonly onCreate: (input: CreateTodo) => void;
+  readonly pending: boolean;
+}
+
+export function TodoForm({ onCreate, pending }: TodoFormProps) {
+  const { register, handleSubmit, formState, reset } = useTodoForm();
+  const handleCreate = handleSubmit((input) => {
+    onCreate(input);
+    reset();
+  });
+
+  return (
+    <form className="flex flex-col gap-3" onSubmit={handleCreate} noValidate>
+      <TextField
+        label="Title"
+        autoComplete="off"
+        error={formState.errors.title?.message}
+        {...register('title')}
+      />
+      <Button
+        type="submit"
+        className="disabled:cursor-not-allowed disabled:opacity-50"
+        disabled={pending}
+      >
+        Add
+      </Button>
+    </form>
+  );
+}
