+import { newTodo, toggleCompleted, withoutTodo } from './domain.ts';
+
+const milk = newTodo('1', 'Buy milk');
+const dog = newTodo('2', 'Walk the dog');
+
+it('starts a todo not completed', () => {
+  expect(milk).toEqual({ id: '1', title: 'Buy milk', completed: false });
+});
+
+it('toggles only the todo with the id, and back again', () => {
+  const toggled = toggleCompleted([milk, dog], '2');
+
+  expect(toggled).toEqual([milk, { ...dog, completed: true }]);
+  expect(toggleCompleted(toggled, '2')).toEqual([milk, dog]);
+});
+
+it('removes only the todo with the id', () => {
+  expect(withoutTodo([milk, dog], '1')).toEqual([dog]);
+});
+
+it('leaves the input array unchanged', () => {
+  const todos = Object.freeze([milk, dog]);
+
+  toggleCompleted(todos, '1');
+  withoutTodo(todos, '1');
+
+  expect(todos).toEqual([milk, dog]);
+});
diff --git a/showcase/todo-plain-01/api/src/features/todos/domain.ts b/showcase/todo-plain-01/api/src/features/todos/domain.ts
