diff --git a/showcase/todo-plain-01/api/src/features/todos/application.test.ts b/showcase/todo-plain-01/api/src/features/todos/application.test.ts
new file mode 100644
index 0000000..5259b3d
--- /dev/null
+++ b/showcase/todo-plain-01/api/src/features/todos/application.test.ts
@@ -0,0 +1,36 @@
+import { createTodo, deleteTodo, listTodos, toggleTodo } from './application.ts';
+
+it('creates a todo that is not completed and lists it after the earlier ones', () => {
+  const first = createTodo({ title: 'Buy milk' });
+  const second = createTodo({ title: 'Buy milk' });
+
+  expect(first).toEqual({ id: expect.any(String), title: 'Buy milk', completed: false });
+  expect(second.id).not.toBe(first.id);
+  expect(listTodos().slice(-2)).toEqual([first, second]);
+});
+
+it('toggles a todo completed and back, and lists each state', () => {
+  const todo = createTodo({ title: 'Walk the dog' });
+
+  expect(toggleTodo({ id: todo.id })).toEqual({ ...todo, completed: true });
+  expect(listTodos()).toContainEqual({ ...todo, completed: true });
+  expect(toggleTodo({ id: todo.id })).toEqual(todo);
+  expect(listTodos()).toContainEqual(todo);
+});
+
+it('deletes a todo, so it is no longer listed', () => {
+  const kept = createTodo({ title: 'Read a book' });
+  const { id } = createTodo({ title: 'Water the plants' });
+
+  expect(deleteTodo({ id })).toEqual({ id });
+  expect(listTodos()).toContainEqual(kept);
+  expect(listTodos()).not.toContainEqual(expect.objectContaining({ id }));
+});
+
+it('finds no todo to toggle or delete for an unknown id', () => {
+  const todos = listTodos();
+
+  expect(toggleTodo({ id: 'unknown' })).toBeUndefined();
+  expect(deleteTodo({ id: 'unknown' })).toBeUndefined();
+  expect(listTodos()).toEqual(todos);
+});
diff --git a/showcase/todo-plain-01/api/src/features/todos/application.ts b/showcase/todo-plain-01/api/src/features/todos/application.ts
new file mode 100644
index 0000000..05f84ac
--- /dev/null
+++ b/showcase/todo-plain-01/api/src/features/todos/application.ts
@@ -0,0 +1,39 @@
+import { newTodo, type Todo, toggleCompleted, withoutTodo } from './domain.ts';
+import { createInMemoryTodos, createTodoId } from './integrations.ts';
+
+export interface CreateTodoRequest {
+  readonly title: Todo['title'];
+}
+
+export interface TodoIdRequest {
+  readonly id: Todo['id'];
+}
+
+const store = createInMemoryTodos();
+
+const findTodo = (id: Todo['id']) => store.read().find((todo) => todo.id === id);
+
+export function listTodos(): readonly Todo[] {
+  return store.read();
+}
+
+export function createTodo(request: CreateTodoRequest): Todo {
+  const todo = newTodo(createTodoId(), request.title);
+  store.write([...store.read(), todo]);
+  return todo;
+}
+
+/** The toggled todo, or `undefined` when no todo has the id. */
+export function toggleTodo(request: TodoIdRequest): Todo | undefined {
+  store.write(toggleCompleted(store.read(), request.id));
+  return findTodo(request.id);
+}
+
+/** The deleted id, or `undefined` when no todo has the id. */
+export function deleteTodo(request: TodoIdRequest): TodoIdRequest | undefined {
+  if (!findTodo(request.id)) {
+    return undefined;
+  }
+  store.write(withoutTodo(store.read(), request.id));
+  return { id: request.id };
+}
diff --git a/showcase/todo-plain-01/api/src/features/todos/domain.test.ts b/showcase/todo-plain-01/api/src/features/todos/domain.test.ts
