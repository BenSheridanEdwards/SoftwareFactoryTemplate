+import { render, screen, waitFor, within } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { axe } from 'jest-axe';
+import { type TestApiHandlers, TestApiProvider } from '../../api-client';
+import { TodosPage } from './TodosPage';
+import type { CreateTodo, Todo } from './useTodos';
+
+const milk: Todo = { id: '1', title: 'Buy milk', completed: false };
+const dog: Todo = { id: '2', title: 'Walk the dog', completed: false };
+
+/** Answers the first list request with `first` and every later one with `refreshed`. */
+const listing = (first: readonly Todo[], refreshed: readonly Todo[]) =>
+  jest.fn<readonly Todo[], []>().mockReturnValueOnce(first).mockReturnValue(refreshed);
+
+function renderPage(handlers: TestApiHandlers) {
+  const view = render(
+    <TestApiProvider handlers={handlers}>
+      <TodosPage />
+    </TestApiProvider>,
+  );
+  return { ...view, user: userEvent.setup() };
+}
+
+async function submitTitle(user: ReturnType<typeof userEvent.setup>, title: string) {
+  if (title) {
+    await user.type(screen.getByRole('textbox', { name: 'Title' }), title);
+  }
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+}
+
+it('keeps loading until the api answers, then says there are no todos yet', async () => {
+  renderPage({ 'todos.list': () => [] });
+
+  expect(screen.getByRole('heading', { level: 1, name: 'Todos' })).toBeInTheDocument();
+  expect(screen.getByRole('status')).toHaveTextContent('Loading…');
+  expect(await screen.findByText('No todos yet')).toBeInTheDocument();
+  expect(screen.queryByRole('status')).not.toBeInTheDocument();
+});
+
+it('creates a todo with the trimmed title, lists it unchecked and clears the field', async () => {
+  const create = jest.fn((_input: CreateTodo) => milk);
+  const { user } = renderPage({ 'todos.list': listing([], [milk]), 'todos.create': create });
+  await screen.findByText('No todos yet');
+
+  await submitTitle(user, '  Buy milk ');
+
+  const list = await screen.findByRole('list', { name: 'Todos' });
+  expect(within(list).getByRole('checkbox', { name: 'Buy milk' })).not.toBeChecked();
+  expect(create).toHaveBeenCalledWith({ title: 'Buy milk' });
+  expect(screen.getByRole('textbox', { name: 'Title' })).toHaveValue('');
+});
+
+it.each(['', '   '])('asks for a title and sends nothing when the title is %j', async (title) => {
+  const create = jest.fn(() => milk);
+  const { user } = renderPage({ 'todos.list': () => [], 'todos.create': create });
+
+  await submitTitle(user, title);
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Enter a title');
+  expect(screen.getByRole('textbox', { name: 'Title' })).toBeInvalid();
+  expect(create).not.toHaveBeenCalled();
+});
+
+it('disables Add while a create is pending', async () => {
+  const { user } = renderPage({
+    'todos.list': () => [],
+    'todos.create': () => new Promise<Todo>(() => undefined),
+  });
+
+  await submitTitle(user, 'Buy milk');
+
+  await waitFor(() => expect(screen.getByRole('button', { name: 'Add' })).toBeDisabled());
+});
+
+it('toggles a todo through the api and shows the saved state', async () => {
+  const completed = { ...milk, completed: true };
+  const toggle = jest.fn(() => completed);
+  const { user } = renderPage({
+    'todos.list': listing([milk], [completed]),
+    'todos.toggle': toggle,
+  });
+
+  await user.click(await screen.findByRole('checkbox', { name: 'Buy milk', checked: false }));
+
+  expect(await screen.findByRole('checkbox', { name: 'Buy milk', checked: true })).toBeVisible();
+  expect(toggle).toHaveBeenCalledWith({ id: milk.id });
+});
+
+it('deletes a todo through the api and keeps the others', async () => {
+  const remove = jest.fn(() => ({ id: dog.id }));
+  const { user } = renderPage({
+    'todos.list': listing([milk, dog], [milk]),
+    'todos.delete': remove,
+  });
+
+  await user.click(await screen.findByRole('button', { name: 'Delete Walk the dog' }));
+
+  await waitFor(() =>
+    expect(screen.queryByRole('checkbox', { name: 'Walk the dog' })).not.toBeInTheDocument(),
+  );
+  expect(screen.getByRole('checkbox', { name: 'Buy milk' })).toBeVisible();
+  expect(remove).toHaveBeenCalledWith({ id: dog.id });
+});
+
+it('says so when the todos cannot load', async () => {
+  renderPage({ 'todos.list': () => Promise.reject(new Error('api down')) });
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Could not load the todos');
+});
+
+it('says so when a change cannot be saved, and keeps the todos', async () => {
+  const { user } = renderPage({
+    'todos.list': () => [milk],
+    'todos.toggle': () => Promise.reject(new Error('api down')),
+  });
+
+  await user.click(await screen.findByRole('checkbox', { name: 'Buy milk' }));
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Could not save the change');
+  expect(screen.getByRole('checkbox', { name: 'Buy milk' })).not.toBeChecked();
+});
+
+it('has no axe-detectable violations with todos listed', async () => {
+  const { container } = renderPage({ 'todos.list': () => [milk, { ...dog, completed: true }] });
+  await screen.findByRole('list', { name: 'Todos' });
+
+  expect(await axe(container)).toHaveNoViolations();
+});
