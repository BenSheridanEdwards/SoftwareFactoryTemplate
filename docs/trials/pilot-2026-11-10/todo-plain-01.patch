@@ -0,0 +1,43 @@
+import { test as base, type ConsoleMessage, expect } from '@playwright/test';
+
+export { expect, type Locator, type Page } from '@playwright/test';
+
+interface ConsoleFixtures {
+  expectedConsole: RegExp[];
+  expectConsole: (pattern: RegExp) => void;
+}
+
+/** Fails a test whose page logs a warning or an error the test did not expect. */
+export const test = base.extend<ConsoleFixtures>({
+  expectedConsole: [[], { option: true }],
+  expectConsole: [
+    async ({ page, expectedConsole }, use) => {
+      const messages: string[] = [];
+      const expected = [...expectedConsole];
+      const recordConsole = (message: ConsoleMessage) => {
+        if (message.type() === 'warning' || message.type() === 'error') {
+          messages.push(`console.${message.type()}: ${message.text()}`);
+        }
+      };
+      const recordError = (error: Error) => {
+        messages.push(`pageerror: ${error.message}`);
+      };
+      page.on('console', recordConsole);
+      page.on('pageerror', recordError);
+      await use((pattern) => {
+        expected.push(pattern);
+      });
+      page.off('console', recordConsole);
+      page.off('pageerror', recordError);
+      expect({
+        unexpected: messages.filter(
+          (message) => !expected.some((pattern) => message.search(pattern) !== -1),
+        ),
+        missing: expected
+          .filter((pattern) => !messages.some((message) => message.search(pattern) !== -1))
+          .map(String),
+      }).toEqual({ unexpected: [], missing: [] });
+    },
+    { auto: true },
+  ],
+});
diff --git a/showcase/todo-plain-01/web/e2e/todos.spec.ts b/showcase/todo-plain-01/web/e2e/todos.spec.ts
new file mode 100644
index 0000000..7cf0ae6
--- /dev/null
+++ b/showcase/todo-plain-01/web/e2e/todos.spec.ts
@@ -0,0 +1,129 @@
+import { randomUUID } from 'node:crypto';
+import { expect, type Locator, type Page, test } from './fixtures';
+
+/**
+ * The todo behaviour, end to end: the page in Chromium, the Vite server's
+ * `/trpc` proxy, and the real api process. The tests share one api process,
+ * so each makes its own titles and never counts todos.
+ */
+const newTitle = (label: string) => `${label} ${randomUUID().slice(0, 8)}`;
+
+const todoCheckbox = (page: Page, title: string) =>
+  page.getByRole('list', { name: 'Todos' }).getByRole('checkbox', { name: title, exact: true });
+
+/** Submits the title and waits for the api to answer the create. */
+async function addTodo(page: Page, title: string) {
+  const created = page.waitForResponse((response) => response.url().includes('/trpc/todos.create'));
+  await page.getByRole('textbox', { name: 'Title' }).fill(title);
+  await page.getByRole('button', { name: 'Add', exact: true }).click();
+  return created;
+}
+
+/** Clicks and waits for the api to answer the mutation, so a reload never overtakes it. */
+async function clickAndSave(page: Page, target: Locator) {
+  const saved = page.waitForResponse((response) => response.request().method() === 'POST');
+  await target.click();
+  await saved;
+}
+
+test.describe('Todos', () => {
+  test.beforeEach(async ({ page }) => {
+    await page.goto('/');
+  });
+
+  test('creates a todo through the api with the trimmed title', async ({ page }) => {
+    const title = newTitle('Buy milk');
+
+    const created = await addTodo(page, `  ${title} `);
+
+    expect(created.status()).toBe(200);
+    await expect(todoCheckbox(page, title)).not.toBeChecked();
+    await expect(page.getByRole('textbox', { name: 'Title' })).toHaveValue('');
+  });
+
+  test('asks for a title and sends no request when the title is blank', async ({ page }) => {
+    const creates: string[] = [];
+    page.on('request', (request) => {
+      if (request.url().includes('/trpc/todos.create')) {
+        creates.push(request.url());
+      }
+    });
+
+    await page.getByRole('textbox', { name: 'Title' }).fill('   ');
+    await page.getByRole('button', { name: 'Add', exact: true }).click();
+
+    await expect(page.getByRole('alert')).toHaveText('Enter a title');
+    await expect(page.getByRole('textbox', { name: 'Title' })).toHaveAttribute(
+      'aria-invalid',
+      'true',
+    );
+    expect(creates).toEqual([]);
+  });
+
+  test('toggles a todo completed and back, and keeps each state across a reload', async ({
+    page,
+  }) => {
+    const title = newTitle('Walk the dog');
+    await addTodo(page, title);
+
+    await clickAndSave(page, todoCheckbox(page, title));
+    await expect(todoCheckbox(page, title)).toBeChecked();
+    await page.reload();
+    await expect(todoCheckbox(page, title)).toBeChecked();
+
+    await clickAndSave(page, todoCheckbox(page, title));
+    await expect(todoCheckbox(page, title)).not.toBeChecked();
+    await page.reload();
+    await expect(todoCheckbox(page, title)).not.toBeChecked();
+  });
+
+  test('deletes a todo, keeps the others, and it stays gone after a reload', async ({ page }) => {
+    const kept = newTitle('Read a book');
+    const title = newTitle('Water the plants');
+    await addTodo(page, kept);
+    await addTodo(page, title);
+
+    await clickAndSave(page, page.getByRole('button', { name: `Delete ${title}`, exact: true }));
+
+    await expect(todoCheckbox(page, title)).toHaveCount(0);
+    await page.reload();
+    await expect(todoCheckbox(page, kept)).toBeVisible();
+    await expect(todoCheckbox(page, title)).toHaveCount(0);
+  });
+
+  test('the api answers a toggle or a delete of an unknown id as not found', async ({
+    request,
+  }) => {
+    const data = { id: randomUUID() };
+
+    const toggled = await request.post('/trpc/todos.toggle', { data });
+    const deleted = await request.post('/trpc/todos.delete', { data });
+
+    expect(toggled.status()).toBe(404);
+    expect(await toggled.json()).toMatchObject({ error: { data: { code: 'NOT_FOUND' } } });
+    expect(deleted.status()).toBe(404);
+    expect(await deleted.json()).toMatchObject({ error: { data: { code: 'NOT_FOUND' } } });
+  });
+
+  test('says so when the todos cannot load', async ({ page, expectConsole }) => {
+    expectConsole(/Failed to load resource: .*500/);
+    await page.route('**/trpc/**', (route) =>
+      route.fulfill({ status: 500, contentType: 'application/json', body: '{}' }),
+    );
+
+    await page.reload();
+
+    await expect(page.getByRole('alert')).toHaveText('Could not load the todos');
+  });
+
+  test('says so when a change cannot be saved', async ({ page, expectConsole }) => {
+    expectConsole(/Failed to load resource: .*500/);
+    await page.route('**/trpc/todos.create**', (route) =>
+      route.fulfill({ status: 500, contentType: 'application/json', body: '{}' }),
+    );
+
+    await addTodo(page, newTitle('Buy milk'));
+
+    await expect(page.getByRole('alert')).toHaveText('Could not save the change');
+  });
+});
