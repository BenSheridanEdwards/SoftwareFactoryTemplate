+import { TodoForm } from './TodoForm';
+import { TodoList } from './TodoList';
+import { useTodos } from './useTodos';
+
+export function TodosPage() {
+  const { todos, createPending, saveFailed, createTodo, toggleTodo, deleteTodo } = useTodos();
+
+  return (
+    <main className="mx-auto max-w-160 px-4 py-6 sm:py-12">
+      <h1 className="mb-8 text-3xl font-bold tracking-tight">Todos</h1>
+      <div className="flex flex-col gap-4 rounded-xl border border-line bg-surface p-6">
+        <TodoForm onCreate={createTodo} pending={createPending} />
+        {saveFailed ? (
+          <p role="alert" className="text-danger">
+            Could not save the change
+          </p>
+        ) : null}
+        {todos.status === 'loading' ? <output className="block text-muted">Loading…</output> : null}
+        {todos.status === 'failed' ? (
+          <p role="alert" className="text-danger">
+            Could not load the todos
+          </p>
+        ) : null}
+        {todos.status === 'loaded' ? (
+          <TodoList todos={todos.todos} onToggle={toggleTodo} onDelete={deleteTodo} />
+        ) : null}
+      </div>
+    </main>
+  );
+}
