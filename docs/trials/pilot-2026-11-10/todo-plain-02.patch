index 0000000..d42f4cb
--- /dev/null
+++ b/showcase/todo-plain-02/web/src/routes/todos/TodosPage.test.tsx
@@ -0,0 +1,125 @@
+import { render, screen, waitFor } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { axe } from 'jest-axe';
+import { type TestApiHandlers, TestApiProvider } from '../../api-client';
+import { TodosPage } from './TodosPage';
+import type { Todo } from './useTodos';
+
+const milk: Todo = { id: 'a', title: 'Buy milk', completed: false };
+const dog: Todo = { id: 'b', title: 'Walk the dog', completed: true };
+
+function renderPage(handlers: TestApiHandlers) {
+  const view = render(
+    <TestApiProvider handlers={handlers}>
+      <TodosPage />
+    </TestApiProvider>,
+  );
+  return { ...view, user: userEvent.setup() };
+}
+
+/** A list handler that answers `before` once, then `after` on every refresh. */
+function listChanging(before: Todo[], after: Todo[]) {
+  return jest.fn<Todo[], []>().mockReturnValueOnce(before).mockReturnValue(after);
+}
+
+it('shows loading, then the todos in the Todos list', async () => {
+  renderPage({ 'todos.list': () => [milk, dog] });
+
+  expect(screen.getByRole('heading', { level: 1, name: 'Todos' })).toBeInTheDocument();
+  expect(screen.getByRole('status')).toHaveTextContent('Loading…');
+  expect(await screen.findByRole('list', { name: 'Todos' })).toBeInTheDocument();
+  expect(screen.getByRole('checkbox', { name: 'Buy milk' })).not.toBeChecked();
+  expect(screen.getByRole('checkbox', { name: 'Walk the dog' })).toBeChecked();
+  expect(screen.queryByRole('status')).not.toBeInTheDocument();
+});
+
+it('says so when there are no todos', async () => {
+  renderPage({ 'todos.list': () => [] });
+
+  expect(await screen.findByText('No todos yet')).toBeInTheDocument();
+  expect(screen.queryByRole('list')).not.toBeInTheDocument();
+});
+
+it('creates a todo with the trimmed title, clears the field and lists it', async () => {
+  const create = jest.fn(() => milk);
+  const { user } = renderPage({ 'todos.list': listChanging([], [milk]), 'todos.create': create });
+
+  await user.type(screen.getByRole('textbox', { name: 'Title' }), '  Buy milk ');
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+
+  expect(await screen.findByRole('checkbox', { name: 'Buy milk' })).toBeInTheDocument();
+  expect(create).toHaveBeenCalledWith({ title: 'Buy milk' });
+  expect(screen.getByRole('textbox', { name: 'Title' })).toHaveValue('');
+});
+
+it.each(['', '   '])('asks for a title and sends nothing when the title is %j', async (title) => {
+  const create = jest.fn(() => milk);
+  const { user } = renderPage({ 'todos.list': () => [], 'todos.create': create });
+
+  if (title) {
+    await user.type(screen.getByRole('textbox', { name: 'Title' }), title);
+  }
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Enter a title');
+  expect(screen.getByRole('textbox', { name: 'Title' })).toBeInvalid();
+  expect(create).not.toHaveBeenCalled();
+});
+
+it('toggles a todo through the api and shows the saved state', async () => {
+  const done = { ...milk, completed: true };
+  const toggle = jest.fn(() => done);
+  const { user } = renderPage({
+    'todos.list': listChanging([milk], [done]),
+    'todos.toggle': toggle,
+  });
+
+  await user.click(await screen.findByRole('checkbox', { name: 'Buy milk' }));
+
+  await waitFor(() => expect(screen.getByRole('checkbox', { name: 'Buy milk' })).toBeChecked());
+  expect(toggle).toHaveBeenCalledWith({ id: milk.id });
+});
+
+it('deletes a todo through the api and keeps the others', async () => {
+  const remove = jest.fn(() => ({ id: milk.id }));
+  const { user } = renderPage({
+    'todos.list': listChanging([milk, dog], [dog]),
+    'todos.delete': remove,
+  });
+
+  await user.click(await screen.findByRole('button', { name: 'Delete Buy milk' }));
+
+  await waitFor(() =>
+    expect(screen.queryByRole('checkbox', { name: 'Buy milk' })).not.toBeInTheDocument(),
+  );
+  expect(screen.getByRole('checkbox', { name: 'Walk the dog' })).toBeInTheDocument();
+  expect(remove).toHaveBeenCalledWith({ id: milk.id });
+});
+
+it('says so when the todos cannot load', async () => {
+  renderPage({ 'todos.list': () => Promise.reject(new Error('api down')) });
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Could not load the todos');
+});
+
+it('says so when a change cannot be saved, and keeps the list', async () => {
+  const { user } = renderPage({
+    'todos.list': () => [milk],
+    'todos.delete': () => Promise.reject(new Error('api down')),
+  });
+
+  await user.click(await screen.findByRole('button', { name: 'Delete Buy milk' }));
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Could not save the change');
+  expect(screen.getByRole('checkbox', { name: 'Buy milk' })).toBeInTheDocument();
+});
+
+it('has no axe-detectable violations with todos listed and a validation error showing', async () => {
+  const { container, user } = renderPage({ 'todos.list': () => [milk, dog] });
+
+  await screen.findByRole('list', { name: 'Todos' });
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+  await screen.findByRole('alert');
+
+  expect(await axe(container)).toHaveNoViolations();
+});
