+import { useMutation, useMutationState, useQuery, useQueryClient } from '@tanstack/react-query';
+import { type RouterInputs, type RouterOutputs, useTrpc } from '../../api-client';
+
+export type Todo = RouterOutputs['todos']['list'][number];
+export type CreateTodo = RouterInputs['todos']['create'];
+
+export type TodosState =
+  | { readonly status: 'loading' }
+  | { readonly status: 'failed' }
+  | { readonly status: 'loaded'; readonly todos: readonly Todo[] };
+
+function toTodosState(query: {
+  readonly isError: boolean;
+  readonly data: readonly Todo[] | undefined;
+}): TodosState {
+  if (query.isError) return { status: 'failed' };
+  if (query.data === undefined) return { status: 'loading' };
+  return { status: 'loaded', todos: query.data };
+}
+
+/** The todos from the api, and the changes that save to it and refresh the list. */
+export function useTodos() {
+  const trpc = useTrpc();
+  const queryClient = useQueryClient();
+  const query = useQuery(trpc.todos.list.queryOptions());
+  const refreshOnSuccess = {
+    onSuccess: () => queryClient.invalidateQueries({ queryKey: trpc.todos.list.queryKey() }),
+  };
+  const create = useMutation(trpc.todos.create.mutationOptions(refreshOnSuccess));
+  const toggle = useMutation(trpc.todos.toggle.mutationOptions(refreshOnSuccess));
+  const remove = useMutation(trpc.todos.delete.mutationOptions(refreshOnSuccess));
+  // The newest change decides the alert, so a later success clears an earlier failure.
+  const changeStatuses = useMutationState({ select: (mutation) => mutation.state.status });
+
+  return {
+    todos: toTodosState(query),
+    creating: create.isPending,
+    saveFailed: changeStatuses.at(-1) === 'error',
+    createTodo: (input: CreateTodo) => create.mutate(input),
+    toggleTodo: (id: Todo['id']) => toggle.mutate({ id }),
+    deleteTodo: (id: Todo['id']) => remove.mutate({ id }),
+  };
+}
