@@ -0,0 +1,161 @@
+import { randomUUID } from 'node:crypto';
+import AxeBuilder from '@axe-core/playwright';
+import { expect, type Page, test } from './fixtures';
+
+/**
+ * The Todos behaviour, end to end: the page in Chromium, the Vite server's
+ * `/trpc` proxy, and the real api process. The tests share that process, so
+ * each one makes its own titles and never counts todos.
+ */
+const newTitle = (label: string) => `${label} ${randomUUID().slice(0, 8)}`;
+
+const todoItem = (page: Page, title: string) =>
+  page
+    .getByRole('list', { name: 'Todos' })
+    .getByRole('listitem')
+    .filter({ has: page.getByRole('checkbox', { name: title, exact: true }) });
+
+async function addTodo(page: Page, title: string) {
+  await page.getByRole('textbox', { name: 'Title' }).fill(title);
+  await page.getByRole('button', { name: 'Add', exact: true }).click();
+  await expect(todoItem(page, title.trim())).toBeVisible();
+}
+
+test.describe('Todos', () => {
+  test('creates a todo with a trimmed title, lists it unchecked and clears the field', async ({
+    page,
+  }) => {
+    const title = newTitle('Buy milk');
+    await page.goto('/');
+    await expect(page.getByRole('heading', { level: 1, name: 'Todos' })).toBeVisible();
+    const created = page.waitForResponse((response) =>
+      response.url().includes('/trpc/todos.create'),
+    );
+
+    await addTodo(page, `  ${title}  `);
+
+    expect((await created).status()).toBe(200);
+    await expect(page.getByRole('checkbox', { name: title, exact: true })).not.toBeChecked();
+    await expect(page.getByRole('textbox', { name: 'Title' })).toHaveValue('');
+  });
+
+  test('asks for a title and saves nothing when the title is blank', async ({ page }) => {
+    const saves: string[] = [];
+    page.on('request', (request) => {
+      if (request.method() === 'POST') {
+        saves.push(request.url());
+      }
+    });
+    await page.goto('/');
+
+    await page.getByRole('textbox', { name: 'Title' }).fill('   ');
+    await page.getByRole('button', { name: 'Add', exact: true }).click();
+
+    await expect(page.getByRole('alert')).toHaveText('Enter a title');
+    await expect(page.getByRole('textbox', { name: 'Title' })).toHaveAttribute(
+      'aria-invalid',
+      'true',
+    );
+    expect(saves).toEqual([]);
+  });
+
+  test('toggles a todo complete and back, and keeps each state across a reload', async ({
+    page,
+  }) => {
+    const title = newTitle('Walk the dog');
+    await page.goto('/');
+    await addTodo(page, title);
+    const checkbox = page.getByRole('checkbox', { name: title, exact: true });
+
+    await checkbox.click();
+    await expect(checkbox).toBeChecked();
+    await page.reload();
+    await expect(checkbox).toBeChecked();
+
+    await checkbox.click();
+    await expect(checkbox).not.toBeChecked();
+    await page.reload();
+    await expect(checkbox).not.toBeChecked();
+  });
+
+  test('deletes a todo, keeps the others, and it stays gone across a reload', async ({ page }) => {
+    const kept = newTitle('Read a book');
+    const title = newTitle('Water the plants');
+    await page.goto('/');
+    await addTodo(page, kept);
+    await addTodo(page, title);
+
+    await page.getByRole('button', { name: `Delete ${title}`, exact: true }).click();
+
+    await expect(todoItem(page, title)).toHaveCount(0);
+    await page.reload();
+    await expect(todoItem(page, kept)).toBeVisible();
+    await expect(todoItem(page, title)).toHaveCount(0);
+  });
+
+  test('the api rejects a blank title as a bad request', async ({ request }) => {
+    const response = await request.post('/trpc/todos.create', { data: { title: '   ' } });
+
+    expect(response.status()).toBe(400);
+    expect(await response.json()).toMatchObject({ error: { data: { code: 'BAD_REQUEST' } } });
+  });
+
+  test('the api answers not found when it toggles or deletes an unknown id', async ({
+    request,
+  }) => {
+    const responses = await Promise.all(
+      ['toggle', 'delete'].map((name) =>
+        request.post(`/trpc/todos.${name}`, { data: { id: randomUUID() } }),
+      ),
+    );
+
+    expect(responses.map((response) => response.status())).toEqual([404, 404]);
+  });
+
+  test('says so when the todos cannot load', async ({ page, expectConsole }) => {
+    expectConsole(/Failed to load resource: .*500/);
+    await page.route('**/trpc/**', (route) =>
+      route.fulfill({ status: 500, contentType: 'application/json', body: '{}' }),
+    );
+
+    await page.goto('/');
+
+    await expect(page.getByRole('alert')).toHaveText('Could not load the todos');
+  });
+
+  test('says so when a change cannot be saved, and keeps the todo', async ({
+    page,
+    expectConsole,
+  }) => {
+    const title = newTitle('Call the bank');
+    await page.goto('/');
+    await addTodo(page, title);
+    expectConsole(/Failed to load resource: .*500/);
+    await page.route('**/trpc/todos.delete**', (route) =>
+      route.fulfill({ status: 500, contentType: 'application/json', body: '{}' }),
+    );
+
+    await page.getByRole('button', { name: `Delete ${title}`, exact: true }).click();
+
+    await expect(page.getByRole('alert')).toHaveText('Could not save the change');
+    await expect(todoItem(page, title)).toBeVisible();
+  });
+
+  test('has no detectable WCAG A/AA violation with todos listed and a validation error', async ({
+    page,
+  }) => {
+    const title = newTitle('Check contrast');
+    await page.goto('/');
+    await addTodo(page, title);
+    await page.getByRole('checkbox', { name: title, exact: true }).click();
+    await expect(page.getByRole('checkbox', { name: title, exact: true })).toBeChecked();
+    await page.getByRole('button', { name: 'Add', exact: true }).click();
+    await expect(page.getByRole('alert')).toHaveText('Enter a title');
+
+    const scan = await new AxeBuilder({ page })
+      .withTags(['wcag2a', 'wcag2aa', 'wcag21a', 'wcag21aa'])
+      .analyze();
+
+    expect(scan.violations).toEqual([]);
+  });
+});
