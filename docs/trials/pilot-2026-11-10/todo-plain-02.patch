@@ -0,0 +1,35 @@
+beforeEach(() => jest.resetModules());
+
+it('starts empty and lists created todos in creation order', async () => {
+  const { createTodo, listTodos } = await import('./application.ts');
+  expect(listTodos()).toEqual([]);
+  const milk = createTodo({ title: 'Buy milk' });
+  const dog = createTodo({ title: 'Walk the dog' });
+  expect(milk).toEqual({ id: expect.any(String), title: 'Buy milk', completed: false });
+  expect(dog.id).not.toBe(milk.id);
+  expect(listTodos()).toEqual([milk, dog]);
+});
+
+it('toggles a todo complete and back', async () => {
+  const { createTodo, listTodos, toggleTodo } = await import('./application.ts');
+  const milk = createTodo({ title: 'Buy milk' });
+  expect(toggleTodo({ id: milk.id })).toEqual({ ...milk, completed: true });
+  expect(listTodos()).toEqual([{ ...milk, completed: true }]);
+  expect(toggleTodo({ id: milk.id })).toEqual(milk);
+});
+
+it('deletes a todo and keeps the others', async () => {
+  const { createTodo, deleteTodo, listTodos } = await import('./application.ts');
+  const milk = createTodo({ title: 'Buy milk' });
+  const dog = createTodo({ title: 'Walk the dog' });
+  expect(deleteTodo({ id: milk.id })).toEqual({ id: milk.id });
+  expect(listTodos()).toEqual([dog]);
+});
+
+it('answers undefined for an id no todo has and changes nothing', async () => {
+  const { createTodo, deleteTodo, listTodos, toggleTodo } = await import('./application.ts');
+  const milk = createTodo({ title: 'Buy milk' });
+  expect(toggleTodo({ id: 'missing' })).toBeUndefined();
+  expect(deleteTodo({ id: 'missing' })).toBeUndefined();
+  expect(listTodos()).toEqual([milk]);
+});
diff --git a/showcase/todo-plain-02/api/src/features/todos/application.ts b/showcase/todo-plain-02/api/src/features/todos/application.ts
new file mode 100644
index 0000000..9154e5f
--- /dev/null
+++ b/showcase/todo-plain-02/api/src/features/todos/application.ts
@@ -0,0 +1,28 @@
+import { appendTodo, findTodo, newTodo, removeTodo, type Todo, toggleCompleted } from './domain.ts';
+import { createInMemoryTodos, createTodoId } from './integrations.ts';
+
+const store = createInMemoryTodos();
+
+export function listTodos(): readonly Todo[] {
+  return store.read();
+}
+
+export function createTodo(request: { readonly title: Todo['title'] }): Todo {
+  const todo = newTodo(createTodoId(), request.title);
+  store.write(appendTodo(store.read(), todo));
+  return todo;
+}
+
+/** The toggled todo, or `undefined` when no todo has the id. */
+export function toggleTodo(request: { readonly id: Todo['id'] }): Todo | undefined {
+  store.write(toggleCompleted(store.read(), request.id));
+  return findTodo(store.read(), request.id);
+}
+
+/** The deleted id, or `undefined` when no todo has the id. */
+export function deleteTodo(request: { readonly id: Todo['id'] }): Pick<Todo, 'id'> | undefined {
+  const todo = findTodo(store.read(), request.id);
+  if (!todo) return undefined;
+  store.write(removeTodo(store.read(), todo.id));
+  return { id: todo.id };
+}
diff --git a/showcase/todo-plain-02/api/src/features/todos/domain.test.ts b/showcase/todo-plain-02/api/src/features/todos/domain.test.ts
