+++ b/showcase/todo-plain-02/api/src/features/todos/domain.test.ts
@@ -0,0 +1,35 @@
+import { appendTodo, findTodo, newTodo, removeTodo, toggleCompleted } from './domain.ts';
+
+const milk = { id: 'a', title: 'Buy milk', completed: false };
+const dog = { id: 'b', title: 'Walk the dog', completed: true };
+
+it('makes a new todo that is not completed', () => {
+  expect(newTodo('a', 'Buy milk')).toEqual(milk);
+});
+
+it('finds a todo by its id', () => {
+  expect(findTodo([milk, dog], 'b')).toBe(dog);
+  expect(findTodo([milk], 'b')).toBeUndefined();
+});
+
+it('appends a todo after the existing ones', () => {
+  expect(appendTodo([milk], dog)).toEqual([milk, dog]);
+});
+
+it('toggles only the todo with the id, there and back', () => {
+  const toggled = toggleCompleted([milk, dog], 'a');
+  expect(toggled).toEqual([{ ...milk, completed: true }, dog]);
+  expect(toggleCompleted(toggled, 'a')).toEqual([milk, dog]);
+});
+
+it('removes only the todo with the id', () => {
+  expect(removeTodo([milk, dog], 'a')).toEqual([dog]);
+});
+
+it('leaves the input array unchanged', () => {
+  const todos = Object.freeze([Object.freeze(milk)]);
+  appendTodo(todos, dog);
+  toggleCompleted(todos, 'a');
+  removeTodo(todos, 'a');
+  expect(todos).toEqual([milk]);
+});
diff --git a/showcase/todo-plain-02/api/src/features/todos/domain.ts b/showcase/todo-plain-02/api/src/features/todos/domain.ts
new file mode 100644
index 0000000..b26727f
--- /dev/null
+++ b/showcase/todo-plain-02/api/src/features/todos/domain.ts
@@ -0,0 +1,25 @@
+export interface Todo {
+  readonly id: string;
+  readonly title: string;
+  readonly completed: boolean;
+}
+
+export function newTodo(id: Todo['id'], title: Todo['title']): Todo {
+  return { id, title, completed: false };
+}
+
+export function findTodo(todos: readonly Todo[], id: Todo['id']): Todo | undefined {
+  return todos.find((todo) => todo.id === id);
+}
+
+export function appendTodo(todos: readonly Todo[], todo: Todo): readonly Todo[] {
+  return [...todos, todo];
+}
+
+export function toggleCompleted(todos: readonly Todo[], id: Todo['id']): readonly Todo[] {
+  return todos.map((todo) => (todo.id === id ? { ...todo, completed: !todo.completed } : todo));
+}
+
+export function removeTodo(todos: readonly Todo[], id: Todo['id']): readonly Todo[] {
+  return todos.filter((todo) => todo.id !== id);
+}
