+import { act, renderHook, waitFor } from '@testing-library/react';
+import type { ReactNode } from 'react';
+import { type TestApiHandlers, TestApiProvider } from '../../api-client';
+import { type Todo, useTodos } from './useTodos';
+
+const milk: Todo = { id: 'a', title: 'Buy milk', completed: false };
+
+function renderTodos(handlers: TestApiHandlers) {
+  const wrapper = ({ children }: { children: ReactNode }) => (
+    <TestApiProvider handlers={handlers}>{children}</TestApiProvider>
+  );
+  return renderHook(() => useTodos(), { wrapper });
+}
+
+it('loads, then holds the todos from the api', async () => {
+  const { result } = renderTodos({ 'todos.list': () => [milk] });
+
+  expect(result.current.todos).toEqual({ status: 'loading' });
+  await waitFor(() => expect(result.current.todos).toEqual({ status: 'loaded', todos: [milk] }));
+});
+
+it('reports a failed load', async () => {
+  const { result } = renderTodos({ 'todos.list': () => Promise.reject(new Error('api down')) });
+
+  await waitFor(() => expect(result.current.todos).toEqual({ status: 'failed' }));
+});
+
+it('stays creating until the api answers and the list has refreshed', async () => {
+  const pending = { answer: (_todo: Todo): void => undefined };
+  const list = jest.fn<Todo[], []>().mockReturnValueOnce([]).mockReturnValue([milk]);
+  const { result } = renderTodos({
+    'todos.list': list,
+    'todos.create': () =>
+      new Promise((resolve) => {
+        pending.answer = resolve;
+      }),
+  });
+  await waitFor(() => expect(result.current.todos).toEqual({ status: 'loaded', todos: [] }));
+
+  act(() => result.current.createTodo({ title: 'Buy milk' }));
+  await waitFor(() => expect(result.current.creating).toBe(true));
+
+  await act(async () => pending.answer(milk));
+  await waitFor(() => expect(result.current.creating).toBe(false));
+  expect(result.current.todos).toEqual({ status: 'loaded', todos: [milk] });
+});
+
+it('reports a failed change until a later change succeeds', async () => {
+  const { result } = renderTodos({
+    'todos.list': () => [milk],
+    'todos.toggle': () => Promise.reject(new Error('api down')),
+    'todos.delete': ({ id }) => ({ id }),
+  });
+  await waitFor(() => expect(result.current.todos.status).toBe('loaded'));
+
+  act(() => result.current.toggleTodo(milk.id));
+  await waitFor(() => expect(result.current.saveFailed).toBe(true));
+
+  act(() => result.current.deleteTodo(milk.id));
+  await waitFor(() => expect(result.current.saveFailed).toBe(false));
+});
