+  const trpc = useTrpc();
+  const query = useQuery(trpc.todos.list.queryOptions());
+  if (query.error) return <p>{query.error.message}</p>;
+  return <p>{query.data ? query.data.map((todo) => todo.title).join(', ') : 'waiting'}</p>;
+}
