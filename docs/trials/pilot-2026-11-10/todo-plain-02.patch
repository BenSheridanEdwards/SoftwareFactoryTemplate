+import { TRPCError } from '@trpc/server';
+import { Schema } from 'effect';
+import { procedure, router } from '../../trpc.ts';
+import { createTodo, deleteTodo, listTodos, toggleTodo } from './application.ts';
+
+const createInputSchema = Schema.Struct({ title: Schema.Trim.check(Schema.isNonEmpty()) });
+const todoIdInputSchema = Schema.Struct({ id: Schema.String });
+
+function foundOrThrow<Found>(found: Found | undefined): Found {
+  if (found === undefined) {
+    throw new TRPCError({ code: 'NOT_FOUND', message: 'Todo not found' });
+  }
+  return found;
+}
+
+export const todosRouter = router({
+  list: procedure.input(Schema.toStandardSchemaV1(Schema.Undefined)).query(() => listTodos()),
+  create: procedure
+    .input(Schema.toStandardSchemaV1(createInputSchema))
+    .mutation(({ input }) => createTodo(input)),
+  toggle: procedure
+    .input(Schema.toStandardSchemaV1(todoIdInputSchema))
+    .mutation(({ input }) => foundOrThrow(toggleTodo(input))),
+  delete: procedure
+    .input(Schema.toStandardSchemaV1(todoIdInputSchema))
+    .mutation(({ input }) => foundOrThrow(deleteTodo(input))),
+});
