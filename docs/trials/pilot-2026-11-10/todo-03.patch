index 0000000..9e7c5f1
--- /dev/null
+++ b/showcase/todo-03/api/src/features/todos/domain.ts
@@ -0,0 +1,21 @@
+export interface Todo {
+  readonly id: string;
+  readonly title: string;
+  readonly completed: boolean;
+}
+
+export function newTodo(id: Todo['id'], title: Todo['title']): Todo {
+  return { id, title, completed: false };
+}
+
+export function toggleCompleted(todo: Todo): Todo {
+  return { ...todo, completed: !todo.completed };
+}
+
+export function replaceTodo(todos: readonly Todo[], replacement: Todo): readonly Todo[] {
+  return todos.map((todo) => (todo.id === replacement.id ? replacement : todo));
+}
+
+export function removeTodo(todos: readonly Todo[], id: Todo['id']): readonly Todo[] {
+  return todos.filter((todo) => todo.id !== id);
+}
