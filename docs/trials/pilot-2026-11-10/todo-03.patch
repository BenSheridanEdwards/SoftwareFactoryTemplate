+import { test as base, type ConsoleMessage, expect } from '@playwright/test';
+
+export { expect, type Page } from '@playwright/test';
+
+interface ConsoleFixtures {
+  expectedConsole: RegExp[];
+  expectConsole: (pattern: RegExp) => void;
+}
+
+export const test = base.extend<ConsoleFixtures>({
+  expectedConsole: [[], { option: true }],
+  expectConsole: [
+    async ({ page, expectedConsole }, use) => {
+      const messages: string[] = [];
+      const expected = [...expectedConsole];
+      const recordConsole = (message: ConsoleMessage) => {
+        if (message.type() === 'warning' || message.type() === 'error') {
+          messages.push(`console.${message.type()}: ${message.text()}`);
+        }
+      };
+      const recordError = (error: Error) => {
+        messages.push(`pageerror: ${error.message}`);
+      };
+      page.on('console', recordConsole);
+      page.on('pageerror', recordError);
+      await use((pattern) => {
+        expected.push(pattern);
+      });
+      page.off('console', recordConsole);
+      page.off('pageerror', recordError);
+      expect({
+        unexpected: messages.filter(
+          (message) => !expected.some((pattern) => message.search(pattern) !== -1),
+        ),
+        missing: expected
+          .filter((pattern) => !messages.some((message) => message.search(pattern) !== -1))
+          .map(String),
+      }).toEqual({ unexpected: [], missing: [] });
+    },
+    { auto: true },
+  ],
+});
diff --git a/showcase/todo-03/web/e2e/todos.spec.ts b/showcase/todo-03/web/e2e/todos.spec.ts
new file mode 100644
index 0000000..6b0fc1f
--- /dev/null
+++ b/showcase/todo-03/web/e2e/todos.spec.ts
@@ -0,0 +1,141 @@
+import { randomUUID } from 'node:crypto';
+import AxeBuilder from '@axe-core/playwright';
+import { expect, type Page, test } from './fixtures';
+
+/**
+ * The todos behaviour, end to end: the page in Chromium, the Vite server's
+ * `/trpc` proxy, and the real api process. The tests share that process, so
+ * each one makes its own titles and never counts todos.
+ */
+const newTitle = (label: string) => `${label} ${randomUUID().slice(0, 8)}`;
+
+const todo = (page: Page, title: string) =>
+  page.getByRole('list', { name: 'Todos' }).getByRole('checkbox', { name: title, exact: true });
+
+const answered = (page: Page, procedure: string) =>
+  page.waitForResponse((response) => response.url().includes(`/trpc/todos.${procedure}`));
+
+async function addTodo(page: Page, title: string) {
+  await page.getByRole('textbox', { name: 'Title' }).fill(title);
+  await page.getByRole('button', { name: 'Add', exact: true }).click();
+  await expect(todo(page, title)).toBeVisible();
+}
+
+test.describe('Todos', () => {
+  test('creates a todo through the api and lists it unchecked', async ({ page }) => {
+    const title = newTitle('Buy milk');
+    await page.goto('/');
+    const created = answered(page, 'create');
+
+    await addTodo(page, `  ${title} `);
+
+    expect((await created).status()).toBe(200);
+    await expect(todo(page, title)).not.toBeChecked();
+    await expect(page.getByRole('textbox', { name: 'Title' })).toHaveValue('');
+  });
+
+  test('asks for a title and sends no request when the title is blank', async ({ page }) => {
+    await page.goto('/');
+    await expect(page.getByRole('status')).toHaveCount(0);
+    const apiCalls: string[] = [];
+    page.on('request', (request) => {
+      if (new URL(request.url()).pathname.startsWith('/trpc')) {
+        apiCalls.push(request.url());
+      }
+    });
+
+    await page.getByRole('textbox', { name: 'Title' }).fill('   ');
+    await page.getByRole('button', { name: 'Add', exact: true }).click();
+
+    await expect(page.getByRole('alert')).toHaveText('Enter a title');
+    await expect(page.getByRole('textbox', { name: 'Title' })).toHaveAttribute(
+      'aria-invalid',
+      'true',
+    );
+    expect(apiCalls).toEqual([]);
+  });
+
+  test('toggles a todo complete and back, and keeps each state across a reload', async ({
+    page,
+  }) => {
+    const title = newTitle('Walk the dog');
+    await page.goto('/');
+    await addTodo(page, title);
+
+    const completed = answered(page, 'toggle');
+    await todo(page, title).click();
+    await completed;
+    await expect(todo(page, title)).toBeChecked();
+    await page.reload();
+    await expect(todo(page, title)).toBeChecked();
+
+    const restored = answered(page, 'toggle');
+    await todo(page, title).click();
+    await restored;
+    await expect(todo(page, title)).not.toBeChecked();
+    await page.reload();
+    await expect(todo(page, title)).not.toBeChecked();
+  });
+
+  test('deletes a todo, and it stays gone after a reload', async ({ page }) => {
+    const kept = newTitle('Read a book');
+    const title = newTitle('Water the plants');
+    await page.goto('/');
+    await addTodo(page, kept);
+    await addTodo(page, title);
+
+    const deleted = answered(page, 'delete');
+    await page.getByRole('button', { name: `Delete ${title}`, exact: true }).click();
+    await deleted;
+
+    await expect(todo(page, title)).toHaveCount(0);
+    await page.reload();
+    await expect(todo(page, kept)).toBeVisible();
+    await expect(todo(page, title)).toHaveCount(0);
+  });
+
+  test('the api rejects a blank title as a bad request', async ({ request }) => {
+    const response = await request.post('/trpc/todos.create', { data: { title: '   ' } });
+
+    expect(response.status()).toBe(400);
+    expect(await response.json()).toMatchObject({ error: { data: { code: 'BAD_REQUEST' } } });
+  });
+
+  test('the api reports an unknown todo as not found', async ({ request }) => {
+    const response = await request.post('/trpc/todos.toggle', { data: { id: randomUUID() } });
+
+    expect(response.status()).toBe(404);
+    expect(await response.json()).toMatchObject({ error: { data: { code: 'NOT_FOUND' } } });
+  });
+
+  test('says so when the api fails', async ({ page, expectConsole }) => {
+    expectConsole(/Failed to load resource: .*500/);
+    await page.route('**/trpc/**', (route) =>
+      route.fulfill({ status: 500, contentType: 'application/json', body: '{}' }),
+    );
+
+    await page.goto('/');
+
+    await expect(page.getByRole('alert')).toHaveText('Could not load the todos');
+  });
+
+  test('has no detectable WCAG A/AA violations with a completed todo and a validation error', async ({
+    page,
+  }) => {
+    const title = newTitle('Clean the desk');
+    await page.goto('/');
+    await addTodo(page, title);
+    const completed = answered(page, 'toggle');
+    await todo(page, title).click();
+    await completed;
+    await expect(todo(page, title)).toBeChecked();
+    await page.getByRole('button', { name: 'Add', exact: true }).click();
+    await expect(page.getByRole('alert')).toHaveText('Enter a title');
+
+    const scan = await new AxeBuilder({ page })
+      .withTags(['wcag2a', 'wcag2aa', 'wcag21a', 'wcag21aa'])
+      .analyze();
+
+    expect(scan.violations).toEqual([]);
+  });
+});
