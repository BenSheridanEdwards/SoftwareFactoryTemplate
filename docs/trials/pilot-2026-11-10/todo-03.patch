+import { TodoForm } from './TodoForm';
+import { TodoList } from './TodoList';
+import { useTodos } from './useTodos';
+
+export function TodosPage() {
+  const { todos, creating, saveFailed, createTodo, toggleTodo, deleteTodo } = useTodos();
+
+  return (
+    <main className="mx-auto flex max-w-160 flex-col gap-6 px-4 py-6 sm:py-12">
+      <h1 className="text-3xl font-bold tracking-tight">Todos</h1>
+      <TodoForm onCreate={createTodo} pending={creating} />
+      {saveFailed ? (
+        <p role="alert" className="text-danger">
+          Could not save the change. Try again.
+        </p>
+      ) : null}
+      {todos.status === 'loading' ? <output className="block">Loading…</output> : null}
+      {todos.status === 'failed' ? (
+        <p role="alert" className="text-danger">
+          Could not load the todos
+        </p>
+      ) : null}
+      {todos.status === 'loaded' ? (
+        <TodoList todos={todos.todos} onToggle={toggleTodo} onDelete={deleteTodo} />
+      ) : null}
+    </main>
+  );
+}
