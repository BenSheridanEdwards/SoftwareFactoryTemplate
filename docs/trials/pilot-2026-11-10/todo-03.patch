@@ -0,0 +1,33 @@
+import { newTodo, removeTodo, replaceTodo, toggleCompleted } from './domain.ts';
+
+const milk = { id: 'a', title: 'Buy milk', completed: false };
+const dog = { id: 'b', title: 'Walk the dog', completed: true };
+
+it('starts a new todo as not completed', () => {
+  expect(newTodo('a', 'Buy milk')).toEqual(milk);
+});
+
+it('inverts completed and restores it on a second toggle', () => {
+  expect(toggleCompleted(milk)).toEqual({ ...milk, completed: true });
+  expect(toggleCompleted(toggleCompleted(milk))).toEqual(milk);
+});
+
+it('replaces the todo with the same id and keeps the order', () => {
+  const done = toggleCompleted(milk);
+
+  expect(replaceTodo([milk, dog], done)).toEqual([done, dog]);
+});
+
+it('removes only the todo with the given id', () => {
+  expect(removeTodo([milk, dog], 'a')).toEqual([dog]);
+  expect(removeTodo([milk, dog], 'missing')).toEqual([milk, dog]);
+});
+
+it('leaves the input list unchanged', () => {
+  const todos = Object.freeze([milk, dog]);
+
+  replaceTodo(todos, toggleCompleted(milk));
+  removeTodo(todos, 'a');
+
+  expect(todos).toEqual([milk, dog]);
+});
diff --git a/showcase/todo-03/api/src/features/todos/domain.ts b/showcase/todo-03/api/src/features/todos/domain.ts
