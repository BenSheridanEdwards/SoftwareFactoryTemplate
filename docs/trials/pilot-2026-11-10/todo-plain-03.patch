@@ -0,0 +1,25 @@
+import { newTodo, removeTodo, toggleCompleted } from './domain.ts';
+
+const milk = { id: 'milk', title: 'Buy milk', completed: false };
+const dog = { id: 'dog', title: 'Walk the dog', completed: true };
+
+it('starts a new todo as not completed', () => {
+  expect(newTodo('milk', 'Buy milk')).toEqual(milk);
+});
+
+it('inverts completed on the todo with the id and keeps the others', () => {
+  expect(toggleCompleted([milk, dog], 'milk')).toEqual([{ ...milk, completed: true }, dog]);
+  expect(toggleCompleted([milk, dog], 'dog')).toEqual([milk, { ...dog, completed: false }]);
+});
+
+it('removes only the todo with the id', () => {
+  expect(removeTodo([milk, dog], 'milk')).toEqual([dog]);
+});
+
+it('leaves the input todos unchanged', () => {
+  const todos = Object.freeze([Object.freeze(milk)]);
+
+  expect(toggleCompleted(todos, 'milk')).toEqual([{ ...milk, completed: true }]);
+  expect(removeTodo(todos, 'milk')).toEqual([]);
+  expect(todos).toEqual([milk]);
+});
diff --git a/showcase/todo-plain-03/api/src/features/todos/domain.ts b/showcase/todo-plain-03/api/src/features/todos/domain.ts
new file mode 100644
index 0000000..4f45442
--- /dev/null
+++ b/showcase/todo-plain-03/api/src/features/todos/domain.ts
@@ -0,0 +1,17 @@
+export interface Todo {
+  readonly id: string;
+  readonly title: string;
+  readonly completed: boolean;
+}
+
+export function newTodo(id: Todo['id'], title: Todo['title']): Todo {
+  return { id, title, completed: false };
+}
+
+export function toggleCompleted(todos: readonly Todo[], id: Todo['id']): readonly Todo[] {
+  return todos.map((todo) => (todo.id === id ? { ...todo, completed: !todo.completed } : todo));
+}
+
+export function removeTodo(todos: readonly Todo[], id: Todo['id']): readonly Todo[] {
+  return todos.filter((todo) => todo.id !== id);
+}
