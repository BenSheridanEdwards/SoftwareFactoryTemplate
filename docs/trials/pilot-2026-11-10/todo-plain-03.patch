+beforeEach(() => jest.resetModules());
+
+it('starts empty and lists created todos oldest first', async () => {
+  const { createTodo, listTodos } = await import('./application.ts');
+  expect(listTodos()).toEqual([]);
+
+  const milk = createTodo({ title: 'Buy milk' });
+  const dog = createTodo({ title: 'Walk the dog' });
+
+  expect(milk).toEqual({ id: expect.any(String), title: 'Buy milk', completed: false });
+  expect(dog.id).not.toBe(milk.id);
+  expect(listTodos()).toEqual([milk, dog]);
+});
+
+it('toggles a todo complete and back', async () => {
+  const { createTodo, listTodos, toggleTodo } = await import('./application.ts');
+  const milk = createTodo({ title: 'Buy milk' });
+
+  expect(unwrap(toggleTodo({ id: milk.id }))).toEqual({ ...milk, completed: true });
+  expect(listTodos()).toEqual([{ ...milk, completed: true }]);
+  expect(unwrap(toggleTodo({ id: milk.id }))).toEqual(milk);
+});
+
+it('deletes a todo and answers with its id', async () => {
+  const { createTodo, deleteTodo, listTodos } = await import('./application.ts');
+  const milk = createTodo({ title: 'Buy milk' });
+  const dog = createTodo({ title: 'Walk the dog' });
+
+  expect(unwrap(deleteTodo({ id: milk.id }))).toEqual({ id: milk.id });
+  expect(listTodos()).toEqual([dog]);
+});
+
+it('finds no todo to toggle or delete under an unknown id', async () => {
+  const { createTodo, deleteTodo, listTodos, toggleTodo } = await import('./application.ts');
+  const milk = createTodo({ title: 'Buy milk' });
+
+  expect(toggleTodo({ id: 'unknown' })).toEqual({ ok: false, error: 'not-found' });
+  expect(deleteTodo({ id: 'unknown' })).toEqual({ ok: false, error: 'not-found' });
+  expect(listTodos()).toEqual([milk]);
+});
diff --git a/showcase/todo-plain-03/api/src/features/todos/application.ts b/showcase/todo-plain-03/api/src/features/todos/application.ts
new file mode 100644
index 0000000..c1f9c1c
--- /dev/null
+++ b/showcase/todo-plain-03/api/src/features/todos/application.ts
@@ -0,0 +1,34 @@
+import { newTodo, removeTodo, type Todo, toggleCompleted } from './domain.ts';
+import { createInMemoryTodos, createTodoId } from './integrations.ts';
+
+const store = createInMemoryTodos();
+
+/** The answer of a use case that needs an existing todo. */
+export type TodoOutcome<Value> =
+  | { readonly ok: true; readonly value: Value }
+  | { readonly ok: false; readonly error: 'not-found' };
+
+export function listTodos(): readonly Todo[] {
+  return store.read();
+}
+
+export function createTodo(request: { readonly title: string }): Todo {
+  const todo = newTodo(createTodoId(), request.title);
+  store.write([...store.read(), todo]);
+  return todo;
+}
+
+export function toggleTodo(request: { readonly id: string }): TodoOutcome<Todo> {
+  const todos = toggleCompleted(store.read(), request.id);
+  const toggled = todos.find((todo) => todo.id === request.id);
+  if (!toggled) return { ok: false, error: 'not-found' };
+  store.write(todos);
+  return { ok: true, value: toggled };
+}
+
+export function deleteTodo(request: { readonly id: string }): TodoOutcome<{ readonly id: string }> {
+  const todos = store.read();
+  if (!todos.some((todo) => todo.id === request.id)) return { ok: false, error: 'not-found' };
+  store.write(removeTodo(todos, request.id));
+  return { ok: true, value: { id: request.id } };
+}
diff --git a/showcase/todo-plain-03/api/src/features/todos/domain.test.ts b/showcase/todo-plain-03/api/src/features/todos/domain.test.ts
