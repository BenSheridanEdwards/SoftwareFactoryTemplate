@@ -0,0 +1,61 @@
+import type { AppRouter } from '@todo-03/api';
+import { type Operation, TRPCClientError, type TRPCLink } from '@trpc/client';
+import { observable } from '@trpc/server/observable';
+import type { RouterInputs, RouterOutputs } from './trpc';
+
+/** The input and output of each todo procedure, by its path. */
+interface TodoProcedures {
+  readonly 'todos.list': {
+    readonly input: undefined;
+    readonly output: RouterOutputs['todos']['list'];
+  };
+  readonly 'todos.create': {
+    readonly input: RouterInputs['todos']['create'];
+    readonly output: RouterOutputs['todos']['create'];
+  };
+  readonly 'todos.toggle': {
+    readonly input: RouterInputs['todos']['toggle'];
+    readonly output: RouterOutputs['todos']['toggle'];
+  };
+  readonly 'todos.delete': {
+    readonly input: RouterInputs['todos']['delete'];
+    readonly output: RouterOutputs['todos']['delete'];
+  };
+}
+
+/** A fake answer per procedure path, typed by the router. */
+export type TestApiHandlers = {
+  readonly [Path in keyof TodoProcedures]?: (
+    input: TodoProcedures[Path]['input'],
+  ) => TodoProcedures[Path]['output'] | Promise<TodoProcedures[Path]['output']>;
+};
+
+// A method signature compares its parameters bivariantly, so each typed handler
+// fits one table keyed by path; the link then receives the untyped input.
+type TodoOutput = TodoProcedures[keyof TodoProcedures]['output'];
+
+interface Answer {
+  answer(input: Operation['input']): TodoOutput | Promise<TodoOutput>;
+}
+
+/** A tRPC link that answers each call from `handlers` instead of the network. */
+export function handlerLink(handlers: TestApiHandlers): TRPCLink<AppRouter> {
+  const answers: Readonly<Record<string, Answer['answer'] | undefined>> = handlers;
+  return () =>
+    ({ op }) =>
+      observable((observer) => {
+        const respond = async () => {
+          const answer = answers[op.path];
+          if (answer === undefined) {
+            throw new Error(`TestApiProvider has no handler for ${op.path}`);
+          }
+          return answer(await op.input);
+        };
+        respond()
+          .then((data) => {
+            observer.next({ result: { type: 'data', data } });
+            return observer.complete();
+          })
+          .catch((cause: Error) => observer.error(TRPCClientError.from(cause)));
+      });
+}
diff --git a/showcase/todo-03/web/src/api-client/trpc.ts b/showcase/todo-03/web/src/api-client/trpc.ts
