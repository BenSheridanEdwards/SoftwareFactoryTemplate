@@ -0,0 +1,17 @@
+import { randomUUID } from 'node:crypto';
+import type { Todo } from './domain.ts';
+
+/** The todos of one api process, kept in memory in creation order. */
+export function createInMemoryTodos() {
+  const todos = new Map<string, Todo>();
+  return {
+    nextId: (): string => randomUUID(),
+    list: (): readonly Todo[] => [...todos.values()],
+    find: (id: string): Todo | undefined => todos.get(id),
+    save: (todo: Todo): Todo => {
+      todos.set(todo.id, todo);
+      return todo;
+    },
+    remove: (id: string): boolean => todos.delete(id),
+  };
+}
