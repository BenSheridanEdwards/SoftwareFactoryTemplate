@@ -0,0 +1,39 @@
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { type RouterInputs, type RouterOutputs, useTrpc } from '../../api-client';
+
+export type Todo = RouterOutputs['todos']['list'][number];
+export type CreateTodo = RouterInputs['todos']['create'];
+
+type TodosState =
+  | { readonly status: 'loading' }
+  | { readonly status: 'failed' }
+  | { readonly status: 'loaded'; readonly todos: readonly Todo[] };
+
+function toTodosState(query: {
+  readonly isError: boolean;
+  readonly data: readonly Todo[] | undefined;
+}): TodosState {
+  if (query.isError) return { status: 'failed' };
+  if (query.data === undefined) return { status: 'loading' };
+  return { status: 'loaded', todos: query.data };
+}
+
+/** The todo list and its mutations, all server state through the api. */
+export function useTodos() {
+  const trpc = useTrpc();
+  const queryClient = useQueryClient();
+  const list = useQuery(trpc.todos.list.queryOptions());
+  const refresh = () => queryClient.invalidateQueries({ queryKey: trpc.todos.list.queryKey() });
+  const create = useMutation(trpc.todos.create.mutationOptions({ onSuccess: refresh }));
+  const toggle = useMutation(trpc.todos.toggle.mutationOptions({ onSuccess: refresh }));
+  const remove = useMutation(trpc.todos.delete.mutationOptions({ onSuccess: refresh }));
+
+  return {
+    state: toTodosState(list),
+    creating: create.isPending,
+    actionFailed: [create, toggle, remove].some((mutation) => mutation.isError),
+    createTodo: create.mutate,
+    toggleTodo: (id: Todo['id']) => toggle.mutate({ id }),
+    deleteTodo: (id: Todo['id']) => remove.mutate({ id }),
+  };
+}
