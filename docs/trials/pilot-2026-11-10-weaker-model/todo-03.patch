@@ -0,0 +1,24 @@
+import { QueryClient } from '@tanstack/react-query';
+import type { AppRouter } from '@todo-03/api';
+import { createTRPCClient, httpBatchLink, type TRPCClient } from '@trpc/client';
+import type { inferRouterInputs, inferRouterOutputs } from '@trpc/server';
+import { createTRPCContext } from '@trpc/tanstack-react-query';
+
+export type RouterInputs = inferRouterInputs<AppRouter>;
+export type RouterOutputs = inferRouterOutputs<AppRouter>;
+
+/** The browser client posts every call to `/trpc` on the page's own origin. */
+export function createApiClient(url = '/trpc'): TRPCClient<AppRouter> {
+  return createTRPCClient<AppRouter>({ links: [httpBatchLink({ url })] });
+}
+
+// Named annotations keep declaration emit away from the api's source files.
+type ApiContext = ReturnType<typeof createTRPCContext<AppRouter>>;
+const apiContext: ApiContext = createTRPCContext<AppRouter>();
+export const TrpcProvider: ApiContext['TRPCProvider'] = apiContext.TRPCProvider;
+export const useTrpc: ApiContext['useTRPC'] = apiContext.useTRPC;
+
+/** A failed request fails at once; the user retries by submitting again. */
+export function createQueryClient(): QueryClient {
+  return new QueryClient({ defaultOptions: { queries: { retry: false } } });
+}
