+import type { QueryClient } from '@tanstack/react-query';
+import type { AppRouter } from '@todo-03/api';
+import { createTRPCClient, type TRPCClient } from '@trpc/client';
+import { useState } from 'react';
+import { handlerLink, type TestApiHandlers } from './testApiHandlers';
+import { createQueryClient } from './trpc';
+
+interface TestClients {
+  readonly queryClient: QueryClient;
+  readonly trpcClient: TRPCClient<AppRouter>;
+}
+
+/** Builds the clients once per render tree, so each test starts with an empty cache. */
+export function useTestApiClients(handlers: TestApiHandlers): TestClients {
+  const [clients] = useState<TestClients>(() => ({
+    queryClient: createQueryClient(),
+    trpcClient: createTRPCClient<AppRouter>({ links: [handlerLink(handlers)] }),
+  }));
+  return clients;
+}
