+beforeEach(() => jest.resetModules());
+
+it('starts empty and lists added todos in creation order', async () => {
+  const { addTodo, listTodos } = await import('./application.ts');
+  expect(listTodos()).toEqual([]);
+  addTodo({ title: 'First' });
+  addTodo({ title: 'Second' });
+  expect(listTodos().map(({ title }) => title)).toEqual(['First', 'Second']);
+});
+
+it('gives each added todo its own id and starts it incomplete', async () => {
+  const { addTodo } = await import('./application.ts');
+  const first = addTodo({ title: 'First' });
+  const second = addTodo({ title: 'Second' });
+  expect(first.id).not.toBe(second.id);
+  expect(first.completed).toBe(false);
+});
+
+it('flips a todo and returns undefined for an unknown id', async () => {
+  const { addTodo, flipTodo } = await import('./application.ts');
+  const { id } = addTodo({ title: 'Walk' });
+  expect(flipTodo(id)).toMatchObject({ id, completed: true });
+  expect(flipTodo('missing')).toBeUndefined();
+});
+
+it('removes a todo and returns its id, or undefined when it is gone', async () => {
+  const { addTodo, listTodos, removeTodo } = await import('./application.ts');
+  const { id } = addTodo({ title: 'Water' });
+  expect(removeTodo(id)).toBe(id);
+  expect(listTodos()).toEqual([]);
+  expect(removeTodo(id)).toBeUndefined();
+});
+
+it('keeps earlier snapshots unchanged when the list changes', async () => {
+  const { addTodo, listTodos } = await import('./application.ts');
+  addTodo({ title: 'First' });
+  const previous = listTodos();
+  addTodo({ title: 'Second' });
+  expect(previous).toHaveLength(1);
+});
diff --git a/showcase/todo-03/api/src/features/todos/application.ts b/showcase/todo-03/api/src/features/todos/application.ts
