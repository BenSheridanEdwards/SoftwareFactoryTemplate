+import { render, screen, waitFor } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { axe } from 'jest-axe';
+import { type TestApiHandlers, TestApiProvider } from '../../api-client';
+import { TodosPage } from './TodosPage';
+import type { Todo } from './useTodos';
+
+function renderPage(handlers: TestApiHandlers) {
+  const view = render(
+    <TestApiProvider handlers={handlers}>
+      <TodosPage />
+    </TestApiProvider>,
+  );
+  return { ...view, user: userEvent.setup() };
+}
+
+const milk: Todo = { id: '1', title: 'Buy milk', completed: false };
+
+it('lists the todos the api returns under the Todos heading', async () => {
+  renderPage({ 'todos.list': () => [milk] });
+
+  expect(screen.getByRole('heading', { level: 1, name: 'Todos' })).toBeInTheDocument();
+  expect(await screen.findByRole('checkbox', { name: 'Buy milk' })).not.toBeChecked();
+});
+
+it('adds a trimmed todo through the api and lists it', async () => {
+  const create = jest.fn(() => milk);
+  const list = jest.fn<Todo[], []>().mockReturnValueOnce([]).mockReturnValue([milk]);
+  const { user } = renderPage({ 'todos.list': list, 'todos.create': create });
+  await screen.findByText('No todos yet.');
+
+  await user.type(screen.getByRole('textbox', { name: 'Title' }), '  Buy milk ');
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+
+  expect(await screen.findByRole('checkbox', { name: 'Buy milk' })).toBeInTheDocument();
+  expect(create).toHaveBeenCalledWith({ title: 'Buy milk' });
+});
+
+it('toggles a todo through the api and shows the new state', async () => {
+  const toggle = jest.fn(({ id }: { id: string }) => ({ ...milk, id, completed: true }));
+  const list = jest
+    .fn<Todo[], []>()
+    .mockReturnValueOnce([milk])
+    .mockReturnValue([{ ...milk, completed: true }]);
+  const { user } = renderPage({ 'todos.list': list, 'todos.toggle': toggle });
+
+  await user.click(await screen.findByRole('checkbox', { name: 'Buy milk' }));
+
+  await waitFor(() => expect(screen.getByRole('checkbox', { name: 'Buy milk' })).toBeChecked());
+  expect(toggle).toHaveBeenCalledWith({ id: '1' });
+});
+
+it('deletes a todo through the api and removes it from the list', async () => {
+  const del = jest.fn(({ id }: { id: string }) => ({ id }));
+  const list = jest.fn<Todo[], []>().mockReturnValueOnce([milk]).mockReturnValue([]);
+  const { user } = renderPage({ 'todos.list': list, 'todos.delete': del });
+
+  await user.click(await screen.findByRole('button', { name: 'Delete Buy milk' }));
+
+  expect(await screen.findByText('No todos yet.')).toBeInTheDocument();
+  expect(del).toHaveBeenCalledWith({ id: '1' });
+});
+
+it('says so when the list cannot load', async () => {
+  renderPage({ 'todos.list': () => Promise.reject(new Error('api down')) });
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Could not load todos');
+});
+
+it('says so when a change cannot be saved', async () => {
+  const { user } = renderPage({
+    'todos.list': () => [milk],
+    'todos.toggle': () => Promise.reject(new Error('api down')),
+  });
+
+  await user.click(await screen.findByRole('checkbox', { name: 'Buy milk' }));
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Could not save that change');
+});
+
+it('has no axe-detectable violations with a todo listed', async () => {
+  const { container } = renderPage({ 'todos.list': () => [milk] });
+
+  await screen.findByRole('checkbox', { name: 'Buy milk' });
+
+  expect(await axe(container)).toHaveNoViolations();
+});
