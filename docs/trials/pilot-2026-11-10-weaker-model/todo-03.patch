@@ -0,0 +1,65 @@
+import { expect, type Page, test } from '@playwright/test';
+
+/**
+ * The todo behaviour, end to end: the page in Chromium, the Vite server's
+ * `/trpc` proxy and the real api process. Each test adds its own titles, since
+ * the tests share one api process.
+ */
+const todoItem = (page: Page, title: string) =>
+  page
+    .getByRole('listitem')
+    .filter({ has: page.getByRole('checkbox', { name: title, exact: true }) });
+
+async function addTodo(page: Page, title: string) {
+  await page.getByRole('textbox', { name: 'Title' }).fill(title);
+  await page.getByRole('button', { name: 'Add', exact: true }).click();
+  await expect(todoItem(page, title)).toBeVisible();
+}
+
+test.describe('Todos', () => {
+  test.beforeEach(async ({ page }) => {
+    await page.goto('/');
+  });
+
+  test('adds a todo that appears unchecked', async ({ page }) => {
+    const title = `Buy milk ${Date.now()}`;
+
+    await addTodo(page, title);
+
+    await expect(page.getByRole('checkbox', { name: title, exact: true })).not.toBeChecked();
+  });
+
+  test('asks for a title and sends nothing when the title is blank', async ({ page }) => {
+    const apiCalls: string[] = [];
+    page.on('request', (request) => {
+      if (new URL(request.url()).pathname.startsWith('/trpc')) {
+        apiCalls.push(request.url());
+      }
+    });
+
+    await page.getByRole('textbox', { name: 'Title' }).fill('   ');
+    await page.getByRole('button', { name: 'Add', exact: true }).click();
+
+    await expect(page.getByRole('alert')).toHaveText('Enter a title');
+    expect(apiCalls.filter((url) => url.includes('/trpc/todos.create'))).toEqual([]);
+  });
+
+  test('toggles and deletes a todo, and keeps the change across a reload', async ({ page }) => {
+    const kept = `Keep ${Date.now()}`;
+    const title = `Water plants ${Date.now()}`;
+    await addTodo(page, kept);
+    await addTodo(page, title);
+    const checkbox = page.getByRole('checkbox', { name: title, exact: true });
+
+    await checkbox.click();
+    await expect(checkbox).toBeChecked();
+    await page.reload();
+    await expect(page.getByRole('checkbox', { name: title, exact: true })).toBeChecked();
+
+    await page.getByRole('button', { name: `Delete ${title}` }).click();
+    await expect(todoItem(page, title)).toHaveCount(0);
+    await page.reload();
+    await expect(todoItem(page, kept)).toBeVisible();
+    await expect(todoItem(page, title)).toHaveCount(0);
+  });
+});
