+import { TodoForm } from './TodoForm';
+import { TodoList } from './TodoList';
+import { useTodos } from './useTodos';
+
+export function TodosPage() {
+  const { state, creating, actionFailed, createTodo, toggleTodo, deleteTodo } = useTodos();
+
+  return (
+    <main className="mx-auto flex max-w-160 flex-col gap-6 px-4 py-6 sm:py-12">
+      <h1 className="text-3xl font-bold tracking-tight">Todos</h1>
+      <TodoForm onCreate={createTodo} pending={creating} />
+      {actionFailed ? (
+        <p role="alert" className="text-danger">
+          Could not save that change
+        </p>
+      ) : null}
+      {state.status === 'loading' ? <output className="text-muted">Loading…</output> : null}
+      {state.status === 'failed' ? (
+        <p role="alert" className="text-danger">
+          Could not load todos
+        </p>
+      ) : null}
+      {state.status === 'loaded' ? (
+        <TodoList todos={state.todos} onToggle={toggleTodo} onDelete={deleteTodo} />
+      ) : null}
+    </main>
+  );
+}
