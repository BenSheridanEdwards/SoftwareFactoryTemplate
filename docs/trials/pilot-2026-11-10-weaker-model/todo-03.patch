@@ -0,0 +1,27 @@
+import { createTodo, type Todo, toggleTodo } from './domain.ts';
+import { createInMemoryTodos } from './integrations.ts';
+
+const store = createInMemoryTodos();
+
+export interface AddTodoRequest {
+  readonly title: string;
+}
+
+export function listTodos(): readonly Todo[] {
+  return store.list();
+}
+
+export function addTodo(request: AddTodoRequest): Todo {
+  return store.save(createTodo(store.nextId(), request.title));
+}
+
+/** The todo with its completion inverted, or undefined when no todo has the id. */
+export function flipTodo(id: string): Todo | undefined {
+  const todo = store.find(id);
+  return todo === undefined ? undefined : store.save(toggleTodo(todo));
+}
+
+/** The removed id, or undefined when no todo has the id. */
+export function removeTodo(id: string): string | undefined {
+  return store.remove(id) ? id : undefined;
+}
