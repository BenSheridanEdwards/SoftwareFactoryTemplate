@@ -0,0 +1,28 @@
+import { newTodo, type Todo, toggleCompleted } from './domain.ts';
+import { createInMemoryTodos } from './integrations.ts';
+
+const store = createInMemoryTodos();
+
+export function listTodos(): readonly Todo[] {
+  return store.list();
+}
+
+export function addTodo(request: { readonly title: string }): Todo {
+  const todo = newTodo(store.newId(), request.title);
+  store.save(todo);
+  return todo;
+}
+
+/** The toggled todo, or undefined when no todo has the id. */
+export function toggleTodo(id: string): Todo | undefined {
+  const current = store.find(id);
+  if (!current) return undefined;
+  const toggled = toggleCompleted(current);
+  store.save(toggled);
+  return toggled;
+}
+
+/** Whether a todo with the id existed and was removed. */
+export function deleteTodo(id: string): boolean {
+  return store.remove(id);
+}
