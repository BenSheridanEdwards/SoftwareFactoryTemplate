@@ -0,0 +1,27 @@
+import { randomUUID } from 'node:crypto';
+import type { Todo } from './domain.ts';
+
+interface TodosState {
+  todos: readonly Todo[];
+}
+
+export function createInMemoryTodos() {
+  const state: TodosState = { todos: [] };
+  return {
+    newId: (): string => randomUUID(),
+    list: (): readonly Todo[] => [...state.todos],
+    find: (id: string): Todo | undefined => state.todos.find((todo) => todo.id === id),
+    save: (todo: Todo): void => {
+      const exists = state.todos.some((stored) => stored.id === todo.id);
+      state.todos = exists
+        ? state.todos.map((stored) => (stored.id === todo.id ? todo : stored))
+        : [...state.todos, todo];
+    },
+    remove: (id: string): boolean => {
+      const kept = state.todos.filter((todo) => todo.id !== id);
+      const removed = kept.length !== state.todos.length;
+      state.todos = kept;
+      return removed;
+    },
+  };
+}
