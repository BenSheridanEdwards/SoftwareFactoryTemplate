+import { expect, type Page, test } from './fixtures';
+
+/**
+ * The todo behaviour, end to end: the page in Chromium, the Vite server's
+ * `/trpc` proxy, and the real api process.
+ */
+async function addTodo(page: Page, title: string) {
+  await page.goto('/');
+  await page.getByRole('textbox', { name: 'Title' }).fill(title);
+  await page.getByRole('button', { name: 'Add', exact: true }).click();
+  await expect(page.getByRole('checkbox', { name: title, exact: true })).toBeVisible();
+}
+
+test.describe('Todos', () => {
+  test('adds a todo that starts unchecked and survives a reload', async ({ page }) => {
+    await addTodo(page, 'Buy milk');
+
+    await page.reload();
+
+    await expect(page.getByRole('checkbox', { name: 'Buy milk', exact: true })).not.toBeChecked();
+  });
+
+  test('asks for a title and sends nothing when the title is blank', async ({ page }) => {
+    await page.goto('/');
+    await page.getByRole('textbox', { name: 'Title' }).fill('   ');
+    await page.getByRole('button', { name: 'Add', exact: true }).click();
+
+    await expect(page.getByRole('alert')).toHaveText('Enter a title');
+    await expect(page.getByRole('list', { name: 'Todos' }).getByRole('listitem')).toHaveCount(0);
+  });
+
+  test('toggles and deletes a todo through the api', async ({ page }) => {
+    await addTodo(page, 'Water the plants');
+    const checkbox = page.getByRole('checkbox', { name: 'Water the plants', exact: true });
+
+    await checkbox.click();
+    await expect(checkbox).toBeChecked();
+
+    await page.getByRole('button', { name: 'Delete Water the plants', exact: true }).click();
+    await expect(checkbox).toHaveCount(0);
+  });
+});
