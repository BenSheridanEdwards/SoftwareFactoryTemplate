+import { render, screen, waitFor } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { axe } from 'jest-axe';
+import { type TestApiHandlers, TestApiProvider } from '../../api-client';
+import { TodosPage } from './TodosPage';
+import type { Todo } from './useTodos';
+
+const milk: Todo = { id: '1', title: 'Buy milk', completed: false };
+const doneMilk: Todo = { ...milk, completed: true };
+
+function renderPage(handlers: TestApiHandlers) {
+  const view = render(
+    <TestApiProvider handlers={handlers}>
+      <TodosPage />
+    </TestApiProvider>,
+  );
+  return { ...view, user: userEvent.setup() };
+}
+
+it('lists each todo with a checkbox named by its title and a delete button', async () => {
+  renderPage({ 'todos.list': () => [milk] });
+
+  expect(await screen.findByRole('checkbox', { name: 'Buy milk' })).not.toBeChecked();
+  expect(screen.getByRole('button', { name: 'Delete Buy milk' })).toBeInTheDocument();
+});
+
+it('adds a trimmed title through the api and lists the new todo', async () => {
+  const created: Todo = { id: '2', title: 'Walk the dog', completed: false };
+  const create = jest.fn(() => created);
+  const list = jest.fn<Todo[], []>().mockReturnValueOnce([]).mockReturnValue([created]);
+  const { user } = renderPage({ 'todos.list': list, 'todos.create': create });
+
+  await user.type(await screen.findByRole('textbox', { name: 'Title' }), '  Walk the dog ');
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+
+  expect(await screen.findByRole('checkbox', { name: 'Walk the dog' })).toBeInTheDocument();
+  expect(create).toHaveBeenCalledWith({ title: 'Walk the dog' });
+  expect(screen.getByRole('textbox', { name: 'Title' })).toHaveValue('');
+});
+
+it.each(['', '   '])('adds nothing and shows an alert for the title %j', async (title) => {
+  const create = jest.fn(() => milk);
+  const { user } = renderPage({ 'todos.list': () => [], 'todos.create': create });
+
+  const field = await screen.findByRole('textbox', { name: 'Title' });
+  if (title) {
+    await user.type(field, title);
+  }
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Enter a title');
+  expect(create).not.toHaveBeenCalled();
+});
+
+it('toggles a todo through the api and shows its new state', async () => {
+  const toggle = jest.fn(() => doneMilk);
+  const list = jest.fn<Todo[], []>().mockReturnValueOnce([milk]).mockReturnValue([doneMilk]);
+  const { user } = renderPage({ 'todos.list': list, 'todos.toggle': toggle });
+
+  await user.click(await screen.findByRole('checkbox', { name: 'Buy milk' }));
+
+  expect(toggle).toHaveBeenCalledWith({ id: '1' });
+  await waitFor(() => expect(screen.getByRole('checkbox', { name: 'Buy milk' })).toBeChecked());
+});
+
+it('deletes a todo through the api and removes it from the list', async () => {
+  const remove = jest.fn(({ id }: { id: string }) => ({ id }));
+  const list = jest.fn<Todo[], []>().mockReturnValueOnce([milk]).mockReturnValue([]);
+  const { user } = renderPage({ 'todos.list': list, 'todos.delete': remove });
+
+  await user.click(await screen.findByRole('button', { name: 'Delete Buy milk' }));
+
+  expect(remove).toHaveBeenCalledWith({ id: '1' });
+  await waitFor(() =>
+    expect(screen.queryByRole('checkbox', { name: 'Buy milk' })).not.toBeInTheDocument(),
+  );
+});
+
+it('says so when the api fails', async () => {
+  renderPage({ 'todos.list': () => Promise.reject(new Error('api down')) });
+
+  expect(await screen.findByRole('alert')).toHaveTextContent(
+    'Something went wrong with your todos',
+  );
+});
+
+it('has no axe-detectable violations with a todo listed', async () => {
+  const { container } = renderPage({ 'todos.list': () => [milk] });
+
+  await screen.findByRole('checkbox', { name: 'Buy milk' });
+
+  expect(await axe(container)).toHaveNoViolations();
+});
