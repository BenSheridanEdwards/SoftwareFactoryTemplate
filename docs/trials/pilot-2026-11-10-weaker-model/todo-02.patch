+beforeEach(() => jest.resetModules());
+
+it('starts empty, adds todos in order and lists them', async () => {
+  const { addTodo, listTodos } = await import('./application.ts');
+  expect(listTodos()).toEqual([]);
+  const first = addTodo({ title: 'Buy milk' });
+  const second = addTodo({ title: 'Walk the dog' });
+  expect(first).toEqual({ id: expect.any(String), title: 'Buy milk', completed: false });
+  expect(listTodos()).toEqual([first, second]);
+});
+
+it('gives each todo its own id', async () => {
+  const { addTodo } = await import('./application.ts');
+  expect(addTodo({ title: 'Same' }).id).not.toBe(addTodo({ title: 'Same' }).id);
+});
+
+it('toggles a todo and returns the updated todo', async () => {
+  const { addTodo, listTodos, toggleTodo } = await import('./application.ts');
+  const todo = addTodo({ title: 'Buy milk' });
+  expect(toggleTodo(todo.id)).toEqual({ ...todo, completed: true });
+  expect(listTodos()).toEqual([{ ...todo, completed: true }]);
+});
+
+it('returns undefined when toggling an unknown id', async () => {
+  const { toggleTodo } = await import('./application.ts');
+  expect(toggleTodo('missing')).toBeUndefined();
+});
+
+it('deletes a todo once and reports a missing one', async () => {
+  const { addTodo, deleteTodo, listTodos } = await import('./application.ts');
+  const todo = addTodo({ title: 'Buy milk' });
+  expect(deleteTodo(todo.id)).toBe(true);
+  expect(listTodos()).toEqual([]);
+  expect(deleteTodo(todo.id)).toBe(false);
+});
+
+it('keeps previous snapshots unchanged after a toggle', async () => {
+  const { addTodo, listTodos, toggleTodo } = await import('./application.ts');
+  const todo = addTodo({ title: 'Buy milk' });
+  const previous = listTodos();
+  toggleTodo(todo.id);
+  expect(previous).toEqual([todo]);
+});
diff --git a/showcase/todo-02/api/src/features/todos/application.ts b/showcase/todo-02/api/src/features/todos/application.ts
new file mode 100644
index 0000000..87d27ef
