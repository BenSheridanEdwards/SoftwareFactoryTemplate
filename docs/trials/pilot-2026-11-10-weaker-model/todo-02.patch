@@ -0,0 +1,44 @@
+import { TRPCError } from '@trpc/server';
+import { Schema } from 'effect';
+import { procedure, router } from '../../trpc.ts';
+import { addTodo, deleteTodo, listTodos, toggleTodo } from './application.ts';
+
+const todoSchema = Schema.Struct({
+  id: Schema.String,
+  title: Schema.String,
+  completed: Schema.Boolean,
+});
+
+const createInputSchema = Schema.Struct({ title: Schema.Trim.check(Schema.isNonEmpty()) });
+const idInputSchema = Schema.Struct({ id: Schema.String });
+const deletedSchema = Schema.Struct({ id: Schema.String });
+
+function notFound(id: string): TRPCError {
+  return new TRPCError({ code: 'NOT_FOUND', message: `No todo with id ${id}` });
+}
+
+export const todosRouter = router({
+  list: procedure
+    .input(Schema.toStandardSchemaV1(Schema.Undefined))
+    .output(Schema.toStandardSchemaV1(Schema.Array(todoSchema)))
+    .query(() => listTodos()),
+  create: procedure
+    .input(Schema.toStandardSchemaV1(createInputSchema))
+    .output(Schema.toStandardSchemaV1(todoSchema))
+    .mutation(({ input }) => addTodo(input)),
+  toggle: procedure
+    .input(Schema.toStandardSchemaV1(idInputSchema))
+    .output(Schema.toStandardSchemaV1(todoSchema))
+    .mutation(({ input }) => {
+      const todo = toggleTodo(input.id);
+      if (!todo) throw notFound(input.id);
+      return todo;
+    }),
+  delete: procedure
+    .input(Schema.toStandardSchemaV1(idInputSchema))
+    .output(Schema.toStandardSchemaV1(deletedSchema))
+    .mutation(({ input }) => {
+      if (!deleteTodo(input.id)) throw notFound(input.id);
+      return { id: input.id };
+    }),
+});
