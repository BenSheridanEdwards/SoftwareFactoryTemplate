+import { test as base, type ConsoleMessage, expect } from '@playwright/test';
+
+export { expect, type Page } from '@playwright/test';
+
+/** Fails a test that logs a console warning or error, or throws, unless a pattern expects it. */
+export const test = base.extend<{ expectedConsole: RegExp[] }>({
+  expectedConsole: [[], { option: true }],
+  page: async ({ page, expectedConsole }, use) => {
+    const messages: string[] = [];
+    const recordConsole = (message: ConsoleMessage) => {
+      if (message.type() === 'warning' || message.type() === 'error') {
+        messages.push(`console.${message.type()}: ${message.text()}`);
+      }
+    };
+    const recordError = (error: Error) => {
+      messages.push(`pageerror: ${error.message}`);
+    };
+    page.on('console', recordConsole);
+    page.on('pageerror', recordError);
+    await use(page);
+    page.off('console', recordConsole);
+    page.off('pageerror', recordError);
+    expect(
+      messages.filter((message) => !expectedConsole.some((pattern) => pattern.test(message))),
+    ).toEqual([]);
+  },
+});
