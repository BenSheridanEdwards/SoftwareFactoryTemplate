index 0000000..3e1fd66
--- /dev/null
+++ b/showcase/todo-plain-02/web/src/routes/todos/TodosPage.test.tsx
@@ -0,0 +1,131 @@
+import { render, screen, waitFor } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { axe } from 'jest-axe';
+import { type TestApiHandlers, TestApiProvider } from '../../api-client';
+import { TodosPage } from './TodosPage';
+
+interface Todo {
+  readonly id: string;
+  readonly title: string;
+  readonly completed: boolean;
+}
+
+/** An in-memory stand-in for the todo api, so each test can read what the page sent. */
+function fakeTodoApi(initial: readonly Todo[] = []): Required<TestApiHandlers> {
+  const state = { todos: [...initial], nextId: 1 };
+  return {
+    'todos.list': () => state.todos,
+    'todos.create': ({ title }) => {
+      const todo = { id: `todo-${state.nextId++}`, title, completed: false };
+      state.todos = [...state.todos, todo];
+      return todo;
+    },
+    'todos.toggle': ({ id }) => {
+      const current = state.todos.find((todo) => todo.id === id);
+      if (!current) throw new Error(`no todo ${id}`);
+      const updated = { ...current, completed: !current.completed };
+      state.todos = state.todos.map((todo) => (todo.id === id ? updated : todo));
+      return updated;
+    },
+    'todos.delete': ({ id }) => {
+      state.todos = state.todos.filter((todo) => todo.id !== id);
+      return { id };
+    },
+  };
+}
+
+function renderPage(handlers: TestApiHandlers) {
+  const view = render(
+    <TestApiProvider handlers={handlers}>
+      <TodosPage />
+    </TestApiProvider>,
+  );
+  return { ...view, user: userEvent.setup() };
+}
+
+const buyMilk = { id: 'todo-0', title: 'Buy milk', completed: false };
+
+it('lists the todos the api returns', async () => {
+  renderPage(fakeTodoApi([buyMilk]));
+
+  expect(await screen.findByRole('checkbox', { name: 'Buy milk' })).not.toBeChecked();
+});
+
+it('says there are no todos while the list is empty', async () => {
+  renderPage(fakeTodoApi());
+
+  expect(await screen.findByText('No todos yet.')).toBeInTheDocument();
+});
+
+it('adds a todo from the title field and clears the field', async () => {
+  const { user } = renderPage(fakeTodoApi());
+  await screen.findByText('No todos yet.');
+
+  await user.type(screen.getByRole('textbox', { name: 'Title' }), 'Walk the dog');
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+
+  expect(await screen.findByRole('checkbox', { name: 'Walk the dog' })).not.toBeChecked();
+  expect(screen.getByRole('textbox', { name: 'Title' })).toHaveValue('');
+});
+
+it('adds nothing and shows an alert for a blank title', async () => {
+  const api = fakeTodoApi();
+  const create = jest.fn(api['todos.create']);
+  const { user } = renderPage({ ...api, 'todos.create': create });
+  await screen.findByText('No todos yet.');
+
+  await user.type(screen.getByRole('textbox', { name: 'Title' }), '   ');
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Enter a title');
+  expect(create).not.toHaveBeenCalled();
+});
+
+it('toggles a todo through the api', async () => {
+  const api = fakeTodoApi([buyMilk]);
+  const toggle = jest.fn(api['todos.toggle']);
+  const { user } = renderPage({ ...api, 'todos.toggle': toggle });
+  const checkbox = await screen.findByRole('checkbox', { name: 'Buy milk' });
+
+  await user.click(checkbox);
+
+  await waitFor(() => expect(checkbox).toBeChecked());
+  expect(toggle).toHaveBeenCalledWith({ id: 'todo-0' });
+});
+
+it('deletes a todo through the api', async () => {
+  const { user } = renderPage(fakeTodoApi([buyMilk]));
+  await screen.findByRole('checkbox', { name: 'Buy milk' });
+
+  await user.click(screen.getByRole('button', { name: 'Delete Buy milk' }));
+
+  await waitFor(() =>
+    expect(screen.queryByRole('checkbox', { name: 'Buy milk' })).not.toBeInTheDocument(),
+  );
+});
+
+it('says so when the list cannot load', async () => {
+  renderPage({ 'todos.list': () => Promise.reject(new Error('api down')) });
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Could not load the todos');
+});
+
+it('says so when a new todo cannot be added', async () => {
+  const { user } = renderPage({
+    ...fakeTodoApi(),
+    'todos.create': () => Promise.reject(new Error('api down')),
+  });
+  await screen.findByText('No todos yet.');
+
+  await user.type(screen.getByRole('textbox', { name: 'Title' }), 'Walk the dog');
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Could not add the todo');
+});
+
+it('has no accessibility violations with a todo listed', async () => {
+  const { container } = renderPage(fakeTodoApi([buyMilk]));
+  await screen.findByRole('checkbox', { name: 'Buy milk' });
+
+  expect(await axe(container)).toHaveNoViolations();
+});
