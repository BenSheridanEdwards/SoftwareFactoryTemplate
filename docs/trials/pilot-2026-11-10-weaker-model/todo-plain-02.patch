@@ -0,0 +1,39 @@
+import { createTodo, deleteTodo, listTodos, toggleTodo } from './application.ts';
+
+it('lists a created todo as not complete', () => {
+  const created = createTodo({ title: 'Buy milk' });
+
+  expect(created).toEqual({ id: expect.any(String), title: 'Buy milk', completed: false });
+  expect(listTodos()).toContainEqual(created);
+});
+
+it('gives each created todo its own id', () => {
+  const first = createTodo({ title: 'First' });
+  const second = createTodo({ title: 'Second' });
+
+  expect(first.id).not.toBe(second.id);
+});
+
+it('toggles a todo and returns the updated todo', () => {
+  const created = createTodo({ title: 'Walk the dog' });
+
+  const toggled = toggleTodo(created.id);
+
+  expect(toggled).toEqual({ ...created, completed: true });
+  expect(listTodos()).toContainEqual({ ...created, completed: true });
+});
+
+it('returns undefined when toggling an unknown id', () => {
+  expect(toggleTodo('missing')).toBeUndefined();
+});
+
+it('deletes a todo and reports true', () => {
+  const created = createTodo({ title: 'Water the plants' });
+
+  expect(deleteTodo(created.id)).toBe(true);
+  expect(listTodos()).not.toContainEqual(created);
+});
+
+it('reports false when deleting an unknown id', () => {
+  expect(deleteTodo('missing')).toBe(false);
+});
diff --git a/showcase/todo-plain-02/api/src/features/todos/application.ts b/showcase/todo-plain-02/api/src/features/todos/application.ts
new file mode 100644
index 0000000..0f2a22d
--- /dev/null
+++ b/showcase/todo-plain-02/api/src/features/todos/application.ts
@@ -0,0 +1,32 @@
+import { newTodo, type Todo, toggled } from './domain.ts';
+import { createInMemoryTodos, newId } from './integrations.ts';
+
+const store = createInMemoryTodos();
+
+export function listTodos(): readonly Todo[] {
+  return store.read();
+}
+
+export function createTodo(request: { readonly title: string }): Todo {
+  const todo = newTodo(newId(), request.title);
+  store.write([...store.read(), todo]);
+  return todo;
+}
+
+/** The toggled todo, or undefined when no todo has the id. */
+export function toggleTodo(id: string): Todo | undefined {
+  const current = store.read().find((todo) => todo.id === id);
+  if (!current) return undefined;
+  const next = toggled(current);
+  store.write(store.read().map((todo) => (todo.id === id ? next : todo)));
+  return next;
+}
+
+/** False when no todo has the id. */
+export function deleteTodo(id: string): boolean {
+  const todos = store.read();
+  const remaining = todos.filter((todo) => todo.id !== id);
+  if (remaining.length === todos.length) return false;
+  store.write(remaining);
+  return true;
+}
