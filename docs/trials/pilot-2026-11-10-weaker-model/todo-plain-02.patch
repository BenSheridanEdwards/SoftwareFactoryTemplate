--- /dev/null
+++ b/showcase/todo-plain-02/api/src/features/todos/procedures.test.ts
@@ -0,0 +1,66 @@
+import { TRPCError } from '@trpc/server';
+import { createCallerFactory } from '../../trpc.ts';
+import { todosRouter } from './procedures.ts';
+
+const caller = createCallerFactory(todosRouter)({});
+
+it('lists the todos as an array', async () => {
+  await expect(caller.list()).resolves.toEqual(expect.any(Array));
+});
+
+it('trims the title and creates an incomplete todo', async () => {
+  await expect(caller.create({ title: '  Buy milk ' })).resolves.toEqual({
+    id: expect.any(String),
+    title: 'Buy milk',
+    completed: false,
+  });
+});
+
+it.each(['', '   '])('rejects the blank title %j as a bad request', async (title) => {
+  await expect(caller.create({ title })).rejects.toMatchObject({
+    constructor: TRPCError,
+    code: 'BAD_REQUEST',
+  });
+});
+
+it('rejects a create input that is not a string title', async () => {
+  await expect(caller.create({ title: 42 as unknown as string })).rejects.toMatchObject({
+    code: 'BAD_REQUEST',
+  });
+});
+
+it('toggles a todo back and forth', async () => {
+  const created = await caller.create({ title: 'Read a book' });
+
+  await expect(caller.toggle({ id: created.id })).resolves.toEqual({
+    ...created,
+    completed: true,
+  });
+  await expect(caller.toggle({ id: created.id })).resolves.toEqual(created);
+});
+
+it('rejects a toggle of an unknown id as not found', async () => {
+  await expect(caller.toggle({ id: 'missing' })).rejects.toMatchObject({
+    constructor: TRPCError,
+    code: 'NOT_FOUND',
+  });
+});
+
+it('deletes a todo and returns its id', async () => {
+  const created = await caller.create({ title: 'Water the plants' });
+
+  await expect(caller.delete({ id: created.id })).resolves.toEqual({ id: created.id });
+});
+
+it('rejects a delete of an unknown id as not found', async () => {
+  await expect(caller.delete({ id: 'missing' })).rejects.toMatchObject({ code: 'NOT_FOUND' });
+});
+
+it.each([{}, { id: 42 }])('rejects a malformed toggle or delete input %j', async (input) => {
+  await expect(caller.toggle(input as unknown as { id: string })).rejects.toMatchObject({
+    code: 'BAD_REQUEST',
+  });
+  await expect(caller.delete(input as unknown as { id: string })).rejects.toMatchObject({
+    code: 'BAD_REQUEST',
+  });
+});
diff --git a/showcase/todo-plain-02/api/src/features/todos/procedures.ts b/showcase/todo-plain-02/api/src/features/todos/procedures.ts
new file mode 100644
index 0000000..a25f3b4
--- /dev/null
+++ b/showcase/todo-plain-02/api/src/features/todos/procedures.ts
@@ -0,0 +1,27 @@
+import { TRPCError } from '@trpc/server';
+import { Schema } from 'effect';
+import { procedure, router } from '../../trpc.ts';
+import { createTodo, deleteTodo, listTodos, toggleTodo } from './application.ts';
+
+const createInputSchema = Schema.Struct({ title: Schema.Trim.check(Schema.isNonEmpty()) });
+const idInputSchema = Schema.Struct({ id: Schema.String });
+
+function notFound(id: string): TRPCError {
+  return new TRPCError({ code: 'NOT_FOUND', message: `No todo with id ${id}` });
+}
+
+export const todosRouter = router({
+  list: procedure.query(() => listTodos()),
+  create: procedure
+    .input(Schema.toStandardSchemaV1(createInputSchema))
+    .mutation(({ input }) => createTodo(input)),
+  toggle: procedure.input(Schema.toStandardSchemaV1(idInputSchema)).mutation(({ input }) => {
+    const todo = toggleTodo(input.id);
+    if (!todo) throw notFound(input.id);
+    return todo;
+  }),
+  delete: procedure.input(Schema.toStandardSchemaV1(idInputSchema)).mutation(({ input }) => {
+    if (!deleteTodo(input.id)) throw notFound(input.id);
+    return { id: input.id };
+  }),
+});
