+        <TodoItem key={todo.id} todo={todo} onToggle={onToggle} onDelete={onDelete} />
+      ))}
+    </ul>
+  );
+}
diff --git a/showcase/todo-plain-02/web/src/routes/todos/TodosPage.test.tsx b/showcase/todo-plain-02/web/src/routes/todos/TodosPage.test.tsx
