@@ -0,0 +1,21 @@
+import { randomUUID } from 'node:crypto';
+import type { Todo } from './domain.ts';
+
+interface TodoState {
+  todos: readonly Todo[];
+}
+
+export function newId(): string {
+  return randomUUID();
+}
+
+/** Todos live in the api process only; a restart empties the list. */
+export function createInMemoryTodos() {
+  const state: TodoState = { todos: [] };
+  return {
+    read: (): readonly Todo[] => state.todos,
+    write: (todos: readonly Todo[]): void => {
+      state.todos = todos;
+    },
+  };
+}
diff --git a/showcase/todo-plain-02/api/src/features/todos/procedures.test.ts b/showcase/todo-plain-02/api/src/features/todos/procedures.test.ts
new file mode 100644
