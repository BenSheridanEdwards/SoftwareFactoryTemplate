@@ -0,0 +1,32 @@
+import { newTodo, type Todo, toggleTodo } from './domain.ts';
+import { createTodoStore } from './integrations.ts';
+
+const store = createTodoStore();
+
+export interface CreateTodoRequest {
+  readonly title: string;
+}
+
+export function listTodos(): readonly Todo[] {
+  return store.list();
+}
+
+export function createTodo(request: CreateTodoRequest): Todo {
+  const todo = newTodo(store.nextId(), request.title);
+  store.save(todo);
+  return todo;
+}
+
+/** Returns the toggled todo, or undefined when no todo has the id. */
+export function toggleTodoById(id: string): Todo | undefined {
+  const todo = store.find(id);
+  if (todo === undefined) return undefined;
+  const toggled = toggleTodo(todo);
+  store.save(toggled);
+  return toggled;
+}
+
+/** Returns false when no todo has the id. */
+export function deleteTodo(id: string): boolean {
+  return store.remove(id);
+}
