@@ -0,0 +1,36 @@
+import { randomUUID } from 'node:crypto';
+import type { Todo } from './domain.ts';
+
+export interface TodoStore {
+  readonly nextId: () => string;
+  readonly list: () => readonly Todo[];
+  readonly find: (id: string) => Todo | undefined;
+  readonly save: (todo: Todo) => void;
+  readonly remove: (id: string) => boolean;
+}
+
+interface TodoState {
+  todos: readonly Todo[];
+}
+
+/** The todos live in this process's memory and are lost when it stops. */
+export function createTodoStore(): TodoStore {
+  const state: TodoState = { todos: [] };
+  return {
+    nextId: () => randomUUID(),
+    list: () => [...state.todos],
+    find: (id) => state.todos.find((todo) => todo.id === id),
+    save: (todo) => {
+      const exists = state.todos.some((existing) => existing.id === todo.id);
+      state.todos = exists
+        ? state.todos.map((existing) => (existing.id === todo.id ? todo : existing))
+        : [...state.todos, todo];
+    },
+    remove: (id) => {
+      const remaining = state.todos.filter((todo) => todo.id !== id);
+      const removed = remaining.length !== state.todos.length;
+      state.todos = remaining;
+      return removed;
+    },
+  };
+}
