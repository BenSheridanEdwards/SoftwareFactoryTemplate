+import { TodoForm } from './TodoForm';
+import { TodoList } from './TodoList';
+import { useTodos } from './useTodos';
+
+export function TodosPage() {
+  const { state, creating, saveFailed, createTodo, toggleTodo, deleteTodo } = useTodos();
+
+  return (
+    <main className="mx-auto flex max-w-160 flex-col gap-6 px-4 py-6 sm:py-12">
+      <h1 className="text-3xl font-bold tracking-tight">Todos</h1>
+      <section className="flex flex-col gap-4 rounded-xl border border-line bg-surface p-6">
+        <TodoForm onCreate={createTodo} pending={creating} />
