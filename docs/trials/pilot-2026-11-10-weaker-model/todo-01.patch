@@ -0,0 +1,123 @@
+import { render, screen, waitFor, within } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { axe } from 'jest-axe';
+import { type TestApiHandlers, TestApiProvider } from '../../api-client';
+import { TodosPage } from './TodosPage';
+import type { Todo } from './useTodos';
+
+/** An in-memory api for the page: each procedure answers from the same list. */
+function fakeApi(initial: readonly Todo[] = []): TestApiHandlers {
+  const todos = [...initial];
+  const find = (id: string) => todos.find((todo) => todo.id === id);
+  return {
+    'todos.list': () => [...todos],
+    'todos.create': ({ title }) => {
+      const todo = { id: `id-${todos.length + 1}`, title, completed: false };
+      todos.push(todo);
+      return todo;
+    },
+    'todos.toggle': ({ id }) => {
+      const todo = find(id);
+      if (!todo) throw new Error(`no todo ${id}`);
+      const toggled = { ...todo, completed: !todo.completed };
+      todos.splice(todos.indexOf(todo), 1, toggled);
+      return toggled;
+    },
+    'todos.delete': ({ id }) => {
+      todos.splice(
+        todos.findIndex((todo) => todo.id === id),
+        1,
+      );
+      return { id };
+    },
+  };
+}
+
+function renderPage(handlers: TestApiHandlers) {
+  const view = render(
+    <TestApiProvider handlers={handlers}>
+      <TodosPage />
+    </TestApiProvider>,
+  );
+  return { ...view, user: userEvent.setup() };
+}
+
+async function addTitle(user: ReturnType<typeof userEvent.setup>, title: string) {
+  const field = screen.getByRole('textbox', { name: 'Title' });
+  await user.clear(field);
+  if (title) {
+    await user.type(field, title);
+  }
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+}
+
+it('shows the heading and the todos from the api', async () => {
+  renderPage(fakeApi([{ id: '1', title: 'Buy milk', completed: true }]));
+
+  expect(screen.getByRole('heading', { level: 1, name: 'Todos' })).toBeInTheDocument();
+  const list = await screen.findByRole('list', { name: 'Todos' });
+  expect(within(list).getByRole('checkbox', { name: 'Buy milk' })).toBeChecked();
+});
+
+it('adds a todo with its trimmed title and lists it', async () => {
+  const { user } = renderPage(fakeApi());
+
+  await addTitle(user, '  Walk the dog  ');
+
+  expect(await screen.findByRole('checkbox', { name: 'Walk the dog' })).not.toBeChecked();
+  expect(screen.getByRole('textbox', { name: 'Title' })).toHaveValue('');
+});
+
+it.each(['', '   '])('adds nothing and asks for a title when it is %j', async (title) => {
+  const create = jest.fn(() => ({ id: 'x', title: 'unused', completed: false }));
+  const { user } = renderPage({ ...fakeApi(), 'todos.create': create });
+
+  await addTitle(user, title);
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Enter a title');
+  expect(create).not.toHaveBeenCalled();
+});
+
+it('toggles a todo complete and back', async () => {
+  const { user } = renderPage(fakeApi([{ id: '1', title: 'Walk the dog', completed: false }]));
+  const checkbox = await screen.findByRole('checkbox', { name: 'Walk the dog' });
+
+  await user.click(checkbox);
+  await waitFor(() => expect(checkbox).toBeChecked());
+  await user.click(checkbox);
+  await waitFor(() => expect(checkbox).not.toBeChecked());
+});
+
+it('deletes a todo from the list', async () => {
+  const { user } = renderPage(fakeApi([{ id: '1', title: 'Water the plants', completed: false }]));
+
+  await user.click(await screen.findByRole('button', { name: 'Delete Water the plants' }));
+
+  await waitFor(() =>
+    expect(screen.queryByRole('checkbox', { name: 'Water the plants' })).not.toBeInTheDocument(),
+  );
+});
+
+it('says so when the list cannot load', async () => {
+  renderPage({ 'todos.list': () => Promise.reject(new Error('api down')) });
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Could not load todos');
+});
+
+it('says so when a change fails', async () => {
+  const { user } = renderPage({
+    ...fakeApi(),
+    'todos.create': () => Promise.reject(new Error('api down')),
+  });
+
+  await addTitle(user, 'Buy milk');
+
+  expect(await screen.findByText('Could not save the change')).toBeInTheDocument();
+});
+
+it('has no axe-detectable violations with a todo listed', async () => {
+  const { container } = renderPage(fakeApi([{ id: '1', title: 'Read', completed: false }]));
+  await screen.findByRole('checkbox', { name: 'Read' });
+
+  expect(await axe(container)).toHaveNoViolations();
+});
