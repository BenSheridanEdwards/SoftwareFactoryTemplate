+import { newTodo, toggleTodo } from './domain.ts';
+
+it('starts a new todo incomplete', () => {
+  expect(newTodo('1', 'Buy milk')).toEqual({ id: '1', title: 'Buy milk', completed: false });
+});
+
+it('inverts completed on each toggle', () => {
+  const todo = newTodo('1', 'Buy milk');
+  const done = toggleTodo(todo);
+  expect(done).toEqual({ id: '1', title: 'Buy milk', completed: true });
+  expect(toggleTodo(done)).toEqual(todo);
+});
+
+it('leaves the toggled todo unchanged', () => {
+  const todo = newTodo('1', 'Buy milk');
+  toggleTodo(todo);
+  expect(todo.completed).toBe(false);
+});
