@@ -0,0 +1,46 @@
+beforeEach(() => jest.resetModules());
+
+it('starts empty, then lists the created todos in order', async () => {
+  const { createTodo, listTodos } = await import('./application.ts');
+  expect(listTodos()).toEqual([]);
+  const first = createTodo({ title: 'Buy milk' });
+  const second = createTodo({ title: 'Walk the dog' });
+  expect(listTodos()).toEqual([first, second]);
+  expect(first).toEqual({ id: expect.any(String), title: 'Buy milk', completed: false });
+});
+
+it('gives each todo its own id', async () => {
+  const { createTodo } = await import('./application.ts');
+  const first = createTodo({ title: 'Buy milk' });
+  const second = createTodo({ title: 'Buy milk' });
+  expect(first.id).not.toBe(second.id);
+});
+
+it('toggles a todo and returns it, and restores it on the second toggle', async () => {
+  const { createTodo, toggleTodoById, listTodos } = await import('./application.ts');
+  const created = createTodo({ title: 'Buy milk' });
+  expect(toggleTodoById(created.id)).toEqual({ ...created, completed: true });
+  expect(listTodos()).toEqual([{ ...created, completed: true }]);
+  expect(toggleTodoById(created.id)).toEqual(created);
+});
+
+it('keeps the list order when a todo is toggled', async () => {
+  const { createTodo, toggleTodoById, listTodos } = await import('./application.ts');
+  const first = createTodo({ title: 'Buy milk' });
+  const second = createTodo({ title: 'Walk the dog' });
+  toggleTodoById(first.id);
+  expect(listTodos().map(({ id }) => id)).toEqual([first.id, second.id]);
+});
+
+it('returns undefined when toggling an unknown id', async () => {
+  const { toggleTodoById } = await import('./application.ts');
+  expect(toggleTodoById('missing')).toBeUndefined();
+});
+
+it('deletes a todo and reports whether it existed', async () => {
+  const { createTodo, deleteTodo, listTodos } = await import('./application.ts');
+  const created = createTodo({ title: 'Buy milk' });
+  expect(deleteTodo(created.id)).toBe(true);
+  expect(listTodos()).toEqual([]);
+  expect(deleteTodo(created.id)).toBe(false);
+});
diff --git a/showcase/todo-01/api/src/features/todos/application.ts b/showcase/todo-01/api/src/features/todos/application.ts
