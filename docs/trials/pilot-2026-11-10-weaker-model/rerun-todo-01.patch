@@ -0,0 +1,34 @@
+import { addTodo, listTodos, removeTodo, toggleTodo } from './application.ts';
+
+it('adds a todo and lists it', () => {
+  const todo = addTodo('Read a book');
+
+  expect(todo).toEqual({ id: expect.any(String), title: 'Read a book', completed: false });
+  expect(listTodos()).toContainEqual(todo);
+});
+
+it('gives each todo its own id', () => {
+  const first = addTodo('First');
+  const second = addTodo('Second');
+
+  expect(first.id).not.toBe(second.id);
+});
+
+it('toggles a todo and returns the updated todo', () => {
+  const todo = addTodo('Walk the dog');
+
+  expect(toggleTodo(todo.id)).toEqual({ ...todo, completed: true });
+  expect(listTodos()).toContainEqual({ ...todo, completed: true });
+});
+
+it('returns undefined when toggling an unknown id', () => {
+  expect(toggleTodo('missing')).toBeUndefined();
+});
+
+it('removes a todo and reports whether it existed', () => {
+  const todo = addTodo('Water the plants');
+
+  expect(removeTodo(todo.id)).toBe(true);
+  expect(listTodos()).not.toContainEqual(expect.objectContaining({ id: todo.id }));
+  expect(removeTodo(todo.id)).toBe(false);
+});
diff --git a/showcase/todo-01/api/src/features/todos/application.ts b/showcase/todo-01/api/src/features/todos/application.ts
new file mode 100644
index 0000000..720f63b
--- /dev/null
+++ b/showcase/todo-01/api/src/features/todos/application.ts
@@ -0,0 +1,28 @@
+import { newTodo, type Todo, toggledTodo } from './domain.ts';
+import { createInMemoryTodos } from './integrations.ts';
+
+const store = createInMemoryTodos();
+
+export function listTodos(): readonly Todo[] {
+  return store.list();
+}
+
+export function addTodo(title: string): Todo {
+  const todo = newTodo(store.nextId(), title);
+  store.save(todo);
+  return todo;
+}
+
+/** Returns the updated todo, or `undefined` when no todo has the id. */
+export function toggleTodo(id: string): Todo | undefined {
+  const todo = store.find(id);
+  if (todo === undefined) return undefined;
+  const toggled = toggledTodo(todo);
+  store.save(toggled);
+  return toggled;
+}
+
+/** Returns `false` when no todo has the id. */
+export function removeTodo(id: string): boolean {
+  return store.remove(id);
+}
