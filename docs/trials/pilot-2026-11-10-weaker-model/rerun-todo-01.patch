+++ b/showcase/todo-01/api/src/features/todos/procedures.test.ts
@@ -0,0 +1,51 @@
+import { TRPCError } from '@trpc/server';
+import { createCallerFactory } from '../../trpc.ts';
+import { todosRouter } from './procedures.ts';
+
+const caller = createCallerFactory(todosRouter)({});
+
+it('creates a trimmed todo that is not completed', async () => {
+  await expect(caller.create({ title: '  Buy milk  ' })).resolves.toEqual({
+    id: expect.any(String),
+    title: 'Buy milk',
+    completed: false,
+  });
+});
+
+it.each(['', '   '])('rejects the blank title %j as a bad request', async (title) => {
+  await expect(caller.create({ title })).rejects.toMatchObject({
+    constructor: TRPCError,
+    code: 'BAD_REQUEST',
+  });
+});
+
+it('lists the created todos', async () => {
+  const created = await caller.create({ title: 'Listed todo' });
+
+  await expect(caller.list()).resolves.toContainEqual(created);
+});
+
+it('toggles a todo back and forth', async () => {
+  const created = await caller.create({ title: 'Toggled todo' });
+
+  await expect(caller.toggle({ id: created.id })).resolves.toEqual({
+    ...created,
+    completed: true,
+  });
+  await expect(caller.toggle({ id: created.id })).resolves.toEqual(created);
+});
+
+it('reports an unknown id when toggling as not found', async () => {
+  await expect(caller.toggle({ id: 'missing' })).rejects.toMatchObject({ code: 'NOT_FOUND' });
+});
+
+it('deletes a todo and returns its id', async () => {
+  const created = await caller.create({ title: 'Deleted todo' });
+
+  await expect(caller.delete({ id: created.id })).resolves.toEqual({ id: created.id });
+  await expect(caller.list()).resolves.not.toContainEqual(created);
+});
+
+it('reports an unknown id when deleting as not found', async () => {
+  await expect(caller.delete({ id: 'missing' })).rejects.toMatchObject({ code: 'NOT_FOUND' });
+});
