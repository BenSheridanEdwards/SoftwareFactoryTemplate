@@ -0,0 +1,121 @@
+import { type ChildProcessWithoutNullStreams, spawn } from 'node:child_process';
+import { once } from 'node:events';
+import { createServer } from 'node:net';
+import { Schema } from 'effect';
+
+const children = new Set<ChildProcessWithoutNullStreams>();
+
+async function freePort() {
+  const server = createServer();
+  server.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+  try {
+    return Schema.decodeUnknownSync(Schema.Struct({ port: Schema.Number }))(server.address()).port;
+  } finally {
+    await new Promise<void>((resolve, reject) => {
+      server.close((error) => (error ? reject(error) : resolve()));
+    });
+  }
+}
+
+function startApi(port: string) {
+  const env = { ...process.env };
+  env.PORT = port;
+  const child = spawn(process.execPath, ['showcase/todo-01/api/src/server.ts'], {
+    env,
+    stdio: 'pipe',
+  });
+  children.add(child);
+  const output: string[] = [];
+  child.stdout.on('data', (chunk: Buffer) => output.push(chunk.toString()));
+  child.stderr.on('data', (chunk: Buffer) => output.push(chunk.toString()));
+  return { child, output };
+}
+
+async function waitForListening(child: ChildProcessWithoutNullStreams, output: string[]) {
+  await new Promise<void>((resolve, reject) => {
+    const cleanup = () => {
+      clearTimeout(timer);
+      child.stdout.off('data', onData);
+      child.off('exit', onExit);
+      child.off('error', fail);
+    };
+    const fail = (error: Error) => {
+      cleanup();
+      reject(error);
+    };
+    const onData = () => {
+      if (output.join('').includes('api listening')) {
+        cleanup();
+        resolve();
+      }
+    };
+    const onExit = () => fail(new Error(`API exited before listening: ${output.join('')}`));
+    const timer = setTimeout(
+      () => fail(new Error(`API startup timed out: ${output.join('')}`)),
+      3_000,
+    );
+    child.stdout.on('data', onData);
+    child.once('exit', onExit);
+    child.once('error', fail);
+  });
+}
+
+afterEach(async () => {
+  await Promise.all(
+    [...children].map(async (child) => {
+      if (child.exitCode !== null || child.signalCode !== null) return;
+      const exited = once(child, 'exit');
+      child.kill('SIGTERM');
+      const timer = setTimeout(() => child.kill('SIGKILL'), 2_000);
+      try {
+        await exited;
+      } finally {
+        clearTimeout(timer);
+      }
+    }),
+  );
+  children.clear();
+});
+
+describe('the todo API over real HTTP', () => {
+  it('lists the todos as a tRPC response', async () => {
+    const port = await freePort();
+    const { child, output } = startApi(String(port));
+    await waitForListening(child, output);
+
+    const response = await fetch(`http://127.0.0.1:${port}/trpc/todos.list`, {
+      signal: AbortSignal.timeout(5_000),
+    });
+
+    expect(response.status).toBe(200);
+    await expect(response.json()).resolves.toEqual({ result: { data: [] } });
+  });
+
+  it('rejects a blank title as a bad request', async () => {
+    const port = await freePort();
+    const { child, output } = startApi(String(port));
+    await waitForListening(child, output);
+
+    const response = await fetch(`http://127.0.0.1:${port}/trpc/todos.create`, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ title: '   ' }),
+      signal: AbortSignal.timeout(5_000),
+    });
+
+    expect(response.status).toBe(400);
+    await expect(response.json()).resolves.toMatchObject({
+      error: { data: { code: 'BAD_REQUEST' } },
+    });
+  });
+
+  it('exits with an error before listening when PORT is invalid', async () => {
+    const { child, output } = startApi('abc');
+    const [code, signal] = await once(child, 'close');
+    expect(signal).toBeNull();
+    expect(code).not.toBeNull();
+    expect(code).not.toBe(0);
+    expect(output.join('')).not.toContain('api listening');
+  });
+});
