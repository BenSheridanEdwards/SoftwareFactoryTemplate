@@ -0,0 +1,16 @@
+import { randomUUID } from 'node:crypto';
+import type { Todo } from './domain.ts';
+
+/** The todos live in this process's memory, keyed by id, and vanish on restart. */
+export function createInMemoryTodos() {
+  const todos = new Map<string, Todo>();
+  return {
+    nextId: (): string => randomUUID(),
+    list: (): readonly Todo[] => [...todos.values()],
+    find: (id: string): Todo | undefined => todos.get(id),
+    save: (todo: Todo): void => {
+      todos.set(todo.id, todo);
+    },
+    remove: (id: string): boolean => todos.delete(id),
+  };
+}
diff --git a/showcase/todo-01/api/src/features/todos/procedures.test.ts b/showcase/todo-01/api/src/features/todos/procedures.test.ts
new file mode 100644
