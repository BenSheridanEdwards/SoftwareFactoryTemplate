@@ -0,0 +1,60 @@
+import AxeBuilder from '@axe-core/playwright';
+import { expect, type Page, test } from './fixtures';
+
+/**
+ * The todo behaviour, end to end: the page in Chromium, the Vite server's
+ * `/trpc` proxy, and the real api process.
+ */
+async function addTodo(page: Page, title: string) {
+  await page.goto('/');
+  await page.getByRole('textbox', { name: 'Title' }).fill(title);
+  const saved = page.waitForResponse((response) => response.url().includes('/trpc/todos.create'));
+  await page.getByRole('button', { name: 'Add', exact: true }).click();
+  await saved;
+}
+
+test.describe('Todos', () => {
+  test('adds a todo to the list with its title trimmed', async ({ page }) => {
+    await addTodo(page, '  Buy milk  ');
+
+    await expect(page.getByRole('checkbox', { name: 'Buy milk', exact: true })).not.toBeChecked();
+  });
+
+  test('asks for a title and sends no request when the title is blank', async ({ page }) => {
+    const apiCalls: string[] = [];
+    await page.goto('/');
+    page.on('request', (request) => {
+      if (request.url().includes('/trpc/todos.create')) {
+        apiCalls.push(request.url());
+      }
+    });
+
+    await page.getByRole('textbox', { name: 'Title' }).fill('   ');
+    await page.getByRole('button', { name: 'Add', exact: true }).click();
+
+    await expect(page.getByRole('alert')).toHaveText('Enter a title');
+    expect(apiCalls).toEqual([]);
+  });
+
+  test('completes a todo and removes it', async ({ page }) => {
+    await addTodo(page, 'Walk the dog');
+    const checkbox = page.getByRole('checkbox', { name: 'Walk the dog', exact: true });
+
+    await checkbox.click();
+    await expect(checkbox).toBeChecked();
+
+    await page.getByRole('button', { name: 'Delete Walk the dog', exact: true }).click();
+    await expect(checkbox).toHaveCount(0);
+  });
+
+  test('has no detectable WCAG A/AA violations with a todo listed', async ({ page }) => {
+    await addTodo(page, 'Read a book');
+    await expect(page.getByRole('checkbox', { name: 'Read a book', exact: true })).toBeVisible();
+
+    const scan = await new AxeBuilder({ page })
+      .withTags(['wcag2a', 'wcag2aa', 'wcag21a', 'wcag21aa'])
+      .analyze();
+
+    expect(scan.violations).toEqual([]);
+  });
+});
