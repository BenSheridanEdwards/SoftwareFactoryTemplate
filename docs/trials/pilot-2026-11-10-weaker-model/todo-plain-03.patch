@@ -0,0 +1,18 @@
+import { randomUUID } from 'node:crypto';
+import type { Todo } from './domain.ts';
+
+/** Todos held in memory for the life of the api process, in creation order. */
+export function createInMemoryTodos() {
+  const todos = new Map<string, Todo>();
+  return {
+    newId: (): string => randomUUID(),
+    list: (): readonly Todo[] => [...todos.values()],
+    find: (id: string): Todo | undefined => todos.get(id),
+    save: (todo: Todo): void => {
+      todos.set(todo.id, todo);
+    },
+    remove: (id: string): void => {
+      todos.delete(id);
+    },
+  };
+}
diff --git a/showcase/todo-plain-03/api/src/features/todos/procedures.test.ts b/showcase/todo-plain-03/api/src/features/todos/procedures.test.ts
