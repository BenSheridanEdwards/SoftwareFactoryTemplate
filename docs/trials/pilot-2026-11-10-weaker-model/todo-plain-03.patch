+import { render, screen, waitFor } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { axe } from 'jest-axe';
+import { type TestApiHandlers, TestApiProvider } from '../../api-client';
+import { TodosPage } from './TodosPage';
+import type { Todo } from './useTodos';
+
+/** A todo api that keeps its todos in memory for the length of one test. */
+function fakeTodoApi(seed: readonly Todo[] = []): TestApiHandlers {
+  const todos = new Map(seed.map((todo) => [todo.id, todo] as const));
+  const counter = { last: seed.length };
+  return {
+    'todos.list': () => [...todos.values()],
+    'todos.create': ({ title }) => {
+      counter.last += 1;
+      const todo = { id: `todo-${counter.last}`, title, completed: false };
+      todos.set(todo.id, todo);
+      return todo;
+    },
+    'todos.toggle': ({ id }) => {
+      const todo = todos.get(id);
+      if (!todo) throw new Error(`no todo ${id}`);
+      const toggled = { ...todo, completed: !todo.completed };
+      todos.set(id, toggled);
+      return toggled;
+    },
+    'todos.delete': ({ id }) => {
+      todos.delete(id);
+      return { id };
+    },
+  };
+}
+
+function renderPage(handlers: TestApiHandlers) {
+  const view = render(
+    <TestApiProvider handlers={handlers}>
+      <TodosPage />
+    </TestApiProvider>,
+  );
+  return { ...view, user: userEvent.setup() };
+}
+
+it('shows the todos the api holds', async () => {
+  renderPage(fakeTodoApi([{ id: 'todo-1', title: 'Buy milk', completed: false }]));
+
+  expect(await screen.findByRole('checkbox', { name: 'Buy milk' })).not.toBeChecked();
+});
+
+it('adds a typed title to the list', async () => {
+  const { user } = renderPage(fakeTodoApi());
+
+  await user.type(await screen.findByRole('textbox', { name: 'Title' }), 'Walk the dog');
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+
+  expect(await screen.findByRole('checkbox', { name: 'Walk the dog' })).toBeInTheDocument();
+});
+
+it('toggles and deletes a todo', async () => {
+  const { user } = renderPage(fakeTodoApi([{ id: 'todo-1', title: 'Buy milk', completed: false }]));
+  const checkbox = await screen.findByRole('checkbox', { name: 'Buy milk' });
+
+  await user.click(checkbox);
+  await waitFor(() => expect(checkbox).toBeChecked());
+
+  await user.click(screen.getByRole('button', { name: 'Delete Buy milk' }));
+  await waitFor(() =>
+    expect(screen.queryByRole('checkbox', { name: 'Buy milk' })).not.toBeInTheDocument(),
+  );
+});
+
+it('asks for a title and adds nothing when it is blank', async () => {
+  const { user } = renderPage(fakeTodoApi());
+
+  await user.type(await screen.findByRole('textbox', { name: 'Title' }), '   ');
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Enter a title');
+  expect(await screen.findByText('No todos yet.')).toBeInTheDocument();
+});
+
+it('says so when the list fails to load', async () => {
+  renderPage({ 'todos.list': () => Promise.reject(new Error('api down')) });
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Could not load todos');
+});
+
+it('has no axe-detectable violations with todos listed', async () => {
+  const { container } = renderPage(
+    fakeTodoApi([{ id: 'todo-1', title: 'Buy milk', completed: false }]),
+  );
+  await screen.findByRole('checkbox', { name: 'Buy milk' });
+
+  expect(await axe(container)).toHaveNoViolations();
+});
