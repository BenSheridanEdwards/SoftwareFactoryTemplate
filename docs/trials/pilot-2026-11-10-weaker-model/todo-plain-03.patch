+          </p>
+        ) : null}
+        {state.status === 'loading' ? <p role="status">Loading…</p> : null}
+        {state.status === 'failed' ? (
+          <p role="alert" className="text-danger">
+            Could not load todos
+          </p>
+        ) : null}
+        {state.status === 'loaded' ? (
