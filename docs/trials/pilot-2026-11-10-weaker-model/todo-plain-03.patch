+beforeEach(() => jest.resetModules());
+
+it('starts empty and lists todos in creation order', async () => {
+  const { createTodo, listTodos } = await import('./application.ts');
+  expect(listTodos()).toEqual([]);
+  const first = createTodo({ title: 'Buy milk' });
+  const second = createTodo({ title: 'Walk the dog' });
+  expect(listTodos()).toEqual([first, second]);
+});
+
+it('toggles a todo and returns the updated value', async () => {
+  const { createTodo, toggleTodo } = await import('./application.ts');
+  const todo = createTodo({ title: 'Buy milk' });
+  expect(toggleTodo(todo.id)).toEqual({ ...todo, completed: true });
+  expect(toggleTodo(todo.id)).toEqual(todo);
+});
+
+it('returns undefined for an unknown id', async () => {
+  const { toggleTodo, deleteTodo } = await import('./application.ts');
+  expect(toggleTodo('missing')).toBeUndefined();
+  expect(deleteTodo('missing')).toBeUndefined();
+});
+
+it('deletes a todo and returns it', async () => {
+  const { createTodo, deleteTodo, listTodos } = await import('./application.ts');
+  const todo = createTodo({ title: 'Buy milk' });
+  expect(deleteTodo(todo.id)).toEqual(todo);
+  expect(listTodos()).toEqual([]);
+});
diff --git a/showcase/todo-plain-03/api/src/features/todos/application.ts b/showcase/todo-plain-03/api/src/features/todos/application.ts
new file mode 100644
index 0000000..15d1b58
--- /dev/null
+++ b/showcase/todo-plain-03/api/src/features/todos/application.ts
@@ -0,0 +1,31 @@
+import { flipCompleted, newTodo, type Todo } from './domain.ts';
+import { createInMemoryTodos } from './integrations.ts';
+
+const store = createInMemoryTodos();
+
+export function listTodos(): readonly Todo[] {
+  return store.list();
+}
+
+export function createTodo(request: { readonly title: string }): Todo {
+  const todo = newTodo(store.newId(), request.title);
+  store.save(todo);
+  return todo;
+}
+
+/** Returns the updated todo, or undefined when no todo has the id. */
+export function toggleTodo(id: string): Todo | undefined {
+  const todo = store.find(id);
+  if (todo === undefined) return undefined;
+  const toggled = flipCompleted(todo);
+  store.save(toggled);
+  return toggled;
+}
+
+/** Returns the deleted todo, or undefined when no todo has the id. */
+export function deleteTodo(id: string): Todo | undefined {
+  const todo = store.find(id);
+  if (todo === undefined) return undefined;
+  store.remove(id);
+  return todo;
+}
