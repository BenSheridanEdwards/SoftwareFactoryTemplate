@@ -0,0 +1,62 @@
+import { expect, type Page, test } from './fixtures';
+
+/**
+ * The todo behaviour, end to end: the page in Chromium, the Vite server's
+ * `/trpc` proxy, and the real api process.
+ */
+async function addTitle(page: Page, title: string) {
+  await page.goto('/');
+  await page.getByRole('textbox', { name: 'Title' }).fill(title);
+  await page.getByRole('button', { name: 'Add', exact: true }).click();
+}
+
+test.describe('Todos', () => {
+  test('adds a todo through the api and lists it unchecked', async ({ page }) => {
+    const created = page.waitForResponse((response) =>
+      response.url().includes('/trpc/todos.create'),
+    );
+
+    await addTitle(page, '  Buy milk  ');
+
+    expect((await created).status()).toBe(200);
+    await expect(page.getByRole('checkbox', { name: 'Buy milk', exact: true })).not.toBeChecked();
+  });
+
+  test('asks for a title and sends no request when the title is blank', async ({ page }) => {
+    const apiCalls: string[] = [];
+    page.on('request', (request) => {
+      if (new URL(request.url()).pathname.startsWith('/trpc/todos.create')) {
+        apiCalls.push(request.url());
+      }
+    });
+
+    await addTitle(page, '   ');
+
+    await expect(page.getByRole('alert')).toHaveText('Enter a title');
+    await expect(page.getByRole('textbox', { name: 'Title' })).toHaveAttribute(
+      'aria-invalid',
+      'true',
+    );
+    expect(apiCalls).toEqual([]);
+  });
+
+  test('the api rejects a blank title as a bad request', async ({ request }) => {
+    const response = await request.post('/trpc/todos.create?batch=1', {
+      data: { 0: { title: '   ' } },
+    });
+
+    expect(response.status()).toBe(400);
+    expect(await response.json()).toMatchObject([{ error: { data: { code: 'BAD_REQUEST' } } }]);
+  });
+
+  test('says so when the list cannot be loaded', async ({ page, expectConsole }) => {
+    expectConsole(/Failed to load resource: .*500/);
+    await page.route('**/trpc/todos.list**', (route) =>
+      route.fulfill({ status: 500, contentType: 'application/json', body: '{}' }),
+    );
+
+    await page.goto('/');
+
+    await expect(page.getByRole('alert')).toHaveText('Could not load todos');
+  });
+});
