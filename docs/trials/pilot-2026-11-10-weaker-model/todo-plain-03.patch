+import { act, renderHook, waitFor } from '@testing-library/react';
+import type { ReactNode } from 'react';
+import { type TestApiHandlers, TestApiProvider } from '../../api-client';
+import { useTodos } from './useTodos';
+
+function renderTodos(handlers: TestApiHandlers) {
+  const wrapper = ({ children }: { children: ReactNode }) => (
+    <TestApiProvider handlers={handlers}>{children}</TestApiProvider>
+  );
+  return renderHook(() => useTodos(), { wrapper });
+}
+
+it('loads, then holds the todos from the api', async () => {
+  const { result } = renderTodos({
+    'todos.list': () => [{ id: 'todo-1', title: 'Buy milk', completed: false }],
+  });
+
+  expect(result.current.state).toEqual({ status: 'loading' });
+  await waitFor(() =>
+    expect(result.current.state).toEqual({
+      status: 'loaded',
+      todos: [{ id: 'todo-1', title: 'Buy milk', completed: false }],
+    }),
+  );
+});
+
+it('reports a failed list request', async () => {
+  const { result } = renderTodos({ 'todos.list': () => Promise.reject(new Error('api down')) });
+
+  await waitFor(() => expect(result.current.state).toEqual({ status: 'failed' }));
+});
+
+it('sends the title and reports a failed change', async () => {
+  const create = jest.fn(() => Promise.reject(new Error('api down')));
+  const { result } = renderTodos({ 'todos.list': () => [], 'todos.create': create });
+  await waitFor(() => expect(result.current.state).toEqual({ status: 'loaded', todos: [] }));
+
+  act(() => result.current.createTodo({ title: 'Buy milk' }));
+
+  await waitFor(() => expect(result.current.failed).toBe(true));
+  expect(create).toHaveBeenCalledWith({ title: 'Buy milk' });
+});
