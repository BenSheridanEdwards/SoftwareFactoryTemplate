+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { type RouterInputs, type RouterOutputs, useTrpc } from '../../api-client';
+
+export type Tag = RouterOutputs['tags']['list'][number];
+export type CreateTag = RouterInputs['tags']['create'];
+
+/** Why the last create failed: the name is taken, or the api could not save it. */
+type CreateFailure = 'exists' | 'failed' | null;
+
+function queryStatus(list: { readonly isError: boolean; readonly isPending: boolean }) {
+  if (list.isError) return 'error';
+  return list.isPending ? 'loading' : 'ready';
+}
+
+function createFailure(
+  error: { readonly data?: { readonly code?: string } | null | undefined } | null,
+): CreateFailure {
+  if (!error) return null;
+  return error.data?.code === 'CONFLICT' ? 'exists' : 'failed';
+}
+
+/** The tag list and its mutations, refreshing the list after each change. */
+export function useTags() {
+  const trpc = useTrpc();
+  const queryClient = useQueryClient();
+  const list = useQuery(trpc.tags.list.queryOptions());
+  const refresh = () => queryClient.invalidateQueries({ queryKey: trpc.tags.list.queryKey() });
+  const create = useMutation(trpc.tags.create.mutationOptions({ onSuccess: refresh }));
+  const remove = useMutation(trpc.tags.delete.mutationOptions({ onSuccess: refresh }));
+
+  return {
+    tags: list.data ?? [],
+    status: queryStatus(list),
+    creating: create.isPending,
+    createFailure: createFailure(create.error),
+    createTag: (input: CreateTag) => create.mutate(input),
+    deleteTag: (id: Tag['id']) => remove.mutate({ id }),
+  };
+}
