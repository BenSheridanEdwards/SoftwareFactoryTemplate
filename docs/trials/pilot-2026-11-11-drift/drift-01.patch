+import { Button, TextField } from '@repo/ui';
+import { useTodoForm } from './useTodoForm';
+import type { CreateTodo } from './useTodos';
+
+export interface TodoFormProps {
+  readonly onCreate: (input: CreateTodo) => void;
+  readonly pending: boolean;
+}
+
+export function TodoForm({ onCreate, pending }: TodoFormProps) {
+  const { register, handleSubmit, reset, formState } = useTodoForm();
+  const handleAdd = handleSubmit(({ title }) => {
+    onCreate({ title });
+    reset();
+  });
+
+  return (
+    <form className="flex flex-col gap-3" onSubmit={handleAdd} noValidate>
+      <TextField
+        label="Title"
+        autoComplete="off"
+        error={formState.errors.title?.message}
+        {...register('title')}
+      />
+      <Button type="submit" disabled={pending}>
+        Add
+      </Button>
