+import { TagsPage } from './TagsPage';
+import type { Tag } from './useTags';
+
+function conflict() {
+  return TRPCClientError.from({
+    error: {
+      code: -32009,
+      message: 'That tag exists',
+      data: { code: 'CONFLICT', httpStatus: 409 },
+    },
+  });
+}
+
+/** An in-memory fake of the tags api, so the page runs against real hooks. */
+function fakeApi(initial: readonly Tag[] = []): TestApiHandlers {
+  const tags = new Map(initial.map((tag) => [tag.id, tag] as const));
+  const nextId = () => `id-${tags.size + 1}`;
+  return {
+    'tags.list': () => [...tags.values()],
+    'tags.create': ({ name }) => {
+      const taken = [...tags.values()].some((tag) => tag.name.toLowerCase() === name.toLowerCase());
+      if (taken) {
+        throw conflict();
+      }
+      const tag = { id: nextId(), name };
+      tags.set(tag.id, tag);
+      return tag;
+    },
+    'tags.delete': ({ id }) => {
+      tags.delete(id);
+      return { id };
+    },
+  };
+}
+
+function renderPage(handlers: TestApiHandlers) {
+  const view = render(
+    <TestApiProvider handlers={handlers}>
+      <TagsPage />
+    </TestApiProvider>,
+  );
+  return { ...view, user: userEvent.setup() };
+}
+
+async function submitName(user: ReturnType<typeof userEvent.setup>, name: string) {
+  await user.type(screen.getByRole('textbox', { name: 'Tag name' }), name);
+  await user.click(screen.getByRole('button', { name: 'Add tag' }));
+}
+
+it('lists the tags the api returns', async () => {
+  renderPage(fakeApi([{ id: '1', name: 'Garden' }]));
+
+  expect(await screen.findByRole('list', { name: 'Tags' })).toHaveTextContent('Garden');
+});
+
+it('adds a tag, then deletes it', async () => {
+  const { user } = renderPage(fakeApi());
+  await screen.findByRole('list', { name: 'Tags' });
+
+  await submitName(user, 'Travel');
+  expect(await screen.findByText('Travel')).toBeInTheDocument();
+
+  await user.click(screen.getByRole('button', { name: 'Delete tag Travel' }));
+  await waitFor(() => expect(screen.queryByText('Travel')).not.toBeInTheDocument());
+});
+
+it('alerts and sends nothing for a blank name', async () => {
+  const create = jest.fn(() => ({ id: '1', name: 'unused' }));
+  const { user } = renderPage({ ...fakeApi(), 'tags.create': create });
+  await screen.findByRole('list', { name: 'Tags' });
+
+  await submitName(user, '   ');
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Enter a tag name');
+  expect(create).not.toHaveBeenCalled();
+});
+
+it('says that the tag exists and adds nothing for a name already taken', async () => {
+  const { user } = renderPage(fakeApi([{ id: '1', name: 'Garden' }]));
+  await screen.findByRole('list', { name: 'Tags' });
+
+  await submitName(user, 'GARDEN');
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('That tag exists');
+  expect(screen.getByRole('list', { name: 'Tags' }).querySelectorAll('li')).toHaveLength(1);
+});
+
+it('says so when the api cannot save a tag', async () => {
+  const { user } = renderPage({
+    ...fakeApi(),
+    'tags.create': () => {
+      throw new Error('api down');
+    },
+  });
+  await screen.findByRole('list', { name: 'Tags' });
+
+  await submitName(user, 'Travel');
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Could not save the tag');
+});
+
+it('says so when the api cannot list the tags', async () => {
+  renderPage({ 'tags.list': () => Promise.reject(new Error('api down')) });
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Could not load the tags');
+});
+
+it('has no axe-detectable violations with a tag listed', async () => {
+  const { container } = renderPage(fakeApi([{ id: '1', name: 'Garden' }]));
+  await screen.findByRole('list', { name: 'Tags' });
+
+  expect(await axe(container)).toHaveNoViolations();
+});
