+import { TagForm } from './TagForm';
+import { TagList } from './TagList';
+import { useTags } from './useTags';
+
+export function TagsPage() {
+  const { tags, status, creating, createFailure, createTag, deleteTag } = useTags();
+
+  return (
+    <section className="mx-auto flex max-w-160 flex-col gap-6 px-4 pb-6 sm:pb-12" aria-label="Tags">
+      <h2 className="text-2xl font-bold tracking-tight">Tags</h2>
+      <TagForm onCreate={createTag} pending={creating} />
+      {createFailure === 'exists' ? (
+        <p role="alert" className="text-danger">
+          That tag exists
+        </p>
+      ) : null}
+      {createFailure === 'failed' ? (
+        <p role="alert" className="text-danger">
+          Could not save the tag
+        </p>
+      ) : null}
+      {status === 'error' ? (
+        <p role="alert" className="text-danger">
+          Could not load the tags
+        </p>
+      ) : null}
+      {status === 'loading' ? <p className="text-muted">Loading…</p> : null}
+      {status === 'ready' ? <TagList tags={tags} onDelete={deleteTag} /> : null}
+    </section>
+  );
+}
