+import { render, screen, waitFor } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { axe } from 'jest-axe';
+import { type TestApiHandlers, TestApiProvider } from '../../api-client';
+import { TodosPage } from './TodosPage';
+import type { Todo } from './useTodos';
+
+/** An in-memory fake of the todos api, so the page runs against real hooks. */
+function fakeApi(initial: readonly Todo[] = []): TestApiHandlers {
+  const todos = new Map(initial.map((todo) => [todo.id, todo] as const));
+  const nextId = () => `id-${todos.size + 1}`;
+  return {
+    'todos.list': () => [...todos.values()],
+    'todos.create': ({ title }) => {
+      const todo = { id: nextId(), title, completed: false };
+      todos.set(todo.id, todo);
+      return todo;
+    },
+    'todos.toggle': ({ id }) => {
+      const todo = todos.get(id) ?? { id, title: '', completed: false };
+      const toggled = { ...todo, completed: !todo.completed };
+      todos.set(id, toggled);
+      return toggled;
+    },
+    'todos.delete': ({ id }) => {
+      todos.delete(id);
+      return { id };
+    },
+  };
+}
+
+function renderPage(handlers: TestApiHandlers) {
+  const view = render(
+    <TestApiProvider handlers={handlers}>
+      <TodosPage />
+    </TestApiProvider>,
+  );
+  return { ...view, user: userEvent.setup() };
+}
+
+it('lists the todos the api returns', async () => {
+  renderPage(fakeApi([{ id: '1', title: 'Buy milk', completed: true }]));
+
+  expect(await screen.findByRole('checkbox', { name: 'Buy milk' })).toBeChecked();
+});
+
+it('adds a todo, then toggles and deletes it', async () => {
+  const { user } = renderPage(fakeApi());
+  await screen.findByRole('list', { name: 'Todos' });
+
+  await user.type(screen.getByRole('textbox', { name: 'Title' }), 'Read a book');
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+
+  const checkbox = await screen.findByRole('checkbox', { name: 'Read a book' });
+  expect(checkbox).not.toBeChecked();
+  await user.click(checkbox);
+  await waitFor(() => expect(screen.getByRole('checkbox', { name: 'Read a book' })).toBeChecked());
+
+  await user.click(screen.getByRole('button', { name: 'Delete Read a book' }));
+  await waitFor(() =>
+    expect(screen.queryByRole('checkbox', { name: 'Read a book' })).not.toBeInTheDocument(),
+  );
+});
+
+it('alerts and sends nothing for a blank title', async () => {
+  const create = jest.fn(() => ({ id: '1', title: 'unused', completed: false }));
+  const { user } = renderPage({ ...fakeApi(), 'todos.create': create });
+  await screen.findByRole('list', { name: 'Todos' });
+
+  await user.type(screen.getByRole('textbox', { name: 'Title' }), '   ');
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Enter a title');
+  expect(create).not.toHaveBeenCalled();
+});
+
+it('says so when the api cannot list the todos', async () => {
+  renderPage({ 'todos.list': () => Promise.reject(new Error('api down')) });
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Could not load the todos');
+});
+
+it('has no axe-detectable violations with a todo listed', async () => {
+  const { container } = renderPage(fakeApi([{ id: '1', title: 'Buy milk', completed: false }]));
+  await screen.findByRole('checkbox', { name: 'Buy milk' });
+
+  expect(await axe(container)).toHaveNoViolations();
+});
