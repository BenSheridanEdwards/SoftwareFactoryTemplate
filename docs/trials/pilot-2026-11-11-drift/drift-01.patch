diff --git a/showcase/drift-01/api/src/features/todos/application.ts b/showcase/drift-01/api/src/features/todos/application.ts
new file mode 100644
index 0000000..620d853
--- /dev/null
+++ b/showcase/drift-01/api/src/features/todos/application.ts
@@ -0,0 +1,26 @@
+import { flipCompleted, newTodo, type Todo } from './domain.ts';
+import { createInMemoryTodos } from './integrations.ts';
+
+const store = createInMemoryTodos();
+
+export function listTodos(): Todo[] {
+  return store.list();
+}
+
+export function createTodo(request: { readonly title: string }): Todo {
+  return store.save(newTodo(store.nextId(), request.title));
+}
+
+/** Flips the todo's completed flag, or returns undefined when no todo has the id. */
+export function toggleTodo(id: string): Todo | undefined {
+  const todo = store.find(id);
+  if (!todo) {
+    return undefined;
+  }
+  return store.save(flipCompleted(todo));
+}
+
+/** Removes the todo, and reports whether one had the id. */
+export function deleteTodo(id: string): boolean {
+  return store.remove(id);
+}
