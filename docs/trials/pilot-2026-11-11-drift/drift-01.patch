+import { expect, type Page, test } from '@playwright/test';
+
+interface Todo {
+  readonly id: string;
+  readonly title: string;
+  readonly completed: boolean;
+}
+
+const clearButton = (page: Page) =>
+  page.getByRole('button', { name: 'Clear completed', exact: true });
+
+/**
+ * Serves the todo list and the clear call from memory, so each test owns its
+ * todos. The api process is shared by every spec running in parallel. The
+ * client batches the page's queries into one request, so each procedure in
+ * the batch gets its own result.
+ */
+async function serveTodos(page: Page, initial: readonly Todo[], clearFails = false) {
+  const todos = new Map(initial.map((todo) => [todo.id, todo] as const));
+
+  await page.route('**/trpc/**', (route) => {
+    const procedures = new URL(route.request().url()).pathname.slice('/trpc/'.length).split(',');
+
+    if (procedures.includes('todos.clearCompleted')) {
+      if (clearFails) {
+        return route.fulfill({ status: 500, json: [{ error: { message: 'failed' } }] });
+      }
+      const ids = [...todos.values()].filter((todo) => todo.completed).map((todo) => todo.id);
+      return route.fulfill({
+        json: [{ result: { data: { ids: ids.filter((id) => todos.delete(id)) } } }],
+      });
+    }
+
+    return route.fulfill({
+      json: procedures.map((procedure) => ({
+        result: { data: procedure === 'todos.list' ? [...todos.values()] : [] },
+      })),
+    });
+  });
+}
+
+test.describe('Clear completed', () => {
+  test('removes the completed todos and keeps the others', async ({ page }) => {
+    await serveTodos(page, [
+      { id: '1', title: 'Buy milk', completed: true },
+      { id: '2', title: 'Walk the dog', completed: false },
+    ]);
+    await page.goto('/');
+
+    await clearButton(page).click();
+
+    await expect(page.getByRole('checkbox', { name: 'Buy milk', exact: true })).toHaveCount(0);
+    await expect(
+      page.getByRole('checkbox', { name: 'Walk the dog', exact: true }),
+    ).not.toBeChecked();
+  });
+
+  test('is disabled while no todo is completed', async ({ page }) => {
+    await serveTodos(page, [{ id: '2', title: 'Walk the dog', completed: false }]);
+    await page.goto('/');
+
+    await expect(page.getByRole('checkbox', { name: 'Walk the dog', exact: true })).toBeVisible();
+    await expect(clearButton(page)).toBeDisabled();
+  });
+
+  test('shows an alert when the completed todos cannot be cleared', async ({ page }) => {
+    await serveTodos(page, [{ id: '1', title: 'Buy milk', completed: true }], true);
+    await page.goto('/');
+
+    await clearButton(page).click();
+
+    await expect(page.getByRole('alert')).toHaveText('Could not clear the completed todos');
+    await expect(page.getByRole('checkbox', { name: 'Buy milk', exact: true })).toBeVisible();
+  });
+});
