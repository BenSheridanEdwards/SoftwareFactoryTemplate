@@ -0,0 +1,40 @@
+import { TRPCError } from '@trpc/server';
+import { createCallerFactory } from '../../trpc.ts';
+import { todosRouter } from './procedures.ts';
+
+const caller = createCallerFactory(todosRouter)({});
+
+it('creates a trimmed, incomplete todo and lists it', async () => {
+  const todo = await caller.create({ title: '  Buy milk  ' });
+
+  expect(todo).toEqual({ id: expect.any(String), title: 'Buy milk', completed: false });
+  await expect(caller.list()).resolves.toContainEqual(todo);
+});
+
+it.each(['', '   '])('rejects the blank title %j as a bad request', async (title) => {
+  await expect(caller.create({ title })).rejects.toMatchObject({
+    constructor: TRPCError,
+    code: 'BAD_REQUEST',
+  });
+});
+
+it('toggles a todo complete and back', async () => {
+  const todo = await caller.create({ title: 'Walk the dog' });
+
+  await expect(caller.toggle({ id: todo.id })).resolves.toEqual({ ...todo, completed: true });
+  await expect(caller.toggle({ id: todo.id })).resolves.toEqual(todo);
+});
+
+it('deletes a todo and returns its id', async () => {
+  const todo = await caller.create({ title: 'Water the plants' });
+
+  await expect(caller.delete({ id: todo.id })).resolves.toEqual({ id: todo.id });
+  await expect(caller.list()).resolves.not.toContainEqual(todo);
+});
+
+it.each([
+  ['toggle', (id: string) => caller.toggle({ id })],
+  ['delete', (id: string) => caller.delete({ id })],
+])('%s reports a missing todo as not found', async (_name, run) => {
+  await expect(run('missing-id')).rejects.toMatchObject({ code: 'NOT_FOUND' });
+});
diff --git a/showcase/drift-01/api/src/features/todos/procedures.ts b/showcase/drift-01/api/src/features/todos/procedures.ts
new file mode 100644
index 0000000..fd9703a
--- /dev/null
+++ b/showcase/drift-01/api/src/features/todos/procedures.ts
@@ -0,0 +1,32 @@
+import { TRPCError } from '@trpc/server';
+import { Schema } from 'effect';
+import { procedure, router } from '../../trpc.ts';
+import { createTodo, deleteTodo, listTodos, toggleTodo } from './application.ts';
+
+const createInputSchema = Schema.Struct({ title: Schema.Trim.check(Schema.isNonEmpty()) });
+const idInputSchema = Schema.Struct({ id: Schema.String });
+
+const todoNotFound = () => new TRPCError({ code: 'NOT_FOUND', message: 'Todo not found' });
+
+const todosProcedures = {
+  list: procedure.query(() => listTodos()),
+  create: procedure
+    .input(Schema.toStandardSchemaV1(createInputSchema))
+    .mutation(({ input }) => createTodo(input)),
+  toggle: procedure.input(Schema.toStandardSchemaV1(idInputSchema)).mutation(({ input }) => {
+    const todo = toggleTodo(input.id);
+    if (!todo) {
+      throw todoNotFound();
+    }
+    return todo;
+  }),
+  delete: procedure.input(Schema.toStandardSchemaV1(idInputSchema)).mutation(({ input }) => {
+    if (!deleteTodo(input.id)) {
+      throw todoNotFound();
+    }
+    return { id: input.id };
+  }),
+};
+
+export const todosRouter: ReturnType<typeof router<typeof todosProcedures>> =
+  router(todosProcedures);
