@@ -0,0 +1,17 @@
+import { randomUUID } from 'node:crypto';
+import type { Todo } from './domain.ts';
+
+/** Todos kept in memory, inside the api process. */
+export function createInMemoryTodos() {
+  const todos = new Map<string, Todo>();
+  return {
+    nextId: (): string => randomUUID(),
+    list: (): Todo[] => [...todos.values()],
+    find: (id: string): Todo | undefined => todos.get(id),
+    save: (todo: Todo): Todo => {
+      todos.set(todo.id, todo);
+      return todo;
+    },
+    remove: (id: string): boolean => todos.delete(id),
+  };
+}
diff --git a/showcase/drift-01/api/src/features/todos/procedures.test.ts b/showcase/drift-01/api/src/features/todos/procedures.test.ts
