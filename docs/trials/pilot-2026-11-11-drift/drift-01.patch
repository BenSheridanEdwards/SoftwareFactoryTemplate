+
+const Port = Schema.NumberFromString.check(
+  Schema.isInt(),
+  Schema.isBetween({ minimum: 1, maximum: 65_535 }),
+);
+
+const port = Schema.decodeUnknownSync(Port)(process.env.PORT ?? '3001');
