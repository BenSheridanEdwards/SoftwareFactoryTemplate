+import { randomUUID } from 'node:crypto';
+import type { Tag } from './domain.ts';
+
+/** Tags kept in memory, inside the api process, in creation order. */
+export function createInMemoryTags() {
+  const tags = new Map<string, Tag>();
+  return {
+    nextId: (): string => randomUUID(),
+    list: (): Tag[] => [...tags.values()],
+    save: (tag: Tag): Tag => {
+      tags.set(tag.id, tag);
+      return tag;
+    },
+    remove: (id: string): boolean => tags.delete(id),
+  };
+}
