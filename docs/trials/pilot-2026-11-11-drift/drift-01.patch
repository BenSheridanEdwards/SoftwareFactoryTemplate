+import { newTag, sameTagName, type Tag } from './domain.ts';
+import { createInMemoryTags } from './integrations.ts';
+
+const store = createInMemoryTags();
+
+export function listTags(): Tag[] {
+  return store.list();
+}
+
+/** Stores a tag, or returns undefined when a stored tag already has the name. */
+export function createTag(request: { readonly name: string }): Tag | undefined {
+  const exists = store.list().some((tag) => sameTagName(tag.name, request.name));
+  if (exists) {
+    return undefined;
+  }
+  return store.save(newTag(store.nextId(), request.name));
+}
+
+/** Removes the tag, and reports whether one had the id. */
+export function deleteTag(id: string): boolean {
+  return store.remove(id);
+}
