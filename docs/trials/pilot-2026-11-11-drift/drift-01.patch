+  return <p>{query.data ? `${query.data.length} todos` : 'waiting'}</p>;
+}
+
+const realFetch = globalThis.fetch;
+afterEach(() => {
+  globalThis.fetch = realFetch;
+});
+
+it('sends procedure calls to /trpc on the same origin and reads the answer', async () => {
+  // jsdom omits Response; use Node's native implementation from its own realm.
+  const NodeResponse: typeof Response = jest.requireActual('node:vm').runInThisContext('Response');
+  const fetchMock = jest.fn<ReturnType<typeof fetch>, Parameters<typeof fetch>>(
+    async () =>
+      new NodeResponse(JSON.stringify([{ result: { data: [] } }]), {
+        headers: { 'content-type': 'application/json' },
+      }),
+  );
+  globalThis.fetch = fetchMock;
+
+  render(
+    <ApiProvider>
+      <TodosProbe />
+    </ApiProvider>,
+  );
+
+  expect(await screen.findByText('0 todos')).toBeInTheDocument();
+  const [url] = fetchMock.mock.calls[0] ?? [];
+  expect(String(url)).toMatch(/^\/trpc\/todos\.list\?batch=1/);
