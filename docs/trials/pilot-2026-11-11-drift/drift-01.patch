new file mode 100644
index 0000000..2c75ca2
--- /dev/null
+++ b/showcase/drift-01/web/e2e/todo-summary.spec.ts
@@ -0,0 +1,95 @@
+import { randomUUID } from 'node:crypto';
+import { expect, type Page, test } from '@playwright/test';
+
+interface Todo {
+  readonly id: string;
+  readonly title: string;
+  readonly completed: boolean;
+}
+
+const summary = (page: Page) => page.getByRole('status');
+
+/**
+ * Serves the todos from memory, so each test owns its count. The api process
+ * is shared by every spec running in parallel, so a count read from it would
+ * change under the test. The client batches the page's queries into one
+ * request, so each procedure in the batch reads its own input and gets its
+ * own result.
+ */
+async function serveTodos(page: Page, initial: readonly Todo[]) {
+  const todos = new Map(initial.map((todo) => [todo.id, todo] as const));
+
+  await page.route('**/trpc/**', (route) => {
+    const request = route.request();
+    const procedures = new URL(request.url()).pathname.slice('/trpc/'.length).split(',');
+    const inputs = request.method() === 'POST' ? request.postDataJSON() : {};
+
+    const results = procedures.map((procedure, index) => {
+      const input = inputs[index];
+      if (procedure === 'todos.list') return [...todos.values()];
+      if (procedure === 'todos.create') {
+        const todo = { id: randomUUID(), title: input.title, completed: false };
+        todos.set(todo.id, todo);
+        return todo;
+      }
+      if (procedure === 'todos.toggle') {
+        const todo = todos.get(input.id);
+        if (todo) todos.set(todo.id, { ...todo, completed: !todo.completed });
+        return todo;
+      }
+      if (procedure === 'todos.delete') {
+        todos.delete(input.id);
+        return { id: input.id };
+      }
+      if (procedure === 'todos.clearCompleted') {
+        const ids = [...todos.values()].filter((todo) => todo.completed).map((todo) => todo.id);
+        return { ids: ids.filter((id) => todos.delete(id)) };
+      }
+      return [];
+    });
+
+    return route.fulfill({ json: results.map((data) => ({ result: { data } })) });
+  });
+}
+
+test.describe('Todo summary', () => {
+  test('reads how many of the todos are done', async ({ page }) => {
+    await serveTodos(page, [
+      { id: '1', title: 'Buy milk', completed: true },
+      { id: '2', title: 'Walk the dog', completed: false },
+    ]);
+    await page.goto('/');
+
+    await expect(summary(page)).toHaveText('1 of 2 done');
+  });
+
+  test('reads 0 of 0 done for an empty list', async ({ page }) => {
+    await serveTodos(page, []);
+    await page.goto('/');
+
+    await expect(summary(page)).toHaveText('0 of 0 done');
+  });
+
+  test('stays correct after a create, a toggle, a delete and a clear', async ({ page }) => {
+    await serveTodos(page, []);
+    await page.goto('/');
+    await expect(summary(page)).toHaveText('0 of 0 done');
+
+    await page.getByRole('textbox', { name: 'Title' }).fill('Buy milk');
+    await page.getByRole('button', { name: 'Add', exact: true }).click();
+    await expect(summary(page)).toHaveText('0 of 1 done');
+
+    await page.getByRole('textbox', { name: 'Title' }).fill('Walk the dog');
+    await page.getByRole('button', { name: 'Add', exact: true }).click();
+    await expect(summary(page)).toHaveText('0 of 2 done');
+
+    await page.getByRole('checkbox', { name: 'Buy milk', exact: true }).click();
+    await expect(summary(page)).toHaveText('1 of 2 done');
+
+    await page.getByRole('button', { name: 'Delete Walk the dog', exact: true }).click();
+    await expect(summary(page)).toHaveText('1 of 1 done');
+
+    await page.getByRole('button', { name: 'Clear completed', exact: true }).click();
+    await expect(summary(page)).toHaveText('0 of 0 done');
+  });
+});
