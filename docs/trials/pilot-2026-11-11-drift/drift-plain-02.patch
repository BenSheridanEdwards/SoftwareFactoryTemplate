@@ -0,0 +1,129 @@
+import { render, screen, waitFor } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { axe } from 'jest-axe';
+import { type TestApiHandlers, TestApiProvider } from '../../api-client';
+import { TodosPage } from './TodosPage';
+
+interface FakeTodo {
+  readonly id: string;
+  readonly title: string;
+  readonly completed: boolean;
+}
+
+/** An in-memory api for the page: each handler answers from one shared list. */
+function fakeApi(initial: readonly FakeTodo[] = []) {
+  const todos = [...initial];
+  const find = (id: string) => todos.find((todo) => todo.id === id);
+  const handlers: TestApiHandlers = {
+    'todos.list': () => [...todos],
+    'todos.create': ({ title }) => {
+      const todo = { id: `id-${todos.length + 1}`, title, completed: false };
+      todos.push(todo);
+      return todo;
+    },
+    'todos.toggle': ({ id }) => {
+      const todo = find(id);
+      if (!todo) throw new Error('missing');
+      const updated = { ...todo, completed: !todo.completed };
+      todos.splice(todos.indexOf(todo), 1, updated);
+      return updated;
+    },
+    'todos.delete': ({ id }) => {
+      const todo = find(id);
+      if (!todo) throw new Error('missing');
+      todos.splice(todos.indexOf(todo), 1);
+      return { id };
+    },
+  };
+  return { todos, handlers };
+}
+
+function renderPage(handlers: TestApiHandlers) {
+  const view = render(
+    <TestApiProvider handlers={handlers}>
+      <TodosPage />
+    </TestApiProvider>,
+  );
+  return { ...view, user: userEvent.setup() };
+}
+
+it('shows the heading and lists the todos from the api', async () => {
+  const { handlers } = fakeApi([{ id: '1', title: 'Buy milk', completed: true }]);
+  renderPage(handlers);
+
+  expect(screen.getByRole('heading', { level: 1, name: 'Todos' })).toBeInTheDocument();
+  expect(await screen.findByRole('checkbox', { name: 'Buy milk' })).toBeChecked();
+});
+
+it('creates a trimmed todo, lists it unchecked and clears the field', async () => {
+  const { handlers, todos } = fakeApi();
+  const { user } = renderPage(handlers);
+
+  await user.type(await screen.findByRole('textbox', { name: 'Title' }), '  Walk the dog ');
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+
+  expect(await screen.findByRole('checkbox', { name: 'Walk the dog' })).not.toBeChecked();
+  expect(todos).toEqual([expect.objectContaining({ title: 'Walk the dog' })]);
+  expect(screen.getByRole('textbox', { name: 'Title' })).toHaveValue('');
+});
+
