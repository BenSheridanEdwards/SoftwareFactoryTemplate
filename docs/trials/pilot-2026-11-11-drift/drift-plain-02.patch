+import { randomUUID } from 'node:crypto';
+import { expect, type Page, test } from '@playwright/test';
+
+/** The Tag behaviour end to end: the page in Chromium, the Vite `/trpc` proxy and the api process. */
+const newName = (label: string) => `${label} ${randomUUID().slice(0, 8)}`;
+
+const tagsSection = (page: Page) => page.getByRole('region', { name: 'Tags' });
+
+const deleteButton = (page: Page, name: string) =>
+  page.getByRole('button', { name: `Delete tag ${name}`, exact: true });
+
+async function addTag(page: Page, name: string) {
+  await page.getByRole('textbox', { name: 'Tag name' }).fill(name);
+  const saved = page.waitForResponse(
+    (response) => response.url().includes('/trpc/tags.create') && response.status() === 200,
+  );
+  await page.getByRole('button', { name: 'Add tag' }).click();
+  await saved;
+}
