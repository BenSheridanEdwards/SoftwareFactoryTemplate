+import { expect, type Page, test } from '@playwright/test';
+
+/** The Todo behaviour end to end: the page in Chromium, the Vite `/trpc` proxy and the api process. */
+async function addTodo(page: Page, title: string) {
+  await page.getByRole('textbox', { name: 'Title' }).fill(title);
+  const saved = page.waitForResponse(
+    (response) => response.url().includes('/trpc/todos.create') && response.status() === 200,
+  );
+  await page.getByRole('button', { name: 'Add', exact: true }).click();
+  await saved;
+}
+
+test.describe('Todos', () => {
+  test('keeps a added todo across a reload', async ({ page }) => {
+    const title = `Persist ${Date.now()}`;
+    await page.goto('/');
+
+    await addTodo(page, title);
+    await page.reload();
+
+    await expect(page.getByRole('checkbox', { name: title, exact: true })).not.toBeChecked();
+  });
+
+  test('asks for a title and sends no request when the title is blank', async ({ page }) => {
+    const creates: string[] = [];
+    page.on('request', (request) => {
+      if (request.url().includes('/trpc/todos.create')) creates.push(request.url());
+    });
+    await page.goto('/');
+
+    await page.getByRole('textbox', { name: 'Title' }).fill('   ');
+    await page.getByRole('button', { name: 'Add', exact: true }).click();
+
+    await expect(page.getByRole('alert')).toHaveText('Enter a title');
+    expect(creates).toEqual([]);
+  });
+});
