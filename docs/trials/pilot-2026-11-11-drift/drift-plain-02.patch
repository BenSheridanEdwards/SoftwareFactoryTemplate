+import { render, screen, waitFor } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { TRPCClientError } from '@trpc/client';
+import { axe } from 'jest-axe';
+import { type TestApiHandlers, TestApiProvider } from '../../api-client';
+import { TagsPage } from './TagsPage';
+
+interface FakeTag {
+  readonly id: string;
+  readonly name: string;
+}
+
+/** The error the api sends for a name that a tag already has. */
+function conflict() {
+  return new TRPCClientError('That tag exists', {
+    result: {
+      error: {
+        code: -32603,
+        message: 'That tag exists',
+        data: { code: 'CONFLICT', httpStatus: 409 },
+      },
+    },
+  });
+}
+
+/** An in-memory api for the page: each handler answers from one shared list. */
+function fakeApi(initial: readonly FakeTag[] = []) {
+  const tags = [...initial];
+  const handlers: TestApiHandlers = {
+    'tags.list': () => [...tags],
+    'tags.create': ({ name }) => {
+      if (tags.some((tag) => tag.name.toLowerCase() === name.toLowerCase())) {
+        return Promise.reject(conflict());
+      }
+      const tag = { id: `id-${tags.length + 1}`, name };
+      tags.push(tag);
+      return tag;
+    },
+    'tags.delete': ({ id }) => {
+      const tag = tags.find((item) => item.id === id);
+      if (!tag) throw new Error('missing');
+      tags.splice(tags.indexOf(tag), 1);
+      return { id };
+    },
+  };
+  return { tags, handlers };
+}
+
+function renderPage(handlers: TestApiHandlers) {
+  const view = render(
+    <TestApiProvider handlers={handlers}>
+      <TagsPage />
+    </TestApiProvider>,
+  );
+  return { ...view, user: userEvent.setup() };
+}
+
+it('lists the tags from the api in a named section', async () => {
+  const { handlers } = fakeApi([{ id: '1', name: 'Home' }]);
+  renderPage(handlers);
+
+  expect(screen.getByRole('region', { name: 'Tags' })).toBeInTheDocument();
+  expect(await screen.findByRole('list', { name: 'Tags' })).toHaveTextContent('Home');
+});
+
+it('creates a trimmed tag, lists it and clears the field', async () => {
+  const { handlers, tags } = fakeApi();
+  const { user } = renderPage(handlers);
+
+  await user.type(await screen.findByRole('textbox', { name: 'Tag name' }), '  Errands ');
+  await user.click(screen.getByRole('button', { name: 'Add tag' }));
+
+  expect(await screen.findByRole('button', { name: 'Delete tag Errands' })).toBeInTheDocument();
+  expect(tags).toEqual([expect.objectContaining({ name: 'Errands' })]);
+  expect(screen.getByRole('textbox', { name: 'Tag name' })).toHaveValue('');
+});
+
+it.each(['', '   '])('adds nothing and shows an alert for the name %j', async (name) => {
+  const { handlers, tags } = fakeApi();
+  const { user } = renderPage(handlers);
+
+  const field = await screen.findByRole('textbox', { name: 'Tag name' });
+  if (name) {
+    await user.type(field, name);
+  }
+  await user.click(screen.getByRole('button', { name: 'Add tag' }));
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Enter a tag name');
+  expect(tags).toEqual([]);
+});
+
+it('says that a tag exists when its name is already listed', async () => {
+  const { handlers, tags } = fakeApi([{ id: '1', name: 'Home' }]);
+  const { user } = renderPage(handlers);
+
+  await user.type(await screen.findByRole('textbox', { name: 'Tag name' }), 'HOME');
+  await user.click(screen.getByRole('button', { name: 'Add tag' }));
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('That tag exists');
+  expect(tags).toEqual([{ id: '1', name: 'Home' }]);
+});
+
+it('deletes a tag from the list', async () => {
+  const { handlers, tags } = fakeApi([{ id: '1', name: 'Gone' }]);
+  const { user } = renderPage(handlers);
+
+  await user.click(await screen.findByRole('button', { name: 'Delete tag Gone' }));
+
+  await waitFor(() => expect(screen.queryByRole('button', { name: 'Delete tag Gone' })).toBeNull());
+  expect(tags).toEqual([]);
+});
+
+it('says so when the list cannot load', async () => {
+  renderPage({ 'tags.list': () => Promise.reject(new Error('api down')) });
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Could not load the tags');
+});
+
+it('says so when a delete cannot be saved', async () => {
+  const { handlers } = fakeApi([{ id: '1', name: 'Stuck' }]);
+  const { user } = renderPage({
+    ...handlers,
+    'tags.delete': () => Promise.reject(new Error('api down')),
+  });
+
+  await user.click(await screen.findByRole('button', { name: 'Delete tag Stuck' }));
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Could not save the tag');
+});
+
+it('has no axe-detectable violations with a tag listed', async () => {
+  const { handlers } = fakeApi([{ id: '1', name: 'Read' }]);
+  const { container } = renderPage(handlers);
+  await screen.findByRole('button', { name: 'Delete tag Read' });
+
+  expect(await axe(container)).toHaveNoViolations();
+});
