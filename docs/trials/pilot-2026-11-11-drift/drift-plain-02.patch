@@ -0,0 +1,47 @@
+beforeEach(() => jest.resetModules());
+
+it('starts empty and lists added todos in order', async () => {
+  const { addTodo, listTodos } = await import('./application.ts');
+  expect(listTodos()).toEqual([]);
+  addTodo({ title: 'Ada' });
+  addTodo({ title: 'Lin' });
+  expect(listTodos().map((todo) => todo.title)).toEqual(['Ada', 'Lin']);
+});
+
+it('gives each added todo its own id and starts it incomplete', async () => {
+  const { addTodo } = await import('./application.ts');
+  const first = addTodo({ title: 'Ada' });
+  const second = addTodo({ title: 'Ada' });
+  expect(first.id).not.toBe(second.id);
+  expect(first.completed).toBe(false);
+});
+
+it('toggles a todo back and forth and keeps the others', async () => {
+  const { addTodo, listTodos, toggleTodo } = await import('./application.ts');
+  const kept = addTodo({ title: 'Kept' });
+  const todo = addTodo({ title: 'Toggled' });
+  expect(toggleTodo({ id: todo.id })).toEqual({ ...todo, completed: true });
+  expect(listTodos()).toContainEqual(kept);
+  expect(toggleTodo({ id: todo.id })).toEqual(todo);
+});
+
+it('returns undefined when toggling or deleting an unknown id', async () => {
+  const { toggleTodo, deleteTodo } = await import('./application.ts');
+  expect(toggleTodo({ id: 'missing' })).toBeUndefined();
+  expect(deleteTodo({ id: 'missing' })).toBeUndefined();
+});
+
+it('deletes a todo and returns it', async () => {
+  const { addTodo, deleteTodo, listTodos } = await import('./application.ts');
+  const todo = addTodo({ title: 'Gone' });
+  expect(deleteTodo({ id: todo.id })).toEqual(todo);
+  expect(listTodos()).toEqual([]);
+});
+
+it('keeps previous snapshots unchanged when a todo is toggled', async () => {
+  const { addTodo, listTodos, toggleTodo } = await import('./application.ts');
+  const todo = addTodo({ title: 'Ada' });
+  const previous = listTodos();
+  toggleTodo({ id: todo.id });
+  expect(previous).toEqual([todo]);
+});
diff --git a/showcase/drift-plain-02/api/src/features/todos/application.ts b/showcase/drift-plain-02/api/src/features/todos/application.ts
new file mode 100644
index 0000000..953e48d
--- /dev/null
+++ b/showcase/drift-plain-02/api/src/features/todos/application.ts
@@ -0,0 +1,29 @@
+import { flipCompleted, newTodo, type Todo } from './domain.ts';
+import { createInMemoryTodos } from './integrations.ts';
+
+const store = createInMemoryTodos();
+
+export function listTodos(): readonly Todo[] {
+  return store.read();
+}
+
+export function addTodo(request: { readonly title: string }): Todo {
+  const todo = newTodo(store.nextId(), request.title);
+  store.write([...store.read(), todo]);
+  return todo;
+}
+
+export function toggleTodo(request: { readonly id: string }): Todo | undefined {
+  const current = store.read().find((todo) => todo.id === request.id);
+  if (!current) return undefined;
+  const updated = flipCompleted(current);
+  store.write(store.read().map((todo) => (todo.id === updated.id ? updated : todo)));
+  return updated;
+}
+
+export function deleteTodo(request: { readonly id: string }): Todo | undefined {
+  const removed = store.read().find((todo) => todo.id === request.id);
+  if (!removed) return undefined;
+  store.write(store.read().filter((todo) => todo.id !== removed.id));
+  return removed;
+}
