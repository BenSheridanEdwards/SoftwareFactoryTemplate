@@ -0,0 +1,36 @@
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { type RouterInputs, type RouterOutputs, useTrpc } from '../../api-client';
+
+export type Todo = RouterOutputs['todos']['list'][number];
+export type CreateTodo = RouterInputs['todos']['create'];
+
+export type TodosState =
+  | { readonly status: 'loading' }
+  | { readonly status: 'failed' }
+  | { readonly status: 'loaded'; readonly todos: readonly Todo[] };
+
+function toTodosState(query: { isError: boolean; data: readonly Todo[] | undefined }): TodosState {
+  if (query.isError) return { status: 'failed' };
+  if (query.data) return { status: 'loaded', todos: query.data };
+  return { status: 'loading' };
+}
+
+/** The todo list and the create, toggle and delete changes, through the api. */
+export function useTodos() {
+  const trpc = useTrpc();
+  const queryClient = useQueryClient();
+  const list = useQuery(trpc.todos.list.queryOptions());
+  const refreshList = () => queryClient.invalidateQueries({ queryKey: trpc.todos.list.queryKey() });
+  const create = useMutation(trpc.todos.create.mutationOptions({ onSuccess: refreshList }));
+  const toggle = useMutation(trpc.todos.toggle.mutationOptions({ onSuccess: refreshList }));
+  const remove = useMutation(trpc.todos.delete.mutationOptions({ onSuccess: refreshList }));
+
+  return {
+    state: toTodosState(list),
+    creating: create.isPending,
+    saveFailed: create.isError || toggle.isError || remove.isError,
+    createTodo: create.mutate,
+    toggleTodo: (id: Todo['id']) => toggle.mutate({ id }),
+    deleteTodo: (id: Todo['id']) => remove.mutate({ id }),
+  };
+}
