@@ -0,0 +1,28 @@
+import { isSameTagName, newTag, type Tag } from './domain.ts';
+import { createInMemoryTags } from './integrations.ts';
+
+const store = createInMemoryTags();
+
+export type AddTagOutcome =
+  | { readonly status: 'added'; readonly tag: Tag }
+  | { readonly status: 'duplicate' };
+
+export function listTags(): readonly Tag[] {
+  return store.read();
+}
+
+export function addTag(request: { readonly name: string }): AddTagOutcome {
+  if (store.read().some((tag) => isSameTagName(tag.name, request.name))) {
+    return { status: 'duplicate' };
+  }
+  const tag = newTag(store.nextId(), request.name);
+  store.write([...store.read(), tag]);
+  return { status: 'added', tag };
+}
+
+export function deleteTag(request: { readonly id: string }): Tag | undefined {
+  const removed = store.read().find((tag) => tag.id === request.id);
+  if (!removed) return undefined;
+  store.write(store.read().filter((tag) => tag.id !== removed.id));
+  return removed;
+}
