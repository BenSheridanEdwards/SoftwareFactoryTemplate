+import { randomUUID } from 'node:crypto';
+import { expect, type Page, test } from '@playwright/test';
+
+/**
+ * The todo summary end to end: the page in Chromium, the Vite `/trpc` proxy and the api process.
+ * Tests share one api process, so each checks the summary against the list on the page, not fixed counts.
+ */
+const newTitle = (label: string) => `${label} ${randomUUID().slice(0, 8)}`;
+
+const todoList = (page: Page) => page.getByRole('list', { name: 'Todos' });
+
+const checkbox = (page: Page, title: string) =>
+  page.getByRole('checkbox', { name: title, exact: true });
+
+async function addTodo(page: Page, title: string) {
+  await page.getByRole('textbox', { name: 'Title' }).fill(title);
+  const saved = page.waitForResponse(
+    (response) => response.url().includes('/trpc/todos.create') && response.status() === 200,
+  );
+  await page.getByRole('button', { name: 'Add', exact: true }).click();
+  await saved;
+}
+
+async function expectSummaryToMatchList(page: Page) {
+  await expect(async () => {
+    const total = await todoList(page).getByRole('checkbox').count();
+    const done = await todoList(page).getByRole('checkbox', { checked: true }).count();
+    await expect(page.getByRole('status')).toHaveText(`${done} of ${total} done`);
+  }).toPass();
+}
+
+test.describe('Todo summary', () => {
+  test('stays equal to the list after a create, a toggle, a delete and a clear', async ({
+    page,
+  }) => {
+    const title = newTitle('Summary');
+    const other = newTitle('Summary other');
+    await page.goto('/');
+    await expectSummaryToMatchList(page);
+
+    await addTodo(page, title);
+    await expect(checkbox(page, title)).toBeVisible();
+    await expectSummaryToMatchList(page);
+
+    const toggled = page.waitForResponse(
+      (response) => response.url().includes('/trpc/todos.toggle') && response.status() === 200,
+    );
+    await checkbox(page, title).click();
+    await toggled;
+    await expect(checkbox(page, title)).toBeChecked();
+    await expectSummaryToMatchList(page);
+
+    await page.getByRole('button', { name: `Delete ${title}`, exact: true }).click();
+    await expect(checkbox(page, title)).toHaveCount(0);
+    await expectSummaryToMatchList(page);
+
+    await addTodo(page, other);
+    await checkbox(page, other).click();
+    await expect(checkbox(page, other)).toBeChecked();
+    await page.getByRole('button', { name: 'Clear completed', exact: true }).click();
+    await expect(checkbox(page, other)).toHaveCount(0);
+    await expectSummaryToMatchList(page);
+
+    await page.reload();
+    await expectSummaryToMatchList(page);
+  });
+});
