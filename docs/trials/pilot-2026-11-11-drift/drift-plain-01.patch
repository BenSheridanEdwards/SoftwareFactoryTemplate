+import { render, screen, waitFor, within } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { axe } from 'jest-axe';
+import { type TestApiHandlers, TestApiProvider } from '../../api-client';
+import { TodosPage } from './TodosPage';
+
+type Todo = { id: string; title: string; completed: boolean };
+
+/** An in-memory fake of the todos api, so the page sees a real create, toggle and delete sequence. */
+function fakeTodosApi(initial: readonly Todo[] = []) {
+  const todos = new Map(initial.map((todo) => [todo.id, todo]));
+  const handlers: TestApiHandlers = {
+    'todos.list': () => [...todos.values()],
+    'todos.create': ({ title }) => {
+      const todo = { id: `id-${todos.size + 1}`, title, completed: false };
+      todos.set(todo.id, todo);
+      return todo;
+    },
+    'todos.toggle': ({ id }) => {
+      const current = todos.get(id);
+      if (!current) throw new Error(`no todo ${id}`);
+      const todo = { ...current, completed: !current.completed };
+      todos.set(id, todo);
+      return todo;
+    },
+    'todos.delete': ({ id }) => {
+      todos.delete(id);
+      return { id };
+    },
+  };
+  return { handlers };
+}
+
+function renderPage(handlers: TestApiHandlers) {
+  const view = render(
+    <TestApiProvider handlers={handlers}>
+      <TodosPage />
+    </TestApiProvider>,
+  );
+  return { ...view, user: userEvent.setup() };
+}
+
+const todoList = () => screen.getByRole('list', { name: 'Todos' });
+
+it('shows the heading, the title field and the add button', async () => {
+  renderPage(fakeTodosApi().handlers);
+
+  expect(screen.getByRole('heading', { level: 1, name: 'Todos' })).toBeInTheDocument();
+  expect(screen.getByRole('textbox', { name: 'Title' })).toBeInTheDocument();
+  expect(await screen.findByText('No todos yet')).toBeInTheDocument();
+});
+
+it('adds a todo, lists it unchecked and clears the field', async () => {
+  const { handlers } = fakeTodosApi();
+  const { user } = renderPage(handlers);
+  await screen.findByText('No todos yet');
+
+  await user.type(screen.getByRole('textbox', { name: 'Title' }), '  Buy milk ');
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+
+  expect(await within(todoList()).findByRole('checkbox', { name: 'Buy milk' })).not.toBeChecked();
+  expect(screen.getByRole('textbox', { name: 'Title' })).toHaveValue('');
+});
+
+it.each(['', '   '])('adds nothing and alerts for the title %j', async (title) => {
+  const create = jest.fn(() => ({ id: 'x', title: 'unused', completed: false }));
+  const { handlers } = fakeTodosApi();
+  const { user } = renderPage({ ...handlers, 'todos.create': create });
+  await screen.findByText('No todos yet');
+
+  const field = screen.getByRole('textbox', { name: 'Title' });
+  if (title) await user.type(field, title);
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Enter a title');
+  expect(create).not.toHaveBeenCalled();
+});
+
+it('toggles a todo complete and back', async () => {
+  const { handlers } = fakeTodosApi([{ id: 'a1', title: 'Walk the dog', completed: false }]);
+  const { user } = renderPage(handlers);
+  const checkbox = await screen.findByRole('checkbox', { name: 'Walk the dog' });
+
+  await user.click(checkbox);
+  await waitFor(() => expect(checkbox).toBeChecked());
+  await user.click(checkbox);
+  await waitFor(() => expect(checkbox).not.toBeChecked());
+});
+
+it('deletes a todo and leaves the others listed', async () => {
+  const { handlers } = fakeTodosApi([
+    { id: 'a1', title: 'Keep me', completed: false },
+    { id: 'a2', title: 'Remove me', completed: false },
+  ]);
+  const { user } = renderPage(handlers);
+
+  await user.click(await screen.findByRole('button', { name: 'Delete Remove me' }));
+
+  await waitFor(() =>
+    expect(screen.queryByRole('checkbox', { name: 'Remove me' })).not.toBeInTheDocument(),
+  );
+  expect(screen.getByRole('checkbox', { name: 'Keep me' })).toBeInTheDocument();
+});
+
+it('says so when the list cannot load', async () => {
+  renderPage({ 'todos.list': () => Promise.reject(new Error('api down')) });
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Could not load todos');
+});
+
+it('says so when a change cannot be saved', async () => {
+  const { handlers } = fakeTodosApi([{ id: 'a1', title: 'Walk the dog', completed: false }]);
+  const { user } = renderPage({
+    ...handlers,
+    'todos.toggle': () => Promise.reject(new Error('api down')),
+  });
+
+  await user.click(await screen.findByRole('checkbox', { name: 'Walk the dog' }));
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Could not save your change');
+});
+
+it('has no axe-detectable violations with a todo listed', async () => {
+  const { handlers } = fakeTodosApi([{ id: 'a1', title: 'Read a book', completed: false }]);
+  const { container } = renderPage(handlers);
+  await screen.findByRole('checkbox', { name: 'Read a book' });
+
+  expect(await axe(container)).toHaveNoViolations();
+});
