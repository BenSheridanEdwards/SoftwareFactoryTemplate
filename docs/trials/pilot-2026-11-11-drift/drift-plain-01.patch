@@ -0,0 +1,17 @@
+import { randomUUID } from 'node:crypto';
+import type { Todo } from './domain.ts';
+
+/** In-memory todo storage, kept for the life of the api process. Insertion order is list order. */
+export function createTodoStore() {
+  const todos = new Map<string, Todo>();
+  return {
+    nextId: (): string => randomUUID(),
+    list: (): readonly Todo[] => [...todos.values()],
+    find: (id: string): Todo | undefined => todos.get(id),
+    save: (todo: Todo): Todo => {
+      todos.set(todo.id, todo);
+      return todo;
+    },
+    remove: (id: string): boolean => todos.delete(id),
+  };
+}
diff --git a/showcase/drift-plain-01/api/src/features/todos/procedures.test.ts b/showcase/drift-plain-01/api/src/features/todos/procedures.test.ts
