+import { randomUUID } from 'node:crypto';
+import { expect, type Page, test } from './fixtures';
+
+/**
+ * The Tag behaviour, end to end: the page in Chromium, the Vite server's
+ * `/trpc` proxy, and the real api process. The api keeps tags in memory, so
+ * each test makes its own names and never counts tags.
+ */
+const newName = (label: string) => `${label} ${randomUUID().slice(0, 8)}`;
+
+const tagRegion = (page: Page) => page.getByRole('region', { name: 'Tags' });
+const tagList = (page: Page) => tagRegion(page).getByRole('list', { name: 'Tags' });
+const tagItem = (page: Page, name: string) =>
+  tagList(page).getByRole('listitem').filter({ hasText: name });
+
+async function addTag(page: Page, name: string) {
+  await page.getByRole('textbox', { name: 'Tag name' }).fill(name);
+  await page.getByRole('button', { name: 'Add tag', exact: true }).click();
+  await expect(tagItem(page, name)).toBeVisible();
+}
+
+test.describe('Tags', () => {
+  test.beforeEach(async ({ page }) => {
+    await page.goto('/');
+  });
+
+  test('adds a tag and lists it below the todos', async ({ page }) => {
+    const name = newName('Errands');
+
+    await addTag(page, name);
+
+    await expect(tagRegion(page)).toBeVisible();
+    await expect(tagItem(page, name)).toBeVisible();
+  });
+
+  test('asks for a name and sends no request when the name is blank', async ({ page }) => {
+    const apiCalls: string[] = [];
+    page.on('request', (request) => {
+      if (new URL(request.url()).pathname.startsWith('/trpc/tags.create')) {
+        apiCalls.push(request.url());
+      }
+    });
+
+    await page.getByRole('textbox', { name: 'Tag name' }).fill('   ');
+    await page.getByRole('button', { name: 'Add tag', exact: true }).click();
+
+    await expect(tagRegion(page).getByRole('alert')).toHaveText('Enter a tag name');
+    expect(apiCalls).toEqual([]);
+  });
+
+  test('says the tag exists, adds nothing, and ignores letter case', async ({
+    page,
+    expectConsole,
+  }) => {
+    expectConsole(/Failed to load resource: .*409/);
+    const name = newName('Shopping');
+    await addTag(page, name);
+
+    await page.getByRole('textbox', { name: 'Tag name' }).fill(name.toUpperCase());
+    await page.getByRole('button', { name: 'Add tag', exact: true }).click();
+
+    await expect(tagRegion(page).getByRole('alert')).toHaveText('That tag exists');
+    await expect(tagList(page).getByRole('listitem').filter({ hasText: name })).toHaveCount(1);
+  });
+
+  test('deletes a tag, and it stays gone after a reload', async ({ page }) => {
+    const kept = newName('Keep');
+    const name = newName('Water');
+    await addTag(page, kept);
+    await addTag(page, name);
+
+    await page.getByRole('button', { name: `Delete tag ${name}`, exact: true }).click();
+
+    await expect(tagItem(page, name)).toHaveCount(0);
+    await page.reload();
+    await expect(tagItem(page, kept)).toBeVisible();
+    await expect(tagItem(page, name)).toHaveCount(0);
+  });
+
+  test('keeps tags across a reload while the api runs', async ({ page }) => {
+    const name = newName('Home');
+    await addTag(page, name);
+
+    await page.reload();
+
+    await expect(tagItem(page, name)).toBeVisible();
+  });
+});
