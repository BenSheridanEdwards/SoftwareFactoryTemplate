+import { createTag, isTagNameTaken, type Tag } from './domain.ts';
+import { createTagStore } from './integrations.ts';
+
+const store = createTagStore();
+
+export function listTags(): readonly Tag[] {
+  return store.list();
+}
+
+/** The stored tag, or undefined when a tag already has the name. */
+export function addTag(request: { readonly name: string }): Tag | undefined {
+  if (isTagNameTaken(store.list(), request.name)) return undefined;
+  return store.save(createTag(store.nextId(), request.name));
+}
+
+/** The deleted tag's id, or undefined when no tag has the id. */
+export function removeTag(id: string): { readonly id: string } | undefined {
+  return store.remove(id) ? { id } : undefined;
+}
