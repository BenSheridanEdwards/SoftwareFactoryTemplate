+beforeEach(() => jest.resetModules());
+
+it('starts empty, then adds and lists todos in creation order', async () => {
+  const { addTodo, listTodos } = await import('./application.ts');
+  expect(listTodos()).toEqual([]);
+  const first = addTodo({ title: 'Buy milk' });
+  const second = addTodo({ title: 'Walk the dog' });
+  expect(listTodos()).toEqual([first, second]);
+  expect(first.id).not.toBe(second.id);
+});
+
+it('flips completed on the stored todo, and returns undefined for an unknown id', async () => {
+  const { addTodo, flipTodo, listTodos } = await import('./application.ts');
+  const todo = addTodo({ title: 'Buy milk' });
+  expect(flipTodo(todo.id)).toEqual({ ...todo, completed: true });
+  expect(listTodos()).toEqual([{ ...todo, completed: true }]);
+  expect(flipTodo('missing')).toBeUndefined();
+});
+
+it('removes a todo and returns its id, or undefined when it is already gone', async () => {
+  const { addTodo, listTodos, removeTodo } = await import('./application.ts');
+  const todo = addTodo({ title: 'Buy milk' });
+  expect(removeTodo(todo.id)).toEqual({ id: todo.id });
+  expect(listTodos()).toEqual([]);
+  expect(removeTodo(todo.id)).toBeUndefined();
+});
diff --git a/showcase/drift-plain-01/api/src/features/todos/application.ts b/showcase/drift-plain-01/api/src/features/todos/application.ts
new file mode 100644
index 0000000..1d7ef4b
--- /dev/null
+++ b/showcase/drift-plain-01/api/src/features/todos/application.ts
@@ -0,0 +1,24 @@
+import { createTodo, toggleTodo, type Todo } from './domain.ts';
+import { createTodoStore } from './integrations.ts';
+
+const store = createTodoStore();
+
+export function listTodos(): readonly Todo[] {
+  return store.list();
+}
+
+export function addTodo(request: { readonly title: string }): Todo {
+  return store.save(createTodo(store.nextId(), request.title));
+}
+
+/** The toggled todo, or undefined when no todo has the id. */
+export function flipTodo(id: string): Todo | undefined {
+  const todo = store.find(id);
+  if (!todo) return undefined;
+  return store.save(toggleTodo(todo));
+}
+
+/** The deleted todo's id, or undefined when no todo has the id. */
+export function removeTodo(id: string): { readonly id: string } | undefined {
+  return store.remove(id) ? { id } : undefined;
+}
