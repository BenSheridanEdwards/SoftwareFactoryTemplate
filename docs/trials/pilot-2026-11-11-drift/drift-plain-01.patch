@@ -0,0 +1,45 @@
+import { TRPCError } from '@trpc/server';
+import { Schema } from 'effect';
+import { procedure, router } from '../../trpc.ts';
+import { addTag, listTags, removeTag } from './application.ts';
+import type { Tag } from './domain.ts';
+
+const tagSchema = Schema.Struct({
+  id: Schema.String,
+  name: Schema.String,
+});
+const createInputSchema = Schema.Struct({ name: Schema.Trim.check(Schema.isNonEmpty()) });
+const idInputSchema = Schema.Struct({ id: Schema.String });
+const deletedSchema = Schema.Struct({ id: Schema.String });
+
+/** Maps a name that a tag already has to CONFLICT; the application returns undefined for it. */
+function added(tag: Tag | undefined): Tag {
+  if (tag === undefined) {
+    throw new TRPCError({ code: 'CONFLICT', message: 'That tag exists' });
+  }
+  return tag;
+}
+
+/** Maps a missing tag to NOT_FOUND; the application returns undefined for it. */
+function found<Value>(value: Value | undefined): Value {
+  if (value === undefined) {
+    throw new TRPCError({ code: 'NOT_FOUND', message: 'Tag not found' });
+  }
+  return value;
+}
+
+const tagProcedures = {
+  list: procedure
+    .output(Schema.toStandardSchemaV1(Schema.Array(tagSchema)))
+    .query(() => listTags()),
+  create: procedure
+    .input(Schema.toStandardSchemaV1(createInputSchema))
+    .output(Schema.toStandardSchemaV1(tagSchema))
+    .mutation(({ input }) => added(addTag(input))),
+  delete: procedure
+    .input(Schema.toStandardSchemaV1(idInputSchema))
+    .output(Schema.toStandardSchemaV1(deletedSchema))
+    .mutation(({ input }) => found(removeTag(input.id))),
+};
+
+export const tagsRouter: ReturnType<typeof router<typeof tagProcedures>> = router(tagProcedures);
