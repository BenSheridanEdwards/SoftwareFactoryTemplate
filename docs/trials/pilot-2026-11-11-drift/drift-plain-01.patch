+import { TRPCError } from '@trpc/server';
+import { createCallerFactory } from '../../trpc.ts';
+import { todosRouter } from './procedures.ts';
+
+const caller = createCallerFactory(todosRouter)({});
+
+it('creates a trimmed, incomplete todo and lists it', async () => {
+  const created = await caller.create({ title: '  Buy milk  ' });
+  expect(created).toEqual({ id: expect.any(String), title: 'Buy milk', completed: false });
+  await expect(caller.list()).resolves.toContainEqual(created);
+});
+
+it.each(['', '   '])('rejects the blank title %j as a bad request', async (title) => {
+  await expect(caller.create({ title })).rejects.toMatchObject({
+    constructor: TRPCError,
+    code: 'BAD_REQUEST',
+  });
+});
+
+it('toggles a todo complete and back', async () => {
+  const created = await caller.create({ title: 'Walk the dog' });
+  await expect(caller.toggle({ id: created.id })).resolves.toEqual({
+    ...created,
+    completed: true,
+  });
+  await expect(caller.toggle({ id: created.id })).resolves.toEqual(created);
+});
+
+it('deletes a todo and returns its id, then reports it missing', async () => {
+  const created = await caller.create({ title: 'Water the plants' });
+  await expect(caller.delete({ id: created.id })).resolves.toEqual({ id: created.id });
+  await expect(caller.list()).resolves.not.toContainEqual(
+    expect.objectContaining({ id: created.id }),
+  );
+  await expect(caller.delete({ id: created.id })).rejects.toMatchObject({ code: 'NOT_FOUND' });
+  await expect(caller.toggle({ id: created.id })).rejects.toMatchObject({ code: 'NOT_FOUND' });
+});
diff --git a/showcase/drift-plain-01/api/src/features/todos/procedures.ts b/showcase/drift-plain-01/api/src/features/todos/procedures.ts
new file mode 100644
index 0000000..d0d2fc2
--- /dev/null
+++ b/showcase/drift-plain-01/api/src/features/todos/procedures.ts
@@ -0,0 +1,42 @@
+import { TRPCError } from '@trpc/server';
+import { Schema } from 'effect';
+import { procedure, router } from '../../trpc.ts';
+import { addTodo, flipTodo, listTodos, removeTodo } from './application.ts';
+
+const todoSchema = Schema.Struct({
+  id: Schema.String,
+  title: Schema.String,
+  completed: Schema.Boolean,
+});
+const createInputSchema = Schema.Struct({ title: Schema.Trim.check(Schema.isNonEmpty()) });
+const idInputSchema = Schema.Struct({ id: Schema.String });
+const deletedSchema = Schema.Struct({ id: Schema.String });
+
+/** Maps a missing todo to NOT_FOUND; the application returns undefined for it. */
+function found<Value>(value: Value | undefined): Value {
+  if (value === undefined) {
+    throw new TRPCError({ code: 'NOT_FOUND', message: 'Todo not found' });
+  }
+  return value;
+}
+
+const todoProcedures = {
+  list: procedure
+    .output(Schema.toStandardSchemaV1(Schema.Array(todoSchema)))
+    .query(() => listTodos()),
+  create: procedure
+    .input(Schema.toStandardSchemaV1(createInputSchema))
+    .output(Schema.toStandardSchemaV1(todoSchema))
+    .mutation(({ input }) => addTodo(input)),
+  toggle: procedure
+    .input(Schema.toStandardSchemaV1(idInputSchema))
+    .output(Schema.toStandardSchemaV1(todoSchema))
+    .mutation(({ input }) => found(flipTodo(input.id))),
+  delete: procedure
+    .input(Schema.toStandardSchemaV1(idInputSchema))
+    .output(Schema.toStandardSchemaV1(deletedSchema))
+    .mutation(({ input }) => found(removeTodo(input.id))),
+};
+
+export const todosRouter: ReturnType<typeof router<typeof todoProcedures>> =
+  router(todoProcedures);
