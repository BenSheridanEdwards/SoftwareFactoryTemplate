+import { render, screen, waitFor, within } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { axe } from 'jest-axe';
+import { type TestApiHandlers, TestApiProvider } from '../../api-client';
+import { TagsPage } from './TagsPage';
+
+type Tag = { id: string; name: string };
+
+/** An in-memory fake of the tags api, so the page sees a real create and delete sequence. */
+function fakeTagsApi(initial: readonly Tag[] = []) {
+  const tags = new Map(initial.map((tag) => [tag.id, tag]));
+  const handlers: TestApiHandlers = {
+    'tags.list': () => [...tags.values()],
+    'tags.create': ({ name }) => {
+      const tag = { id: `id-${tags.size + 1}`, name };
+      tags.set(tag.id, tag);
+      return tag;
+    },
+    'tags.delete': ({ id }) => {
+      tags.delete(id);
+      return { id };
+    },
+  };
+  return { handlers };
+}
+
+function renderPage(handlers: TestApiHandlers) {
+  const view = render(
+    <TestApiProvider handlers={handlers}>
+      <TagsPage />
+    </TestApiProvider>,
+  );
+  return { ...view, user: userEvent.setup() };
+}
+
+const tagRegion = () => screen.getByRole('region', { name: 'Tags' });
+const tagList = () => within(tagRegion()).getByRole('list', { name: 'Tags' });
+
+it('shows the tags region, the name field and the add button', async () => {
+  renderPage(fakeTagsApi().handlers);
+
+  expect(tagRegion()).toBeInTheDocument();
+  expect(screen.getByRole('textbox', { name: 'Tag name' })).toBeInTheDocument();
+  expect(screen.getByRole('button', { name: 'Add tag' })).toBeInTheDocument();
+  expect(await screen.findByText('No tags yet')).toBeInTheDocument();
+});
+
+it('adds a tag, lists it and clears the field', async () => {
+  const { handlers } = fakeTagsApi();
+  const { user } = renderPage(handlers);
+  await screen.findByText('No tags yet');
+
+  await user.type(screen.getByRole('textbox', { name: 'Tag name' }), '  Errands ');
+  await user.click(screen.getByRole('button', { name: 'Add tag' }));
+
+  expect(await within(tagList()).findByText('Errands')).toBeInTheDocument();
+  expect(screen.getByRole('textbox', { name: 'Tag name' })).toHaveValue('');
+});
+
+it.each(['', '   '])('adds nothing and alerts for the name %j', async (name) => {
+  const create = jest.fn(() => ({ id: 'x', name: 'unused' }));
+  const { handlers } = fakeTagsApi();
+  const { user } = renderPage({ ...handlers, 'tags.create': create });
+  await screen.findByText('No tags yet');
+
+  const field = screen.getByRole('textbox', { name: 'Tag name' });
+  if (name) await user.type(field, name);
+  await user.click(screen.getByRole('button', { name: 'Add tag' }));
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Enter a tag name');
+  expect(create).not.toHaveBeenCalled();
+});
+
+it('alerts and adds nothing when the name already exists, whatever its case', async () => {
+  const { handlers } = fakeTagsApi([{ id: 'a1', name: 'Errands' }]);
+  const { user } = renderPage({
+    ...handlers,
+    'tags.create': () =>
+      Promise.reject({
+        error: { code: -32009, message: 'That tag exists', data: { code: 'CONFLICT' } },
+      }),
+  });
+  await screen.findByText('Errands');
+
+  await user.type(screen.getByRole('textbox', { name: 'Tag name' }), 'errands');
+  await user.click(screen.getByRole('button', { name: 'Add tag' }));
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('That tag exists');
+  expect(within(tagList()).getAllByRole('listitem')).toHaveLength(1);
+});
+
+it('deletes a tag and leaves the others listed', async () => {
+  const { handlers } = fakeTagsApi([
+    { id: 'a1', name: 'Keep' },
+    { id: 'a2', name: 'Remove' },
+  ]);
+  const { user } = renderPage(handlers);
+
+  await user.click(await screen.findByRole('button', { name: 'Delete tag Remove' }));
+
+  await waitFor(() =>
+    expect(screen.queryByRole('button', { name: 'Delete tag Remove' })).not.toBeInTheDocument(),
+  );
+  expect(screen.getByRole('button', { name: 'Delete tag Keep' })).toBeInTheDocument();
+});
