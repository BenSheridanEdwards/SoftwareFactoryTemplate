+import { randomUUID } from 'node:crypto';
+import type { Tag } from './domain.ts';
+
+/** In-memory tag storage, kept for the life of the api process. Insertion order is list order. */
+export function createTagStore() {
+  const tags = new Map<string, Tag>();
+  return {
+    nextId: (): string => randomUUID(),
+    list: (): readonly Tag[] => [...tags.values()],
+    save: (tag: Tag): Tag => {
+      tags.set(tag.id, tag);
+      return tag;
+    },
+    remove: (id: string): boolean => tags.delete(id),
+  };
+}
