+export interface Tag {
+  readonly id: string;
+  readonly name: string;
+}
+
+/** A new tag. The caller supplies the id and the trimmed name. */
+export function createTag(id: string, name: string): Tag {
+  return { id, name };
+}
+
+/** True when a stored tag already has the name, compared without regard to letter case. */
+export function isTagNameTaken(tags: readonly Tag[], name: string): boolean {
+  const wanted = name.toLowerCase();
+  return tags.some((tag) => tag.name.toLowerCase() === wanted);
+}
