+import { createInMemoryTodos } from './integrations.ts';
+
+it('inserts an open todo and lists it in insertion order', () => {
+  const store = createInMemoryTodos();
+  const first = store.insert('Buy milk');
+  const second = store.insert('Walk the dog');
+
+  expect(first).toEqual({ id: expect.any(String), title: 'Buy milk', completed: false });
+  expect(store.list()).toEqual([first, second]);
+});
+
+it('finds, updates and removes a todo by id', () => {
+  const store = createInMemoryTodos();
+  const todo = store.insert('Buy milk');
+
+  store.update({ ...todo, completed: true });
+  expect(store.find(todo.id)).toEqual({ ...todo, completed: true });
+
+  store.remove(todo.id);
+  expect(store.find(todo.id)).toBeUndefined();
+  expect(store.list()).toEqual([]);
+});
diff --git a/showcase/drift-02/api/src/features/todos/integrations.ts b/showcase/drift-02/api/src/features/todos/integrations.ts
new file mode 100644
index 0000000..51e0ffa
--- /dev/null
+++ b/showcase/drift-02/api/src/features/todos/integrations.ts
@@ -0,0 +1,36 @@
+import { randomUUID } from 'node:crypto';
+import type { Todo } from './domain.ts';
+
+export interface TodoStore {
+  readonly list: () => readonly Todo[];
+  readonly has: (id: Todo['id']) => boolean;
+  readonly find: (id: Todo['id']) => Todo | undefined;
+  readonly insert: (title: Todo['title']) => Todo;
+  readonly update: (todo: Todo) => void;
+  readonly remove: (id: Todo['id']) => void;
+}
+
+interface TodoState {
+  todos: readonly Todo[];
+}
+
+/** In-memory storage, kept for the life of the api process. */
+export function createInMemoryTodos(): TodoStore {
+  const state: TodoState = { todos: [] };
+  return {
+    list: () => [...state.todos],
+    has: (id) => state.todos.some((todo) => todo.id === id),
+    find: (id) => state.todos.find((todo) => todo.id === id),
+    insert: (title) => {
+      const todo: Todo = { id: randomUUID(), title, completed: false };
+      state.todos = [...state.todos, todo];
+      return todo;
+    },
+    update: (todo) => {
+      state.todos = state.todos.map((current) => (current.id === todo.id ? todo : current));
+    },
+    remove: (id) => {
+      state.todos = state.todos.filter((todo) => todo.id !== id);
+    },
+  };
+}
