@@ -0,0 +1,30 @@
+import { randomUUID } from 'node:crypto';
+import type { Tag } from './domain.ts';
+
+export interface TagStore {
+  readonly list: () => readonly Tag[];
+  readonly has: (id: Tag['id']) => boolean;
+  readonly insert: (name: Tag['name']) => Tag;
+  readonly remove: (id: Tag['id']) => void;
+}
+
+interface TagState {
+  tags: readonly Tag[];
+}
+
+/** In-memory storage, kept for the life of the api process. */
+export function createInMemoryTags(): TagStore {
+  const state: TagState = { tags: [] };
+  return {
+    list: () => [...state.tags],
+    has: (id) => state.tags.some((tag) => tag.id === id),
+    insert: (name) => {
+      const tag: Tag = { id: randomUUID(), name };
+      state.tags = [...state.tags, tag];
+      return tag;
+    },
+    remove: (id) => {
+      state.tags = state.tags.filter((tag) => tag.id !== id);
+    },
+  };
+}
