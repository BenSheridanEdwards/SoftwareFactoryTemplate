@@ -0,0 +1,30 @@
+import { TRPCError } from '@trpc/server';
+import { Schema } from 'effect';
+import { procedure, router } from '../../trpc.ts';
+import { createTag, deleteTag, listTags } from './application.ts';
+
+const createInputSchema = Schema.Struct({ name: Schema.Trim.check(Schema.isNonEmpty()) });
+const idInputSchema = Schema.Struct({ id: Schema.String });
+
+function found<Value>(value: Value | undefined): Value {
+  if (value === undefined) {
+    throw new TRPCError({ code: 'NOT_FOUND', message: 'Tag not found' });
+  }
+  return value;
+}
+
+const tagsProcedures = {
+  list: procedure.query(() => listTags()),
+  create: procedure.input(Schema.toStandardSchemaV1(createInputSchema)).mutation(({ input }) => {
+    const tag = createTag(input);
+    if (tag === undefined) {
+      throw new TRPCError({ code: 'CONFLICT', message: 'That tag exists' });
+    }
+    return tag;
+  }),
+  delete: procedure
+    .input(Schema.toStandardSchemaV1(idInputSchema))
+    .mutation(({ input }) => found(deleteTag(input))),
+};
+
+export const tagsRouter: ReturnType<typeof router<typeof tagsProcedures>> = router(tagsProcedures);
