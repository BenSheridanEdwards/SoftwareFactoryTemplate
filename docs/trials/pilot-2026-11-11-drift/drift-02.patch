+it('toggles a todo and reports undefined for an unknown id', async () => {
+  const { createTodo, toggleTodoById } = await import('./application.ts');
+  const todo = createTodo({ title: 'Buy milk' });
+  expect(toggleTodoById({ id: todo.id })).toEqual({ ...todo, completed: true });
+  expect(toggleTodoById({ id: 'missing' })).toBeUndefined();
+});
