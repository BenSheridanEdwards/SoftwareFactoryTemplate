@@ -0,0 +1,116 @@
+import { render, screen, waitFor, within } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { axe } from 'jest-axe';
+import { type TestApiHandlers, TestApiProvider } from '../../api-client';
+import { TodosPage } from './TodosPage';
+import type { Todo } from './useTodos';
+
+interface FakeApi {
+  todos: Todo[];
+}
+
+function renderPage(seed: Todo[], handlers: Partial<TestApiHandlers> = {}) {
+  const api: FakeApi = { todos: [...seed] };
+  const allHandlers: TestApiHandlers = {
+    'todos.list': () => [...api.todos],
+    'todos.create': ({ title }) => {
+      const todo = { id: `id-${api.todos.length + 1}`, title, completed: false };
+      api.todos = [...api.todos, todo];
+      return todo;
+    },
+    'todos.toggle': ({ id }) => {
+      const todo = api.todos.find((item) => item.id === id);
+      if (!todo) throw new Error('missing');
+      const toggled = { ...todo, completed: !todo.completed };
+      api.todos = api.todos.map((item) => (item.id === id ? toggled : item));
+      return toggled;
+    },
+    'todos.delete': ({ id }) => {
+      api.todos = api.todos.filter((item) => item.id !== id);
+      return { id };
+    },
+    ...handlers,
+  };
+  const view = render(
+    <TestApiProvider handlers={allHandlers}>
+      <TodosPage />
+    </TestApiProvider>,
+  );
+  return { ...view, user: userEvent.setup() };
+}
+
+const todoList = () => screen.findByRole('list', { name: 'Todos' });
+
+it('shows the loaded todos in the list', async () => {
+  renderPage([{ id: '1', title: 'Buy milk', completed: false }]);
+
+  const list = await todoList();
+
+  expect(within(list).getByRole('checkbox', { name: 'Buy milk' })).not.toBeChecked();
+});
+
+it('adds a typed title to the list and clears the field', async () => {
+  const { user } = renderPage([]);
+  await todoList();
+
+  await user.type(screen.getByRole('textbox', { name: 'Title' }), '  Walk the dog ');
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+
+  expect(await screen.findByRole('checkbox', { name: 'Walk the dog' })).toBeInTheDocument();
+  expect(screen.getByRole('textbox', { name: 'Title' })).toHaveValue('');
+});
+
+it('adds nothing and asks for a title when the title is blank', async () => {
+  const create = jest.fn(() => ({ id: 'x', title: 'x', completed: false }));
+  const { user } = renderPage([], { 'todos.create': create });
+  await todoList();
+
+  await user.type(screen.getByRole('textbox', { name: 'Title' }), '   ');
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Enter a title');
+  expect(create).not.toHaveBeenCalled();
+});
+
+it('toggles a todo complete and back', async () => {
+  const { user } = renderPage([{ id: '1', title: 'Buy milk', completed: false }]);
+  const checkbox = await screen.findByRole('checkbox', { name: 'Buy milk' });
+
+  await user.click(checkbox);
+  await waitFor(() => expect(checkbox).toBeChecked());
+  await user.click(checkbox);
+  await waitFor(() => expect(checkbox).not.toBeChecked());
+});
+
+it('deletes a todo from the list', async () => {
+  const { user } = renderPage([{ id: '1', title: 'Buy milk', completed: false }]);
+
+  await user.click(await screen.findByRole('button', { name: 'Delete Buy milk' }));
+
+  await waitFor(() =>
+    expect(screen.queryByRole('checkbox', { name: 'Buy milk' })).not.toBeInTheDocument(),
+  );
+});
+
+it('says so when the todos cannot load', async () => {
+  renderPage([], { 'todos.list': () => Promise.reject(new Error('api down')) });
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Could not load todos');
+});
+
+it('says so when a change cannot be saved', async () => {
+  const { user } = renderPage([{ id: '1', title: 'Buy milk', completed: false }], {
+    'todos.toggle': () => Promise.reject(new Error('api down')),
+  });
+
+  await user.click(await screen.findByRole('checkbox', { name: 'Buy milk' }));
+
+  expect(await screen.findByRole('alert')).toHaveTextContent('Could not save the change');
+});
+
+it('has no axe-detectable violations with a todo listed', async () => {
+  const { container } = renderPage([{ id: '1', title: 'Buy milk', completed: false }]);
+  await screen.findByRole('checkbox', { name: 'Buy milk' });
+
+  expect(await axe(container)).toHaveNoViolations();
+});
