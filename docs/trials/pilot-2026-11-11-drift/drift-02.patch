+it('passes a different procedure input through unchanged', async () => {
+  const input = { id: '7' };
+  const toggle = jest.fn((request: typeof input) => ({
+    ...request,
+    title: 'Read the review',
+    completed: true,
+  }));
+  const handlers = { 'todos.toggle': toggle };
+  const client = createTRPCUntypedClient({ links: [handlerLink(handlers)] });
+
+  await expect(client.mutation('todos.toggle', input)).resolves.toEqual({
+    id: '7',
+    title: 'Read the review',
