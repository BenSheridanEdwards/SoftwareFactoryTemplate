+async function listSummary(page: Page) {
+  const list = page.getByRole('list', { name: 'Todos' });
+  const total = await list.getByRole('checkbox').count();
+  const done = await list.getByRole('checkbox', { checked: true }).count();
+  return `${done} of ${total} done`;
+}
+
+async function expectDoneLineToMatchList(page: Page) {
+  await expect
+    .poll(async () => (await doneLine(page).textContent()) === (await listSummary(page)))
+    .toBe(true);
+}
