@@ -0,0 +1,23 @@
+import { hasTagNamed, type Tag } from './domain.ts';
+import { createInMemoryTags } from './integrations.ts';
+
+const store = createInMemoryTags();
+
+export function listTags(): readonly Tag[] {
+  return store.list();
+}
+
+/** The stored tag, or undefined when a tag already has the name. */
+export function createTag(request: { readonly name: string }): Tag | undefined {
+  if (hasTagNamed(store.list(), request.name)) return undefined;
+  return store.insert(request.name);
+}
+
+/** The deleted id, or undefined when no tag has the id. */
+export function deleteTag(request: {
+  readonly id: Tag['id'];
+}): { readonly id: Tag['id'] } | undefined {
+  if (!store.has(request.id)) return undefined;
+  store.remove(request.id);
+  return { id: request.id };
+}
