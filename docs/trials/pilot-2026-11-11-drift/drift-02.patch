diff --git a/showcase/drift-02/api/src/features/todos/application.ts b/showcase/drift-02/api/src/features/todos/application.ts
new file mode 100644
index 0000000..229855a
--- /dev/null
+++ b/showcase/drift-02/api/src/features/todos/application.ts
@@ -0,0 +1,30 @@
+import { type Todo, toggleTodo } from './domain.ts';
+import { createInMemoryTodos } from './integrations.ts';
+
+const store = createInMemoryTodos();
+
+export function listTodos(): readonly Todo[] {
+  return store.list();
+}
+
+export function createTodo(request: { readonly title: string }): Todo {
+  return store.insert(request.title);
+}
+
+/** The toggled todo, or undefined when no todo has the id. */
+export function toggleTodoById(request: { readonly id: Todo['id'] }): Todo | undefined {
+  const todo = store.find(request.id);
+  if (todo === undefined) return undefined;
+  const toggled = toggleTodo(todo);
+  store.update(toggled);
+  return toggled;
+}
+
+/** The deleted id, or undefined when no todo has the id. */
+export function deleteTodo(request: {
+  readonly id: Todo['id'];
+}): { readonly id: Todo['id'] } | undefined {
+  if (!store.has(request.id)) return undefined;
+  store.remove(request.id);
+  return { id: request.id };
+}
