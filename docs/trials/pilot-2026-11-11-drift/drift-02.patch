+import { TodoForm } from './TodoForm';
+import { TodoList } from './TodoList';
+import { useTodos } from './useTodos';
+
+export function TodosPage() {
+  const { state, createPending, actionFailed, createTodo, toggleTodo, deleteTodo } = useTodos();
+
+  return (
+    <main className="mx-auto max-w-160 px-4 py-6 sm:py-12">
+      <h1 className="mb-8 text-3xl font-bold tracking-tight">Todos</h1>
+      <section className="flex flex-col gap-4 rounded-xl border border-line bg-surface p-6">
+        <TodoForm onCreate={createTodo} pending={createPending} />
+        {actionFailed ? (
+          <p role="alert" className="text-danger">
+            Could not save the change
+          </p>
+        ) : null}
+        {state.status === 'loading' ? <output className="block">Loading…</output> : null}
+        {state.status === 'failed' ? (
+          <p role="alert" className="text-danger">
+            Could not load todos
+          </p>
+        ) : null}
+        {state.status === 'loaded' ? (
+          <TodoList todos={state.todos} onToggle={toggleTodo} onDelete={deleteTodo} />
+        ) : null}
+      </section>
+    </main>
+  );
+}
