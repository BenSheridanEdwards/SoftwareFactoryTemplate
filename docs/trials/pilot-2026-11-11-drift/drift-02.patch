@@ -0,0 +1,46 @@
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { type RouterInputs, type RouterOutputs, useTrpc } from '../../api-client';
+
+export type Tag = RouterOutputs['tags']['list'][number];
+export type CreateTag = RouterInputs['tags']['create'];
+
+type TagsState =
+  | { readonly status: 'loading' }
+  | { readonly status: 'failed' }
+  | { readonly status: 'loaded'; readonly tags: readonly Tag[] };
+
+function toTagsState(query: { isError: boolean; data: readonly Tag[] | undefined }): TagsState {
+  if (query.isError) return { status: 'failed' };
+  if (query.data) return { status: 'loaded', tags: query.data };
+  return { status: 'loading' };
+}
+
+/** The words for the failed action on the page; a taken name gets its own message. */
+function failureMessage(
+  createError: { readonly data?: { readonly code?: string } | null | undefined } | null,
+  deleteFailed: boolean,
+) {
+  if (createError?.data?.code === 'CONFLICT') return 'That tag exists';
+  if (createError) return 'Could not save the tag';
+  if (deleteFailed) return 'Could not delete the tag';
+  return undefined;
+}
+
+/** The tag list and the actions that change it, through the api. */
+export function useTags() {
+  const trpc = useTrpc();
+  const queryClient = useQueryClient();
+  const query = useQuery(trpc.tags.list.queryOptions());
+  const refreshList = () => queryClient.invalidateQueries({ queryKey: trpc.tags.list.queryKey() });
+
+  const create = useMutation(trpc.tags.create.mutationOptions({ onSuccess: refreshList }));
+  const remove = useMutation(trpc.tags.delete.mutationOptions({ onSuccess: refreshList }));
+
+  return {
+    state: toTagsState(query),
+    createPending: create.isPending,
+    actionError: failureMessage(create.error, remove.isError),
+    createTag: (input: CreateTag) => create.mutate(input),
+    deleteTag: (id: Tag['id']) => remove.mutate({ id }),
+  };
+}
