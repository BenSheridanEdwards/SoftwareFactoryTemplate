@@ -0,0 +1,68 @@
+import { randomUUID } from 'node:crypto';
+import AxeBuilder from '@axe-core/playwright';
+import { expect, type Page, test } from './fixtures';
+
+/**
+ * The Todo behaviour, end to end: the page in Chromium, the Vite server's
+ * `/trpc` proxy, and the real api process. Titles carry a random suffix because
+ * every test shares one api process.
+ */
+const newTitle = (label: string) => `${label} ${randomUUID().slice(0, 8)}`;
+
+async function addTodo(page: Page, title: string) {
+  await page.getByRole('textbox', { name: 'Title' }).fill(title);
+  await page.getByRole('button', { name: 'Add', exact: true }).click();
+  await expect(page.getByRole('checkbox', { name: title, exact: true })).toBeVisible();
+}
+
+test.describe('Todos', () => {
+  test('creates a todo that survives a reload', async ({ page }) => {
+    const title = newTitle('Buy milk');
+    await page.goto('/');
+
+    await addTodo(page, title);
+    await page.reload();
+
+    await expect(page.getByRole('checkbox', { name: title, exact: true })).not.toBeChecked();
+  });
+
+  test('sends no request and asks for a title when the title is blank', async ({ page }) => {
+    const apiCalls: string[] = [];
+    await page.goto('/');
+    page.on('request', (request) => {
+      if (new URL(request.url()).pathname.startsWith('/trpc')) {
+        apiCalls.push(request.url());
+      }
+    });
+
+    await page.getByRole('textbox', { name: 'Title' }).fill('   ');
+    await page.getByRole('button', { name: 'Add', exact: true }).click();
+
+    await expect(page.getByRole('alert')).toHaveText('Enter a title');
+    expect(apiCalls.filter((url) => url.includes('todos.create'))).toEqual([]);
+  });
+
+  test('toggles a todo and deletes it', async ({ page }) => {
+    const title = newTitle('Walk the dog');
+    await page.goto('/');
+    await addTodo(page, title);
+    const checkbox = page.getByRole('checkbox', { name: title, exact: true });
+
+    await checkbox.click();
+    await expect(checkbox).toBeChecked();
+
+    await page.getByRole('button', { name: `Delete ${title}`, exact: true }).click();
+    await expect(checkbox).toHaveCount(0);
+  });
+
+  test('has no detectable WCAG A or AA violation with a todo listed', async ({ page }) => {
+    await page.goto('/');
+    await addTodo(page, newTitle('Read a book'));
+
+    const scan = await new AxeBuilder({ page })
+      .withTags(['wcag2a', 'wcag2aa', 'wcag21a', 'wcag21aa'])
+      .analyze();
+
+    expect(scan.violations).toEqual([]);
+  });
+});
