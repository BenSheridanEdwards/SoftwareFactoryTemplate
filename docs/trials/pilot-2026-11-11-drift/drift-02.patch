+import { randomUUID } from 'node:crypto';
+import { expect, type Page, test } from './fixtures';
+
+/**
+ * The Tag behaviour, end to end: the Tags section under the todos, the Vite
+ * server's `/trpc` proxy and the real api process. Names carry a random suffix
+ * because every test shares one api process.
+ */
+const newName = (label: string) => `${label} ${randomUUID().slice(0, 8)}`;
+
+const tagField = (page: Page) => page.getByRole('textbox', { name: 'Tag name' });
+const addButton = (page: Page) => page.getByRole('button', { name: 'Add tag', exact: true });
+const tagItem = (page: Page, name: string) =>
+  page.getByRole('region', { name: 'Tags' }).getByRole('listitem').filter({ hasText: name });
+
+async function addTag(page: Page, name: string) {
+  await tagField(page).fill(name);
+  await addButton(page).click();
+  await expect(tagItem(page, name)).toBeVisible();
+}
+
+test.describe('Tags', () => {
+  test('creates a tag that survives a reload', async ({ page }) => {
+    const name = newName('Work');
+    await page.goto('/');
+
+    await addTag(page, name);
+    await page.reload();
+
+    await expect(tagItem(page, name)).toBeVisible();
+  });
+
+  test('sends no request and asks for a name when the name is blank', async ({ page }) => {
+    const apiCalls: string[] = [];
+    await page.goto('/');
+    page.on('request', (request) => {
+      if (new URL(request.url()).pathname.startsWith('/trpc')) {
+        apiCalls.push(request.url());
+      }
+    });
+
+    await tagField(page).fill('   ');
+    await addButton(page).click();
+
+    await expect(page.getByRole('region', { name: 'Tags' }).getByRole('alert')).toHaveText(
+      'Enter a tag name',
+    );
+    expect(apiCalls.filter((url) => url.includes('tags.create'))).toEqual([]);
+  });
+
+  test('adds nothing when a tag with the same name, without regard to case, exists', async ({
+    page,
+    expectConsole,
+  }) => {
+    const name = newName('Home');
+    await page.goto('/');
+    await addTag(page, name);
+
+    // The api answers the duplicate with 409, and Chromium logs that failed request.
+    expectConsole(/status of 409/);
+    await tagField(page).fill(name.toUpperCase());
+    await addButton(page).click();
+
+    await expect(page.getByRole('region', { name: 'Tags' }).getByRole('alert')).toHaveText(
+      'That tag exists',
+    );
+    await expect(tagItem(page, name)).toHaveCount(1);
+  });
+
+  test('deletes a tag, and it stays gone after a reload', async ({ page }) => {
+    const name = newName('Errands');
+    await page.goto('/');
+    await addTag(page, name);
+
+    await page.getByRole('button', { name: `Delete tag ${name}`, exact: true }).click();
+
+    await expect(tagItem(page, name)).toHaveCount(0);
+    await page.reload();
+    await expect(tagItem(page, name)).toHaveCount(0);
+  });
+});
