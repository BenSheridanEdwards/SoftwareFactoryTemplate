+it('deletes a todo and reports undefined for an unknown id', async () => {
+  const { createTodo, deleteTodo, listTodos } = await import('./application.ts');
+  const todo = createTodo({ title: 'Buy milk' });
+  expect(deleteTodo({ id: todo.id })).toEqual({ id: todo.id });
+  expect(listTodos()).toEqual([]);
+  expect(deleteTodo({ id: todo.id })).toBeUndefined();
