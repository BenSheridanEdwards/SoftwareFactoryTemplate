{
  // The Node program: every api package. Node runs its source with native type
  // stripping, so it sees no DOM, imports relative files with their `.ts`
  // extension, and uses only syntax Node can erase. It is composite so the
  // browser program reads its declarations from `.cache/types`.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": ".cache/types",
    "tsBuildInfoFile": ".cache/types/api.tsbuildinfo"
  },
  "include": ["apps/api/src", "showcase/*/api/src"],
  // Its tests type-check in tsconfig.api.test.json, which sees the Jest test globals.
  "exclude": ["**/*.test.ts"]
}
