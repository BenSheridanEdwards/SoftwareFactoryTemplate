{
  // The Node program's unit, integration and contract tests, with the Jest test
  // globals `present` and `unwrap` (tooling/types/test-globals.d.ts). Only the
  // test programs include that file, so a production module that calls either
  // fails to compile in tsconfig.api.json.
  "extends": "./tsconfig.api.json",
  "compilerOptions": {
    "composite": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "include": [
    "apps/api/src/**/*.test.ts",
    "showcase/*/api/src/**/*.test.ts",
    "tooling/types/test-globals.d.ts"
  ],
  "exclude": []
}
