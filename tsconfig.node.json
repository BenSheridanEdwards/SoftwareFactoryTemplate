{
  // The Node program for the code around the packages: root configs, the
  // Vite config and the e2e specs of every result. Web contract tests type-check
  // in tsconfig.node.test.json, which sees the Jest test globals.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["node", "jest"]
  },
  "references": [{ "path": "./tsconfig.api.json" }],
  "include": [
    "apps/web/e2e",
    "apps/web/vite.config.ts",
    "showcase/*/web/e2e",
    "showcase/*/web/vite.config.ts",
    "tooling/results.d.mts",
    "tooling/trial/acceptance",
    "jest.config.ts",
    "tooling/jest/jest.setup.ts",
    "commitlint.config.ts",
    "playwright.config.ts"
  ]
}
