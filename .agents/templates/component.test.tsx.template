// <result>/web/src/routes/<route-name>/__Name__Page.test.tsx.
// Model: apps/web/src/routes/greeting/GreetingPage.test.tsx.
//
// TestApiProvider serves a fresh real router; seed it through its typed client.
// Override a procedure only to fail, hold or record a call; serve(input) forwards it.
// Assert observable behaviour through accessible roles and names.

import { render, screen, waitFor } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { axe } from 'jest-axe';
import type { ComponentProps } from 'react';
import { TestApiProvider } from '../../api-client';
import { __Name__Page } from './__Name__Page';

function renderPage(api: Omit<ComponentProps<typeof TestApiProvider>, 'children'> = {}) {
  const view = render(
    <TestApiProvider {...api}>
      <__Name__Page />
    </TestApiProvider>,
  );
  return { ...view, user: userEvent.setup() };
}

it('__describes what the user sees after an action that reaches the api__', async () => {
  const __procedure__ = jest.fn(
    (input: __Input__, serve: (input: __Input__) => Promise<__Output__>) => serve(input),
  );
  const { user } = renderPage({
    seed: async (api) => {
      await api.__router__.__seedProcedure__.mutate(__seed input__);
    },
    handlers: { '__router__.__procedure__': __procedure__ },
  });

  await user.click(screen.getByRole('button', { name: '__Action__' }));

  await waitFor(() => expect(screen.getByRole('status')).toHaveTextContent('__expected outcome__'));
  expect(__procedure__).toHaveBeenCalledWith(__expected input__, expect.any(Function));
});

it('says so when the api fails', async () => {
  const { user } = renderPage({
    handlers: { '__router__.__procedure__': () => Promise.reject(new Error('api down')) },
  });

  await user.click(screen.getByRole('button', { name: '__Action__' }));

  expect(await screen.findByRole('alert')).toHaveTextContent('__error message__');
});

it('has no axe-detectable violations', async () => {
  const { container } = renderPage();

  expect(await axe(container)).toHaveNoViolations();
});
